---
/**
 * Frame for every caregiver app page.
 * Left: a rail with Ion, who the report is about, and the menu in four plain groups ("How she is", "Things to do", "Her care", "Set up").
 * Right: a slim top strip (family circle, what is waiting for you), the page heading and the page.
 * Slots: default (the page), "head-actions" (buttons under the heading), "head-art" (a small picture beside the heading).
 */
import BaseLayout from './BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import Capybara from '@/components/ui/Capybara.astro';
import { appGroups, appNav, STANDING_LINE } from '@/data/nav';
import { getFamily, getParent, getToday, getViewer, needsYouCount } from '@/lib/loaders';
interface Props { title: string; active: string; eyebrow?: string; heading: string; tone2?: string; lede?: string }
const { title, active, eyebrow, heading, tone2, lede } = Astro.props;
const [parent, family, viewer, today, waiting] = await Promise.all([getParent(), getFamily(), getViewer(), getToday(), needsYouCount()]);
const hasArt = Astro.slots.has('head-art');
---
<BaseLayout title={`${title} · I-on`} bodyClass="app">
  <div class="shell">
    <div class="rail">
      <a class="brand" href="/app/" aria-label="I-on, today">
        <Capybara size={44} waves={false} ground="var(--acc-soft)" label="" />
        <span>I-on</span>
      </a>
      <div class="who">
        <span class="who-avatar" aria-hidden="true">{parent.initials}</span>
        <span class="who-text"><b>{parent.short}</b><span><Icon name="check" size={14} />Call done {today.callTime}</span></span>
      </div>
      <nav class="menu" aria-label="App sections">
        {appGroups.map((g) => (
          <div class="menu-group">
            <p class="menu-label">{g.label}</p>
            <ul role="list">
              {appNav.filter((n) => n.group === g.id).map((n) => (
                <li>
                  <a href={n.href} aria-current={n.id === active ? 'page' : undefined} title={n.hint}>
                    <IconBadge name={n.icon} tone={n.tone ?? 'acc'} size="sm" />
                    <span>{n.label}</span>
                    {n.id === 'tasks' && waiting > 0 && <b class="menu-count"><span data-waiting-count>{waiting}</span><span class="sr-only"> waiting for you</span></b>}
                    {n.soon && <em>Soon</em>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <a class="menu-site" href="/"><Icon name="home" size={16} />Back to the website</a>
    </div>

    <div class="main">
      <header class="topbar">
        <p class="date"><Icon name="today" size={16} />{today.short}</p>
        <span class="example">Example data</span>
        <ul role="list" class="circle" aria-label="Family circle">
          {family.map((p) => <li title={`${p.name}, ${p.relation}`} class:list={{ me: p.id === viewer.id }}><span aria-hidden="true">{p.initials}</span><span class="sr-only">{p.name}, {p.relation}{p.id === viewer.id ? ' (you)' : ''}</span></li>)}
        </ul>
        <a class="approvals" href="/app/tasks/"><Icon name="bell" size={18} />Waiting for you<b>{waiting}</b></a>
      </header>

      <main id="main" class="content">
        <div class:list={['page-head', { 'has-art': hasArt }]}>
          <div class="page-words">
            {eyebrow && <p class="page-eyebrow">{eyebrow}</p>}
            <h1 class="h1">{heading}{tone2 && <span class="tone-2">{tone2}</span>}</h1>
            {lede && <p class="lede">{lede}</p>}
            <slot name="head-actions" />
          </div>
          {hasArt && <div class="page-art"><slot name="head-art" /></div>}
        </div>
        <slot />
        <p class="standing"><Icon name="shield" size={16} />{STANDING_LINE}</p>
      </main>
    </div>
  </div>
</BaseLayout>
<script>
  // Keep the "Waiting for you" count in step with what was approved in this browser (example data only).
  import { syncWaitingBadge } from '@/components/app/care/store';
  syncWaitingBadge();
  // On narrow screens the menu is a sideways row: bring the current page's pill into view without moving the page.
  const menu = document.querySelector<HTMLElement>('.menu');
  const current = menu?.querySelector<HTMLElement>('[aria-current="page"]');
  if (menu && current && menu.scrollWidth > menu.clientWidth) {
    const m = menu.getBoundingClientRect();
    const c = current.getBoundingClientRect();
    menu.scrollLeft += c.left - m.left - (m.width - c.width) / 2;
  }
</script>
<style>
  :global(body.app) { background: var(--paper); }
  .shell { display: grid; grid-template-columns: 16.5rem minmax(0, 1fr); gap: var(--s-8); max-width: 92rem; margin-inline: auto; padding: var(--s-5) var(--s-6) var(--s-12); }

  /* rail */
  .rail { position: sticky; top: var(--s-5); align-self: start; display: flex; flex-direction: column; gap: var(--s-4); max-height: calc(100vh - 2 * var(--s-5)); overflow-y: auto; padding: var(--s-4); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); box-shadow: var(--shadow-1); }
  .brand { display: inline-flex; align-items: center; gap: var(--s-3); min-height: var(--tap); padding: 0 var(--s-1); font-size: 1.625rem; font-weight: 600; letter-spacing: -0.04em; color: var(--ink); text-decoration: none; }
  .brand:hover { color: var(--ink); }
  .brand :global(svg) { width: 2.75rem; height: 2.75rem; }
  .who { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3); border-radius: var(--r-lg); background: var(--paper); }
  .who-avatar { flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--acc); color: var(--on-acc); font-weight: 600; }
  .who-text { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .who-text b { font-weight: 600; font-size: 1.0625rem; }
  .who-text span { display: inline-flex; align-items: center; gap: 0.25rem; font-size: var(--fs-sm); color: var(--ink-2); }
  .who-text :global(svg) { color: var(--leaf-text); }
  .menu { display: flex; flex-direction: column; gap: var(--s-3); }
  .menu-group ul { display: flex; flex-direction: column; gap: 0.125rem; }
  .menu-label { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-2); padding: 0 var(--s-2) var(--s-1); }
  .menu a { display: flex; align-items: center; gap: var(--s-3); min-height: var(--tap); padding: 0 var(--s-2); border-radius: var(--r-md); color: var(--ink); text-decoration: none; font-size: 1rem; transition: background 0.15s var(--ease); }
  .menu a:hover { background: var(--grey-1); color: var(--ink); }
  .menu a[aria-current='page'] { background: var(--deep); color: var(--on-deep); font-weight: 500; }
  .menu a[aria-current='page']:hover { background: var(--deep-hover); color: var(--on-deep); }
  .menu-count { margin-left: auto; display: grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.375rem; border-radius: var(--r-pill); background: var(--acc); color: var(--on-acc); font-size: var(--fs-sm); font-weight: 600; }
  .menu em { margin-left: auto; font-style: normal; font-size: var(--fs-xs); color: var(--ink-2); background: var(--grey-1); border-radius: var(--r-pill); padding: 0.125rem 0.5rem; }
  .menu a[aria-current='page'] em { color: var(--ink); }
  .menu-site { display: inline-flex; align-items: center; gap: var(--s-2); min-height: var(--tap); padding: 0 var(--s-2); border-top: 1px solid var(--line); color: var(--ink-2); font-size: var(--fs-sm); text-decoration: none; }
  .menu-site:hover { color: var(--acc-text); }

  /* main column */
  .main { display: flex; flex-direction: column; gap: var(--s-6); min-width: 0; }
  .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: var(--s-3) var(--s-4); min-height: 3rem; }
  .date { display: inline-flex; align-items: center; gap: var(--s-2); margin-right: auto; font-size: 0.9375rem; color: var(--ink-2); }
  .example { font-size: var(--fs-sm); color: var(--ink-2); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-pill); padding: 0.25rem 0.75rem; }
  .circle { display: flex; }
  .circle li { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; margin-left: -0.375rem; border-radius: 50%; background: var(--surface); border: 2px solid var(--paper); font-size: var(--fs-sm); font-weight: 500; }
  .circle li:nth-child(3n + 1) { background: var(--butter); }
  .circle li:nth-child(3n + 2) { background: var(--leaf); }
  .circle li:nth-child(3n) { background: var(--sky); }
  .approvals { display: inline-flex; align-items: center; gap: var(--s-2); min-height: var(--tap); padding: 0 var(--s-3) 0 var(--s-4); border-radius: var(--r-pill); background: var(--deep); color: var(--on-deep); font-size: 0.9375rem; font-weight: 500; text-decoration: none; }
  .approvals:hover { color: var(--on-deep); background: var(--deep-hover); }
  .approvals b { display: grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.375rem; border-radius: var(--r-pill); background: var(--acc); color: var(--on-acc); font-weight: 600; }
  .content { display: flex; flex-direction: column; gap: var(--s-8); min-width: 0; }
  .page-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-8); }
  .page-words { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); min-width: 0; }
  .page-eyebrow { font-size: var(--fs-sm); font-weight: 500; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-pill); padding: 0.25rem 0.875rem; }
  .page-head .lede { max-width: 40rem; }
  .page-art { flex: none; }
  .standing { display: flex; align-items: flex-start; gap: var(--s-2); margin-top: var(--s-4); font-size: var(--fs-sm); color: var(--ink-2); border-top: 1px solid var(--line-strong); padding-top: var(--s-4); }
  .standing :global(svg) { flex: none; margin-top: 0.1875rem; }

  @media (max-width: 64rem) {
    .shell { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); padding: var(--s-3) var(--s-4) var(--s-10); }
    .rail { position: static; max-height: none; overflow: visible; flex-direction: row; flex-wrap: wrap; align-items: center; gap: var(--s-3); padding: var(--s-3); border-radius: var(--r-lg); }
    .who { flex: 1 1 auto; padding: var(--s-2) var(--s-3); }
    .menu { order: 3; flex: 1 1 100%; flex-direction: row; gap: var(--s-1); overflow-x: auto; scroll-snap-type: x proximity; min-width: 0; }
    .menu-group { display: contents; }
    .menu-group ul { flex-direction: row; gap: var(--s-1); }
    .menu-label, .menu-site { display: none; }
    .menu a { white-space: nowrap; border-radius: var(--r-pill); padding: 0 var(--s-4) 0 var(--s-2); scroll-snap-align: start; min-height: var(--tap); }
    .menu em, .menu-count { margin-left: var(--s-1); }
    .page-art { display: none; }
    .date { flex: 1 1 100%; }
    .topbar { justify-content: flex-start; }
  }
  @media print {
    .rail, .topbar { display: none; }
    .shell { display: block; padding: 0; }
  }
</style>
