---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Button from '@/components/ui/Button.astro';
import MessageCard from '@/components/site/MessageCard.astro';
---
<SiteLayout title="Page not found · I-on" description="This page could not be found." active="">
  <MessageCard eyebrow="Page not found" title="We could not find that page." tone2="Ion looked everywhere." doodle="search">
    <p class="lede">The link may be old, or the address may have a small typo. The home page and the example app are both a click away.</p>
    <div class="row">
      <Button href="/" variant="secondary" size="lg">Back to the home page</Button>
      <Button href="/app/" size="lg" arrow>See the example app</Button>
    </div>
  </MessageCard>
</SiteLayout>
