---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Chip from '@/components/ui/Chip.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import ListRow from '@/components/app/care/ListRow.astro';
import DoseStrip from '@/components/app/care/DoseStrip.astro';
import HerWords from '@/components/app/care/HerWords.astro';
import FormCard from '@/components/app/care/FormCard.astro';
import Field from '@/components/app/care/Field.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import { getMedicineAnswers, getMedicineGroups } from '@/lib/loaders-care';

const [groups, answers] = await Promise.all([getMedicineGroups(), getMedicineAnswers()]);
const total = groups.reduce((n, g) => n + g.items.length, 0);
const pills = (n: number) => (n === 1 ? '1 pill' : `${n} pills`);
const older = [...answers].sort((a, b) => a.date.localeCompare(b.date));
---
<AppLayout title="Medicines" active="medicines" eyebrow="Medicines"
  heading="Her pills, in your words." tone2="And what she said about taking them."
  lede={`${total} things on her list, by the names your family uses. Ion asks about each pill time on the morning call and writes down her answer.`}>
  <LiveRegion />

  <Card as="section" tone="surface" pad="lg" class="two" aria-labelledby="two-title">
    <div class="two-head">
      <Chip tone="check">Check</Chip>
      <h2 id="two-title">Two different answers about Monday evening's pills.</h2>
      <p class="muted">Both answers are kept here, as she gave them. Neither one is treated as the right one.</p>
    </div>
    <div class="two-quotes">
      {older.map((a) => <HerWords text={a.text} cite={`${a.day} call`} />)}
    </div>
    <p class="two-might"><Icon name="chat" size={18} /><span>You might gently ask her about Monday evening next time you talk. If she is often unsure, her pharmacist can suggest ways to keep track.</span></p>
  </Card>

  <div class="groups">
    {groups.map((g) => (
      <Card as="section" tone="surface" pad="none" class="group" aria-labelledby={`h-${g.when}`}>
        <div class:list={['group-top', `top-${g.when}`]}>
          <span class="group-icon"><Icon name={g.when === 'morning' ? 'spark' : 'moon'} size={20} /></span>
          <div>
            <h2 id={`h-${g.when}`}>{g.title}</h2>
            <p class="group-asked">{g.asked}</p>
          </div>
        </div>
        <div class="group-body">
          <p class="group-today">{g.todayLine}</p>
          <ul role="list" class="meds" data-meds={g.when}>
            {g.items.map((m) => (
              <ListRow icon="pill" tone="quiet">
                <p class="lr-title">{m.label}</p>
                <p class="lr-meta"><span>{pills(m.count)}</span>
                  {m.refillDaysLeft !== undefined && <span>About {m.refillDaysLeft} days left{m.refillOn && `, refill due ${m.refillOn}`}</span>}
                  {m.refillDaysLeft === undefined && <span>Supply not tracked</span>}
                </p>
                {m.note && <p class="lr-note">{m.note}</p>}
                <Fragment slot="end">
                  {m.takenToday === true && <Chip tone="done">Today: she said yes</Chip>}
                  {m.takenToday === false && <Chip tone="check">Today: she said no</Chip>}
                  {m.takenToday === null && <Chip tone="waiting">Today: not asked yet</Chip>}
                </Fragment>
              </ListRow>
            ))}
          </ul>
          <DoseStrip days={g.days} id={`strip-${g.when}`} title={`${g.title}, the last 14 days`} />
        </div>
      </Card>
    ))}
  </div>

  <div class="bottom">
    <FormCard id="add" title="Add a medicine label" sub="Use the name your family uses, so everyone knows which one is meant. Ion will start asking about it from tomorrow's call.">
      <form class="cf" data-add novalidate>
        <Field label="Label" for="med-label" hint="The words your family already uses for it. There is no need for its real name.">
          <input class="cf-input" id="med-label" name="label" type="text" required maxlength="60" autocomplete="off" placeholder="Small white pill" aria-describedby="med-label-hint med-error" />
        </Field>
        <div class="cf-grid">
          <fieldset class="cf-set">
            <legend class="cf-legend">When she takes it</legend>
            <div class="cf-choices">
              <label class="cf-choice"><input type="radio" name="when" value="morning" checked />Morning</label>
              <label class="cf-choice"><input type="radio" name="when" value="evening" />Evening</label>
            </div>
          </fieldset>
          <Field label="How many at a time" for="med-count">
            <input class="cf-input" id="med-count" name="count" type="number" min="1" max="6" value="1" inputmode="numeric" />
          </Field>
        </div>
        <p class="cf-hint err" id="med-error" hidden>Please give it a label.</p>
        <div class="cf-actions"><Button type="submit" variant="dark"><Icon name="plus" size={16} />Add label</Button></div>
        <p class="cf-done" data-done hidden><Icon name="check" size={16} /><span data-msg></span></p>
      </form>
    </FormCard>

    <div class="side">
      <Card tone="deep" pad="lg" class="firm">
        <Icon name="shield" size={24} />
        <h2 class="firm-title">What I-on does, and does not do, with medicines</h2>
        <ul role="list">
          <li>It writes down what she says about taking her pills.</li>
          <li>It never names a medicine and never gives advice about doses.</li>
          <li>It cannot confirm that a pill was really taken.</li>
        </ul>
        <p>For anything about her medicines, her doctor or pharmacist is the right person to ask.</p>
      </Card>
      <ExampleNote />
    </div>
  </div>

  <template id="tpl-med">
    <ListRow icon="pill" tone="quiet">
      <p class="lr-title" data-slot="label"></p>
      <p class="lr-meta"><span data-slot="count"></span><span>Added by you</span></p>
      <button type="button" class="cf-link remove" data-remove>Remove<span class="sr-only" data-slot="remove-label"></span></button>
      <Fragment slot="end"><Chip tone="info">Ion asks from tomorrow</Chip></Fragment>
    </ListRow>
  </template>
</AppLayout>

<script>
  import { announce, fromTemplate, load, save, uid } from '@/components/app/care/store';
  interface Added { id: string; label: string; when: 'morning' | 'evening'; count: number }
  let added = load<Added[]>('medicines', []);
  const pills = (n: number) => (n === 1 ? '1 pill' : `${n} pills`);

  function render(a: Added) {
    const list = document.querySelector(`[data-meds="${a.when}"]`);
    if (!list) return;
    const row = fromTemplate('tpl-med', { label: a.label, count: pills(a.count), 'remove-label': ` ${a.label}` });
    row.querySelector('[data-remove]')?.addEventListener('click', () => {
      added = added.filter((x) => x.id !== a.id);
      save('medicines', added);
      row.remove();
      announce(`${a.label} removed from the ${a.when} pills.`);
      document.getElementById('med-label')?.focus();
    });
    list.append(row);
  }
  added.forEach(render);

  const form = document.querySelector<HTMLFormElement>('[data-add]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const input = document.getElementById('med-label') as HTMLInputElement;
    const err = document.getElementById('med-error');
    const label = String(fd.get('label') ?? '').trim();
    if (!label) { if (err) err.hidden = false; input.setAttribute('aria-invalid', 'true'); input.focus(); return; }
    if (err) err.hidden = true;
    input.removeAttribute('aria-invalid');
    const count = Math.min(6, Math.max(1, Number(fd.get('count')) || 1));
    const a: Added = { id: uid(), label, when: fd.get('when') === 'evening' ? 'evening' : 'morning', count };
    added.push(a);
    save('medicines', added);
    render(a);
    const msg = `Added ${label} to the ${a.when} pills. Ion will ask about it from tomorrow's call.`;
    const m = form.querySelector('[data-msg]');
    if (m) m.textContent = msg;
    const done = form.querySelector<HTMLElement>('[data-done]');
    if (done) done.hidden = false;
    announce(msg);
    input.value = '';
  });
</script>

<style>
  :global(.two) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--s-5) var(--s-8); border-color: var(--deep) !important; }
  .two-head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); }
  .two-head h2 { font-size: var(--fs-h3); font-weight: 400; line-height: 1.25; letter-spacing: -0.02em; }
  .two-quotes { display: flex; flex-direction: column; gap: var(--s-5); justify-content: center; }
  .two-might { grid-column: 1 / -1; display: flex; gap: var(--s-2); align-items: flex-start; padding-top: var(--s-4); border-top: 1px solid var(--line); font-size: 0.9375rem; line-height: 1.55; }
  .two-might :global(svg) { flex: none; margin-top: 0.1875rem; color: var(--acc-text); }

  .groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); align-items: start; }
  :global(.group) { display: flex; flex-direction: column; }
  .group-top { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-5); background: var(--acc-soft); }
  .top-evening { background: var(--deep); color: var(--on-deep); }
  .top-evening .group-asked { color: var(--on-deep); }
  .group-icon { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--surface); color: var(--ink); }
  .group-top h2 { font-size: var(--fs-h3); font-weight: 400; line-height: 1.2; letter-spacing: -0.02em; }
  .group-asked { font-size: var(--fs-sm); color: var(--ink-2); }
  .group-body { display: flex; flex-direction: column; gap: var(--s-5); padding: var(--s-5); }
  .group-today { font-weight: 500; }
  .meds { display: flex; flex-direction: column; gap: var(--s-2); }
  .remove { align-self: flex-start; margin-left: calc(var(--s-3) * -1); }

  .bottom { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--s-5); align-items: start; }
  .side { display: flex; flex-direction: column; gap: var(--s-4); }
  :global(.firm) { display: flex; flex-direction: column; gap: var(--s-4); }
  .firm-title { font-size: 1.25rem; font-weight: 500; line-height: 1.35; }
  .firm ul { display: flex; flex-direction: column; gap: var(--s-2); }
  .firm li { position: relative; padding-left: var(--s-5); line-height: 1.5; }
  .firm li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--acc); }
  .firm p { color: var(--on-deep); border-top: 1px solid color-mix(in srgb, var(--on-deep) 25%, transparent); padding-top: var(--s-3); font-size: 0.9375rem; }
  .err { color: var(--ink); font-weight: 500; }
  .err[hidden] { display: none; }

  @media (max-width: 75rem) {
    .groups, .bottom { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 48rem) {
    :global(.two) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
