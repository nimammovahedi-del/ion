---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import Button from '@/components/ui/Button.astro';
import DoseStrip from '@/components/app/care/DoseStrip.astro';
import MedRow from '@/components/app/care/MedRow.astro';
import Avatar from '@/components/app/care/Avatar.astro';
import Bubble from '@/components/app/care/Bubble.astro';
import HeadArt from '@/components/app/care/HeadArt.astro';
import FormCard from '@/components/app/care/FormCard.astro';
import Field from '@/components/app/care/Field.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import { getParent } from '@/lib/loaders';
import { getMedicineAnswers, getMedicineGroups } from '@/lib/loaders-care';

const [groups, answers, parent] = await Promise.all([getMedicineGroups(), getMedicineAnswers(), getParent()]);
const promises = [
  { icon: 'note', text: 'It writes down what she says about taking her pills.' },
  { icon: 'lock', text: 'It never names a medicine and never gives advice about doses.' },
  { icon: 'question', text: 'It cannot confirm that a pill was really taken.' },
];
const total = groups.reduce((n, g) => n + g.items.length, 0);
const pills = (n: number) => (n === 1 ? '1 pill' : `${n} pills`);
const older = [...answers].sort((a, b) => a.date.localeCompare(b.date));
---
<AppLayout title="Medicines" active="medicines" eyebrow="Medicines"
  heading="Her pills," tone2="in your family's words."
  lede={`${total} on her list. Ion asks about them on the morning call and writes down what she says.`}>
  <HeadArt slot="head-art" name="pills" />
  <Button slot="head-actions" href="#add" variant="primary" size="sm"><Icon name="plus" size={16} />Add a label</Button>
  <LiveRegion />

  <section class="two" aria-labelledby="two-title">
    <div class="two-words">
      <IconBadge name="question" tone="surface" size="md" round />
      <h2 id="two-title">Two different answers about Monday evening's pills</h2>
      <p>Both are kept, just as she said them. You might gently ask her about it next time you talk.</p>
    </div>
    <ol role="list" class="two-quotes">
      {older.map((a) => (
        <li>
          <Avatar initials={parent.initials} tone="acc" size="sm" />
          <figure>
            <Bubble as="blockquote" tone="surface"><p>“{a.text}”</p></Bubble>
            <figcaption>{a.day}, {a.source ?? 'morning call'}</figcaption>
          </figure>
        </li>
      ))}
    </ol>
    <p class="two-might"><Icon name="heart" size={16} /><span>If she is often unsure, her pharmacist can suggest ways to keep track.</span></p>
  </section>

  <div class="groups">
    {groups.map((g) => (
      <section class:list={['group', `group-${g.when}`]} aria-labelledby={`h-${g.when}`}>
        <div class="group-top">
          {g.when === 'morning' ? (
            <svg class="sky-art" viewBox="0 0 72 72" aria-hidden="true">
              <g stroke="var(--sun)" stroke-width="5" stroke-linecap="round">
                <path d="M36 6v8M36 58v8M6 36h8M58 36h8M14.800 14.800l5.600 5.600M51.600 51.600l5.600 5.600M14.800 57.200l5.600-5.600M51.600 20.400l5.600-5.600" />
              </g>
              <circle cx="36" cy="36" r="15" fill="var(--sun)" />
            </svg>
          ) : (
            <svg class="sky-art" viewBox="0 0 72 72" aria-hidden="true">
              <path d="M54 44A22 22 0 0 1 28 14a23 23 0 1 0 26 30z" fill="var(--deep)" />
              <circle cx="52" cy="18" r="3" fill="var(--surface)" /><circle cx="60" cy="32" r="2" fill="var(--surface)" /><circle cx="42" cy="10" r="2" fill="var(--surface)" />
            </svg>
          )}
          <div>
            <h2 id={`h-${g.when}`}>{g.title}</h2>
            <p class="group-asked">{g.asked}</p>
          </div>
        </div>
        <div class="group-body">
          <p class="group-today"><Icon name={g.when === 'morning' ? 'check' : 'clock'} size={18} /><span>{g.todayLine}</span></p>
          <ul role="list" class="meds" data-meds={g.when}>
            {g.items.map((m) => (
              <MedRow label={m.label} count={pills(m.count)} today={m.takenToday} note={m.note}
                refill={m.refillDaysLeft !== undefined ? `About ${m.refillDaysLeft} days left${m.refillOn ? `, refill due ${m.refillOn}` : ''}` : undefined} />
            ))}
          </ul>
          <DoseStrip days={g.days} id={`strip-${g.when}`} title="The last 14 days" />
        </div>
      </section>
    ))}
  </div>

  <div class="bottom">
    <FormCard id="add" title="Add a label" accent="leaf" sub="Ion will ask about it from tomorrow's call.">
      <form class="cf" data-add novalidate>
        <Field label="What your family calls it" for="med-label" hint="There is no need for its real name.">
          <input class="cf-input" id="med-label" name="label" type="text" required maxlength="60" autocomplete="off" placeholder="Small white pill" aria-describedby="med-label-hint med-error" />
        </Field>
        <div class="cf-grid">
          <fieldset class="cf-set">
            <legend class="cf-legend">When she takes it</legend>
            <div class="cf-choices">
              <label class="cf-choice"><input type="radio" name="when" value="morning" checked />Morning</label>
              <label class="cf-choice"><input type="radio" name="when" value="evening" />Evening</label>
            </div>
          </fieldset>
          <Field label="How many at a time" for="med-count">
            <input class="cf-input" id="med-count" name="count" type="number" min="1" max="6" value="1" inputmode="numeric" />
          </Field>
        </div>
        <p class="cf-hint err" id="med-error" hidden>Please give it a label.</p>
        <div class="cf-actions"><Button type="submit" variant="dark"><Icon name="plus" size={16} />Add label</Button></div>
        <p class="cf-done" data-done hidden><Icon name="check" size={16} /><span data-msg></span></p>
      </form>
    </FormCard>

    <section class="firm" aria-labelledby="firm-title">
      <h2 id="firm-title">What I-on does and does not do with medicines</h2>
      <ul role="list" class="firm-points">
        {promises.map((p) => (
          <li>
            <IconBadge name={p.icon} tone="surface" size="md" round />
            <span>{p.text}</span>
          </li>
        ))}
      </ul>
      <p class="firm-ask"><Icon name="heart" size={18} /><span>For anything about her medicines, her doctor or pharmacist is the right person to ask.</span></p>
    </section>
  </div>
  <ExampleNote />

  <template id="tpl-med"><MedRow added /></template>
</AppLayout>

<script>
  import { announce, fromTemplate, load, save, uid } from '@/components/app/care/store';
  interface Added { id: string; label: string; when: 'morning' | 'evening'; count: number }
  let added = load<Added[]>('medicines', []);
  const pills = (n: number) => (n === 1 ? '1 pill' : `${n} pills`);

  function render(a: Added) {
    const list = document.querySelector(`[data-meds="${a.when}"]`);
    if (!list) return;
    const row = fromTemplate('tpl-med', { label: a.label, count: pills(a.count), 'remove-label': ` ${a.label}` });
    row.querySelector('[data-remove]')?.addEventListener('click', () => {
      added = added.filter((x) => x.id !== a.id);
      save('medicines', added);
      row.remove();
      announce(`${a.label} removed from the ${a.when} pills.`);
      document.getElementById('med-label')?.focus();
    });
    list.append(row);
  }
  added.forEach(render);

  const form = document.querySelector<HTMLFormElement>('[data-add]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const input = document.getElementById('med-label') as HTMLInputElement;
    const err = document.getElementById('med-error');
    const label = String(fd.get('label') ?? '').trim();
    if (!label) { if (err) err.hidden = false; input.setAttribute('aria-invalid', 'true'); input.focus(); return; }
    if (err) err.hidden = true;
    input.removeAttribute('aria-invalid');
    const count = Math.min(6, Math.max(1, Number(fd.get('count')) || 1));
    const a: Added = { id: uid(), label, when: fd.get('when') === 'evening' ? 'evening' : 'morning', count };
    added.push(a);
    save('medicines', added);
    render(a);
    const msg = `Added ${label} to the ${a.when} pills. Ion will ask about it from tomorrow's call.`;
    const m = form.querySelector('[data-msg]');
    if (m) m.textContent = msg;
    const done = form.querySelector<HTMLElement>('[data-done]');
    if (done) done.hidden = false;
    announce(msg);
    input.value = '';
  });
</script>

<style>
  /* two answers, both kept: calm, side by side */
  .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); align-items: center; gap: var(--s-4) var(--s-8); padding: var(--s-6) var(--s-8); border-radius: var(--r-xl); background: var(--butter-soft); }
  .two-words { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); }
  .two-words h2 { font-size: 1.5rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; text-wrap: balance; }
  .two-words p { line-height: 1.5; }
  .two-quotes { display: flex; flex-direction: column; gap: var(--s-3); }
  .two-quotes li { display: flex; align-items: flex-start; gap: var(--s-3); }
  .two-quotes figure { display: flex; flex-direction: column; gap: var(--s-1); min-width: 0; }
  .two-quotes :global(.bub) p { font-size: 1.0625rem; }
  .two-quotes figcaption { font-size: var(--fs-sm); color: var(--ink-2); padding-left: var(--s-2); }
  .two-might { grid-column: 1 / -1; display: flex; gap: var(--s-2); align-items: flex-start; padding-top: var(--s-4); border-top: 1px solid var(--hair); font-size: 0.9375rem; line-height: 1.5; color: var(--ink-2); }
  .two-might :global(svg) { flex: none; margin-top: 0.1875rem; color: var(--acc-text); }

  /* morning and evening */
  .groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); align-items: start; }
  .group { display: flex; flex-direction: column; border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); overflow: hidden; min-width: 0; }
  .group-top { display: flex; align-items: center; gap: var(--s-4); padding: var(--s-5) var(--s-6); background: var(--butter-soft); }
  .group-evening .group-top { background: var(--sky-soft); }
  .sky-art { flex: none; width: 3.5rem; height: 3.5rem; }
  .group-top h2 { font-size: 1.5rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; }
  .group-asked { font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.45; }
  .group-body { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5) var(--s-6) var(--s-6); }
  .group-today { display: flex; align-items: flex-start; gap: var(--s-2); font-weight: 500; line-height: 1.45; }
  .group-today :global(svg) { flex: none; margin-top: 0.1875rem; color: var(--leaf-text); }
  .meds { display: flex; flex-direction: column; border-block: 1px solid var(--line); }

  .bottom { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--s-5); align-items: stretch; }
  .firm { display: flex; flex-direction: column; gap: var(--s-5); padding: var(--s-6); border-radius: var(--r-xl); background: var(--leaf-soft); min-width: 0; }
  .firm h2 { font-size: 1.5rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; text-wrap: balance; }
  .firm-points { display: flex; flex-direction: column; gap: var(--s-3); }
  .firm-points li { display: flex; align-items: center; gap: var(--s-3); line-height: 1.45; }
  .firm-ask { display: flex; align-items: flex-start; gap: var(--s-2); margin-top: auto; padding: var(--s-4); border-radius: var(--r-lg); background: var(--surface); font-weight: 500; line-height: 1.45; }
  .firm-ask :global(svg) { flex: none; margin-top: 0.125rem; color: var(--leaf-text); }
  .err { color: var(--ink); font-weight: 500; }
  .err[hidden] { display: none; }

  @media (max-width: 75rem) {
    .groups, .bottom { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 48rem) {
    .two { grid-template-columns: minmax(0, 1fr); padding: var(--s-5); }
    .group-top, .group-body { padding-inline: var(--s-4); }
  }
</style>
