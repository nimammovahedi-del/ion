---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Chip from '@/components/ui/Chip.astro';
import Button from '@/components/ui/Button.astro';
import BlockHead from '@/components/app/care/BlockHead.astro';
import HerWords from '@/components/app/care/HerWords.astro';
import FormCard from '@/components/app/care/FormCard.astro';
import Field from '@/components/app/care/Field.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import '@/components/app/care/care.css';
import { getCallSettings, getParent, getViewer } from '@/lib/loaders';
import { getAskQueue } from '@/lib/loaders-care';

const [{ queued, asked, limit }, parent, settings, viewer] = await Promise.all([getAskQueue(), getParent(), getCallSettings(), getViewer()]);
const open = limit - queued.length;
---
<AppLayout title="Ask tomorrow" active="ask" eyebrow="Ask tomorrow"
  heading="Something you would like to know?" tone2="Ion can ask her tomorrow."
  lede={`Add a question and Ion will fit it into tomorrow's call, in its own gentle words. You will see ${parent.short}'s answer in the report.`}>
  <LiveRegion />
  <div class="top" data-viewer={viewer.short} data-limit={limit}>
    <section class="queue" aria-labelledby="q-title">
      <div class="queue-head">
        <p class="queue-when"><Icon name="phone" size={16} />Wednesday, November 25 · {settings.time}</p>
        <h2 id="q-title">For tomorrow's call</h2>
        <p class="queue-limit"><span data-used class="num">{queued.length}</span> of {limit} questions. Ion asks no more than {limit} extra questions on a call, so it stays short and easy for her.</p>
      </div>
      <ol role="list" class="slots" data-queue>
        {queued.map((q, i) => (
          <li class="slot" data-q={q.id}>
            <span class="slot-n num" aria-hidden="true" data-n>{i + 1}</span>
            <div class="slot-body">
              <p class="slot-text" data-slot="text">{q.text}</p>
              <p class="slot-by">Added by <span data-slot="by">{q.by}</span></p>
            </div>
            <button type="button" class="cf-link" data-remove>Remove<span class="sr-only">: <span data-slot="text">{q.text}</span></span></button>
          </li>
        ))}
      </ol>
      <ol role="list" class="slots open" aria-hidden="true" data-open>
        {Array.from({ length: open }, (_, i) => <li class="slot empty"><span class="slot-n num">{queued.length + i + 1}</span><span>Open</span></li>)}
      </ol>
    </section>

    <FormCard id="add" title="Add a question" icon="chat">
      <div class="good">
        <p class="good-title">What makes a good question</p>
        <ul role="list">
          <li><b>One thing at a time.</b> "Are the new glasses comfortable?" rather than three questions in one.</li>
          <li><b>Easy to answer.</b> Something she can say in a sentence.</li>
          <li><b>Nothing frightening.</b> Leave news and worries for when you talk yourself.</li>
        </ul>
      </div>
      <form class="cf" data-add novalidate>
        <Field label="Your question" for="q-text" hint="Write it the way you would ask. Ion will say it kindly.">
          <textarea class="cf-textarea" id="q-text" name="text" rows="2" maxlength="140" required placeholder="Ask if the new glasses are comfortable" aria-describedby="q-text-hint q-error q-full"></textarea>
        </Field>
        <p class="cf-hint err" id="q-error" hidden>Please write a question first.</p>
        <p class="cf-full" id="q-full" data-full hidden={open > 0}>Tomorrow's call already has {limit} questions. Remove one, or add yours after tomorrow's call.</p>
        <div class="cf-actions"><Button type="submit" variant="dark" data-submit disabled={open <= 0}><Icon name="plus" size={16} />Add to tomorrow</Button></div>
        <p class="cf-done" data-done hidden><Icon name="check" size={16} /><span data-msg></span></p>
      </form>
    </FormCard>
  </div>

  <section class="earlier" aria-labelledby="e-title">
    <BlockHead id="e-title" title="Earlier questions" sub={`Her answers, as she gave them. ${parent.short} is free to say no to any question, and Ion moves on.`} />
    <ol role="list" class="answers">
      {asked.map((a) => (
        <li class="answer">
          <div class="answer-q">
            <p class="answer-meta"><span>{a.date}</span><span>Asked for {a.by}</span></p>
            <h3>{a.text}</h3>
            {a.declined ? <Chip tone="usual">She said not today</Chip> : <Chip tone="done">She answered</Chip>}
          </div>
          <div class="answer-a">
            <p>{a.summary}</p>
            {a.quote && <HerWords text={a.quote} cite={`${parent.short}, ${a.date} call`} />}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <ExampleNote />

  <template id="tpl-q">
    <li class="slot">
      <span class="slot-n num" aria-hidden="true" data-n></span>
      <div class="slot-body">
        <p class="slot-text" data-slot="text"></p>
        <p class="slot-by">Added by <span data-slot="by"></span></p>
      </div>
      <button type="button" class="cf-link" data-remove>Remove<span class="sr-only">: <span data-slot="text"></span></span></button>
    </li>
  </template>
</AppLayout>

<script>
  import { announce, fromTemplate, load, save, uid } from '@/components/app/care/store';
  interface Q { id: string; text: string; by: string }
  const top = document.querySelector<HTMLElement>('[data-limit]');
  const limit = Number(top?.dataset.limit ?? 3);
  const viewer = top?.dataset.viewer ?? 'You';
  const queue = document.querySelector<HTMLOListElement>('[data-queue]')!;
  const openList = document.querySelector<HTMLOListElement>('[data-open]')!;
  const form = document.querySelector<HTMLFormElement>('[data-add]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

  const read = (li: Element): Q => ({ id: (li as HTMLElement).dataset.q ?? '', text: li.querySelector('.slot-text')?.textContent ?? '', by: li.querySelector('[data-slot="by"]')?.textContent ?? '' });
  const stored = load<Q[] | null>('ask', null);

  function build(q: Q) {
    const li = fromTemplate('tpl-q', { text: q.text, by: q.by });
    li.dataset.q = q.id;
    return li;
  }

  function refresh() {
    const items = Array.from(queue.children);
    items.forEach((li, i) => { const n = li.querySelector('[data-n]'); if (n) n.textContent = String(i + 1); });
    const used = items.length;
    const u = document.querySelector('[data-used]');
    if (u) u.textContent = String(used);
    openList.replaceChildren(...Array.from({ length: Math.max(0, limit - used) }, (_, i) => {
      const li = document.createElement('li');
      li.className = 'slot empty';
      const n = document.createElement('span'); n.className = 'slot-n num'; n.textContent = String(used + i + 1);
      const t = document.createElement('span'); t.textContent = 'Open';
      li.append(n, t);
      return li;
    }));
    // keep the scoped style hook on new elements
    const cid = Array.from(queue.attributes).find((a) => a.name.startsWith('data-astro-cid'));
    if (cid) openList.querySelectorAll('*').forEach((el) => el.setAttribute(cid.name, cid.value));
    const full = used >= limit;
    submit.disabled = full;
    const f = form.querySelector<HTMLElement>('[data-full]');
    if (f) f.hidden = !full;
  }

  function persist() { save('ask', Array.from(queue.children).map(read)); }

  queue.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-remove]');
    if (!btn) return;
    const li = btn.closest('li');
    if (!li) return;
    const text = read(li).text;
    li.remove();
    persist();
    refresh();
    announce(`Removed from tomorrow's call: ${text}`);
    (document.getElementById('q-text') as HTMLTextAreaElement).focus();
  });

  if (stored) { queue.replaceChildren(...stored.map(build)); refresh(); }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const area = document.getElementById('q-text') as HTMLTextAreaElement;
    const err = document.getElementById('q-error');
    const text = area.value.trim();
    if (queue.children.length >= limit) { announce(`Tomorrow's call already has ${limit} questions.`); return; }
    if (!text) { if (err) err.hidden = false; area.setAttribute('aria-invalid', 'true'); area.focus(); return; }
    if (err) err.hidden = true;
    area.removeAttribute('aria-invalid');
    queue.append(build({ id: uid(), text, by: viewer }));
    persist();
    refresh();
    const left = limit - queue.children.length;
    const msg = `Added to tomorrow's call. ${left === 0 ? 'That makes three, so the call is full.' : `${left} ${left === 1 ? 'place' : 'places'} left.`}`;
    const m = form.querySelector('[data-msg]');
    if (m) m.textContent = msg;
    const done = form.querySelector<HTMLElement>('[data-done]');
    if (done) done.hidden = false;
    announce(msg);
    area.value = '';
  });
</script>

<style>
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-5); align-items: start; }
  .queue { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-8); border-radius: var(--r-lg); background: var(--deep); color: var(--on-deep); }
  .queue-head { display: flex; flex-direction: column; gap: var(--s-2); }
  .queue-when { display: inline-flex; align-items: center; gap: var(--s-2); font-family: var(--mono); font-size: var(--fs-xs); letter-spacing: 0.06em; text-transform: uppercase; }
  .queue h2 { font-size: var(--fs-h2); font-weight: 300; line-height: 1.1; letter-spacing: -0.03em; }
  .queue-limit { font-size: 0.9375rem; line-height: 1.55; }
  .slots { display: flex; flex-direction: column; gap: var(--s-2); }
  .slots:empty { display: none; }
  .slot { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--surface); color: var(--ink); }
  .slot-n { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--acc); color: var(--on-acc); font-weight: 600; }
  .slot-body { min-width: 0; }
  .slot-text { font-weight: 500; line-height: 1.4; overflow-wrap: anywhere; }
  .slot-by { font-size: var(--fs-sm); color: var(--ink-2); }
  .slot.empty { grid-template-columns: auto 1fr; background: transparent; color: var(--on-deep); border: 1px dashed currentColor; min-height: 3.5rem; }
  .slot.empty .slot-n { background: transparent; color: var(--on-deep); border: 1px solid currentColor; }
  .good { padding: var(--s-4) var(--s-5); border-radius: var(--r-md); background: var(--paper); }
  .good-title { font-weight: 500; margin-bottom: var(--s-2); }
  .good ul { display: flex; flex-direction: column; gap: var(--s-2); font-size: 0.9375rem; line-height: 1.5; }
  .good b { font-weight: 500; }
  .err { color: var(--ink); font-weight: 500; }
  .err[hidden] { display: none; }

  .earlier { display: flex; flex-direction: column; gap: var(--s-5); }
  .answers { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .answer { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--s-4) var(--s-8); padding: var(--s-6) 0; border-bottom: 1px solid var(--line); }
  .answer-q { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); }
  .answer-meta { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); font-family: var(--mono); font-size: var(--fs-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .answer h3 { font-size: 1.1875rem; font-weight: 500; line-height: 1.4; }
  .answer-a { display: flex; flex-direction: column; gap: var(--s-3); }
  .answer-a > p { color: var(--ink-2); }

  @media (max-width: 75rem) { .top { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 40rem) {
    .queue { padding: var(--s-5); }
    .answer { grid-template-columns: minmax(0, 1fr); }
    .slot { grid-template-columns: auto minmax(0, 1fr); }
    .slot :global(.cf-link) { grid-column: 2; justify-self: start; margin-left: calc(var(--s-3) * -1); }
  }
</style>
