---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import Chip from '@/components/ui/Chip.astro';
import Button from '@/components/ui/Button.astro';
import Part from '@/components/app/care/Part.astro';
import Avatar from '@/components/app/care/Avatar.astro';
import Bubble from '@/components/app/care/Bubble.astro';
import HeadArt from '@/components/app/care/HeadArt.astro';
import AlsoOn from '@/components/app/care/AlsoOn.astro';
import FormCard from '@/components/app/care/FormCard.astro';
import Field from '@/components/app/care/Field.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import '@/components/app/care/care.css';
import { facesOf } from '@/components/app/care/people';
import { getCallSettings, getFamily, getParent, getViewer } from '@/lib/loaders';
import { getAlso, getAskQueue } from '@/lib/loaders-care';

const [{ queued, asked, limit }, parent, settings, viewer, family, also] = await Promise.all([getAskQueue(), getParent(), getCallSettings(), getViewer(), getFamily(), getAlso()]);
const faces = facesOf(family);
const open = limit - queued.length;
const tips = [
  { icon: 'check', title: 'One thing at a time' },
  { icon: 'chat', title: 'Easy to answer in a sentence' },
  { icon: 'heart', title: 'Nothing frightening', text: 'Keep news and worries for when you talk yourself.' },
];
const NUMBER_WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six'];
const oldest = asked[asked.length - 1]?.date;
const answersSub = asked.length && oldest ? `The last ${NUMBER_WORDS[asked.length] ?? asked.length} questions, back to ${oldest}.` : 'As she gave them.';
---
<AppLayout title="Ask tomorrow" active="ask"
  heading="Ask her something tomorrow."
  lede="Up to three questions a call, so it stays short and easy for her.">
  <HeadArt slot="head-art" name="ask" />
  <Button slot="head-actions" href="#add" variant="secondary" size="sm"><Icon name="plus" size={16} />Add a question</Button>
  <LiveRegion />

  <div class="care-cols">
  <section class="queue" aria-labelledby="q-title" data-viewer={viewer.short} data-limit={limit} data-faces={JSON.stringify(faces)}>
    <header class="queue-head">
      <IconBadge name="phone" tone="surface" size="md" round />
      <div>
        <h2 id="q-title">For tomorrow's call</h2>
        <p class="queue-when">Wednesday, November 25 · {settings.time}</p>
      </div>
      <p class="queue-limit"><b><span data-used class="num">{queued.length}</span> of {limit}</b> questions</p>
    </header>
    <div class="slots">
      <ol role="list" data-queue>
        {queued.map((q) => (
          <li class="slot" id={`q-${q.id}`} data-q={q.id}>
            <p class="slot-by"><Avatar size="sm" tone={faces[q.by]?.tone ?? 'paper'} initials={faces[q.by]?.initials ?? ''} data-slot="face" /><span><span data-slot="by">{q.by}</span> would like to know</span></p>
            <Bubble tone="surface" tail="up"><p class="slot-text" data-slot="text">{q.text}</p></Bubble>
            <div class="slot-foot"><AlsoOn links={also('ask', q.id)} /><button type="button" class="cf-link" data-remove>Remove<span class="sr-only">: <span data-slot="text">{q.text}</span></span></button></div>
          </li>
        ))}
      </ol>
      <ol role="list" aria-hidden="true" data-open>
        {Array.from({ length: open }, () => <li class="slot empty"><span class="slot-plus">+</span><span>Room for one more</span></li>)}
      </ol>
    </div>
  </section>

  <div class="care-side">
    <FormCard title="Add a question" sub="Write it the way you would ask. Ion will say it kindly.">
      <form class="cf" data-add novalidate>
        <Field label="Your question" for="q-text">
          <textarea class="cf-textarea" id="q-text" name="text" rows="2" maxlength="140" required placeholder="One thing, easy to answer" aria-describedby="q-error q-full"></textarea>
        </Field>
        <p class="cf-hint err" id="q-error" hidden>Please write a question first.</p>
        <p class="cf-full" id="q-full" data-full hidden={open > 0}>Tomorrow's call already has {limit} questions. Remove one, or add yours after tomorrow's call.</p>
        <div class="cf-actions"><Button type="submit" variant="dark" data-submit disabled={open <= 0}><Icon name="plus" size={16} />Add to tomorrow</Button></div>
        <p class="cf-done" data-done hidden><Icon name="check" size={16} /><span data-msg></span></p>
      </form>
    </FormCard>
    <div class="good">
      <p class="good-title">A good question is</p>
      <ul role="list">
        {tips.map((t) => (
          <li>
            <IconBadge name={t.icon} tone="leaf" size="sm" round />
            <span><b>{t.title}</b>{t.text && <span>{t.text}</span>}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  </div>

  <Part id="earlier" title="Her answers" icon="chat" tone="leaf" sub={answersSub}>
    <ol role="list" class="answers">
      {asked.map((a) => (
        <li class="answer">
          <div class="answer-q">
            <Avatar size="sm" tone={faces[a.by]?.tone ?? 'paper'} initials={faces[a.by]?.initials ?? ''} />
            <div>
              <p class="answer-meta">{a.by} asked · {a.date}</p>
              <h3>{a.text}</h3>
            </div>
          </div>
          <figure class="answer-a">
            <Avatar size="sm" tone="acc" initials={parent.initials} />
            <div>
              <Bubble as="blockquote" tone="acc"><p>“{a.quote ?? a.summary}”</p></Bubble>
              {(a.declined || a.note) && (
                <figcaption>
                  {a.declined && <Chip tone="info">She said not today</Chip>}
                  {a.note && <span>{a.note}</span>}
                </figcaption>
              )}
            </div>
          </figure>
        </li>
      ))}
    </ol>
  </Part>

  <ExampleNote />

  <template id="tpl-q">
    <li class="slot">
      <p class="slot-by"><Avatar size="sm" tone={faces[viewer.short]?.tone ?? 'paper'} initials={faces[viewer.short]?.initials ?? ''} data-slot="face" /><span><span data-slot="by"></span> would like to know</span></p>
      <Bubble tone="surface" tail="up"><p class="slot-text" data-slot="text"></p></Bubble>
      <div class="slot-foot"><button type="button" class="cf-link" data-remove>Remove<span class="sr-only">: <span data-slot="text"></span></span></button></div>
    </li>
  </template>
</AppLayout>

<script>
  import { announce, fromTemplate, load, save, uid } from '@/components/app/care/store';
  interface Q { id: string; text: string; by: string }
  const top = document.querySelector<HTMLElement>('[data-limit]');
  const limit = Number(top?.dataset.limit ?? 3);
  const viewer = top?.dataset.viewer ?? 'You';
  const faces = JSON.parse(top?.dataset.faces ?? '{}') as Record<string, { initials: string; tone: string }>;
  const queue = document.querySelector<HTMLOListElement>('[data-queue]')!;
  const openList = document.querySelector<HTMLOListElement>('[data-open]')!;
  const form = document.querySelector<HTMLFormElement>('[data-add]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

  const read = (li: Element): Q => ({ id: (li as HTMLElement).dataset.q ?? '', text: li.querySelector('.slot-text')?.textContent ?? '', by: li.querySelector('[data-slot="by"]')?.textContent ?? '' });
  const stored = load<Q[] | null>('ask', null);

  function build(q: Q) {
    const li = fromTemplate('tpl-q', { text: q.text, by: q.by });
    li.dataset.q = q.id;
    const face = li.querySelector<HTMLElement>('[data-slot="face"]');
    const f = faces[q.by];
    if (face) { face.className = `av av-sm av-${f?.tone ?? 'paper'}`; face.textContent = f?.initials ?? ''; }
    return li;
  }

  function refresh() {
    const used = queue.children.length;
    const u = document.querySelector('[data-used]');
    if (u) u.textContent = String(used);
    openList.replaceChildren(...Array.from({ length: Math.max(0, limit - used) }, () => {
      const li = document.createElement('li');
      li.className = 'slot empty';
      const n = document.createElement('span'); n.className = 'slot-plus'; n.textContent = '+';
      const t = document.createElement('span'); t.textContent = 'Room for one more';
      li.append(n, t);
      return li;
    }));
    const full = used >= limit;
    const hadFocus = document.activeElement === submit;
    submit.disabled = full;
    const f = form.querySelector<HTMLElement>('[data-full]');
    if (f) {
      f.hidden = !full;
      // A disabled button drops keyboard focus, so hand it to the line that explains why.
      if (full && hadFocus) { f.setAttribute('tabindex', '-1'); f.focus(); }
    }
  }

  function persist() { save('ask', Array.from(queue.children).map(read)); }

  queue.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-remove]');
    if (!btn) return;
    const li = btn.closest('li');
    if (!li) return;
    const text = read(li).text;
    li.remove();
    persist();
    refresh();
    announce(`Removed from tomorrow's call: ${text}`);
    (document.getElementById('q-text') as HTMLTextAreaElement).focus();
  });

  // Rows that were on the page keep their own markup (and their links to other pages); rows added in this browser are built.
  if (stored) { const have = Array.from(queue.children) as HTMLElement[]; queue.replaceChildren(...stored.map((q) => have.find((li) => li.dataset.q === q.id) ?? build(q))); refresh(); }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const area = document.getElementById('q-text') as HTMLTextAreaElement;
    const err = document.getElementById('q-error');
    const text = area.value.trim();
    if (queue.children.length >= limit) { announce(`Tomorrow's call already has ${limit} questions.`); return; }
    if (!text) { if (err) err.hidden = false; area.setAttribute('aria-invalid', 'true'); area.focus(); return; }
    if (err) err.hidden = true;
    area.removeAttribute('aria-invalid');
    queue.append(build({ id: uid(), text, by: viewer }));
    persist();
    refresh();
    const left = limit - queue.children.length;
    const msg = `Added to tomorrow's call. ${left === 0 ? 'That makes three, so the call is full.' : `${left} ${left === 1 ? 'place' : 'places'} left.`}`;
    const m = form.querySelector('[data-msg]');
    if (m) m.textContent = msg;
    const done = form.querySelector<HTMLElement>('[data-done]');
    if (done) done.hidden = false;
    announce(msg);
    area.value = '';
  });
</script>

<style>
  /* tomorrow's call: three places, as speech bubbles */
  .queue { display: flex; flex-direction: column; gap: var(--s-5); padding: var(--s-6); border-radius: var(--r-xl); background: var(--leaf-soft); }
  .queue-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .queue h2 { font-size: 1.5rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; }
  .queue-when { font-size: 0.9375rem; color: var(--ink-2); }
  .queue-limit { margin-left: auto; padding: 0.375rem 0.875rem; border-radius: var(--r-pill); background: var(--surface); font-size: 0.9375rem; }
  .queue-limit b { font-weight: 600; }
  .slots { display: flex; flex-direction: column; gap: var(--s-4); }
  .slots ol { display: contents; }
  .slots :global(.slot:target .bub) { box-shadow: 0 0 0 3px var(--acc); }
  .slots :global(.slot) { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); min-width: 0; }
  .slot-by { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .slot-by [data-slot='by'] { font-weight: 600; color: var(--ink); }
  .slot :global(.bub) { align-self: stretch; padding: var(--s-4); box-shadow: var(--shadow-1); }
  .slot-text { font-size: 1.125rem; font-weight: 500; line-height: 1.4; }
  .slots :global(.slot-foot) { align-self: stretch; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 var(--s-3); margin-top: calc(var(--s-1) * -1); padding-left: var(--s-2); }
  .slots :global(.slot-foot .cf-link) { margin-left: auto; }
  .slots :global(.slot) { scroll-margin-top: var(--s-6); }
  .slots :global(.slot.empty) { flex-direction: row; align-items: center; justify-content: center; gap: var(--s-2); min-height: 4.5rem; border: 2px dashed var(--leaf); border-radius: var(--r-lg); color: var(--ink-2); font-size: 0.9375rem; }
  .slots :global(.slot-plus) { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--surface); color: var(--ink); font-size: 1.25rem; line-height: 1; }

  .good { padding: var(--s-4) var(--s-5); border-radius: var(--r-xl); background: var(--leaf-soft); }
  .good-title { font-weight: 500; margin-bottom: var(--s-3); }
  .good ul { display: flex; flex-direction: column; gap: var(--s-3); }
  .good li { display: flex; align-items: flex-start; gap: var(--s-3); font-size: 0.9375rem; line-height: 1.45; }
  .good li > span:last-child { display: flex; flex-direction: column; padding-top: 0.25rem; }
  .good b { font-weight: 500; }
  .good li span span { color: var(--ink-2); font-size: var(--fs-sm); }
  .err { color: var(--ink); font-weight: 500; }
  .err[hidden] { display: none; }

  /* her answers: the question, then her words */
  .answers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  .answer { display: grid; grid-template-rows: subgrid; grid-row: span 2; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .answer-q { display: flex; align-items: flex-start; gap: var(--s-3); }
  .answer-meta { font-size: var(--fs-sm); color: var(--ink-2); }
  .answer h3 { font-size: 1.0625rem; font-weight: 500; line-height: 1.4; }
  .answer-a { display: flex; align-items: flex-start; gap: var(--s-3); margin: 0; }
  .answer-a > div { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); min-width: 0; }
  .answer-a :global(.bub) p { font-size: 1.125rem; line-height: 1.4; }
  .answer-a figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-3); font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.5; }

  @media (max-width: 62rem) {
    .answers { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 40rem) { .queue { padding: var(--s-4); } }
</style>
