---
import AppLayout from '@/layouts/AppLayout.astro';
import Opening from '@/components/app/today/Opening.astro';
import Glance from '@/components/app/today/Glance.astro';
import NeedsYou from '@/components/app/today/NeedsYou.astro';
import WeekGlance from '@/components/app/today/WeekGlance.astro';
import MightDo from '@/components/app/today/MightDo.astro';
import { getHealthCards, getHerWords, getMedicines, getMetrics, getParent, getReport, getTasks, getToday, getViewer } from '@/lib/loaders';

const [today, parent, viewer, report, cards, tasks, metrics, words, medicines] = await Promise.all([
  getToday(), getParent(), getViewer(), getReport(), getHealthCards(), getTasks(), getMetrics(), getHerWords(), getMedicines(),
]);
const needsYou = tasks.filter((t) => t.status === 'needs-you');
---
<AppLayout
  title="Today"
  active="today"
  heading={`Good morning, ${viewer.short}.`}
  tone2={`Here is how your mom is today.`}
>
  <div class="today">
    <Opening
      name={parent.short}
      callTime={today.callTime}
      callMinutes={today.callMinutes}
      headline={report.headline}
      overall={report.overall}
      overallTone={report.overallTone}
      quotes={report.quotes}
      said={report.said}
    />

    <Glance cards={cards} metrics={metrics} words={words} medicines={medicines} />

    <NeedsYou tasks={needsYou} viewer={viewer.short} />

    <WeekGlance metrics={metrics} />

    <MightDo items={report.suggestions} />
  </div>
</AppLayout>

<style>
  .today { container-type: inline-size; display: flex; flex-direction: column; gap: var(--s-10); min-width: 0; }
  @media (max-width: 30rem) {
    .today { gap: var(--s-8); }
  }
</style>
