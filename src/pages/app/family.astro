---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import Chip from '@/components/ui/Chip.astro';
import Button from '@/components/ui/Button.astro';
import Part from '@/components/app/care/Part.astro';
import Avatar from '@/components/app/care/Avatar.astro';
import HeadArt from '@/components/app/care/HeadArt.astro';
import ListRow from '@/components/app/care/ListRow.astro';
import FormCard from '@/components/app/care/FormCard.astro';
import Field from '@/components/app/care/Field.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import '@/components/app/care/care.css';
import { toneAt } from '@/components/app/care/people';
import { getParent, getViewer } from '@/lib/loaders';
import { getCircle } from '@/lib/loaders-care';

const [circle, parent, viewer] = await Promise.all([getCircle(), getParent(), getViewer()]);
const ROLE = { 'main-caregiver': 'Main caregiver', family: 'Family', parent: 'Mom' } as const;
const hers = [
  { icon: 'phone', text: 'Ion asks first if she is happy to chat.' },
  { icon: 'chat', text: 'She can say no to any question.' },
  { icon: 'users', text: 'If she would rather not talk, the family is told.' },
];
const names = circle.map((p) => (p.id === viewer.id ? 'You' : p.short));
const abilities = circle[0]?.abilities ?? [];
const can = (personId: string, abilityId: string) => circle.find((p) => p.id === personId)?.abilities.find((a) => a.id === abilityId)?.allowed ?? false;
const HEAR = [
  { value: 'daily', label: 'A daily summary', hint: 'The report, every day.' },
  { value: 'changes', label: 'Only when something changes', hint: 'A message on days when something is different from her usual.' },
] as const;
---
<AppLayout title="Family circle" active="family"
  heading="Who is looking out for her."
  lede={`${names.join(', ')}, and ${parent.short} herself.`}>
  <HeadArt slot="head-art" name="family" center={parent.short.charAt(0)} people={circle.map((p, i) => ({ initials: p.initials, tone: toneAt(i) }))} />
  <Button slot="head-actions" href="#add" variant="secondary" size="sm"><Icon name="plus" size={16} />Invite someone</Button>
  <LiveRegion />

  <section class="maggie" aria-labelledby="maggie-title">
    <Avatar size="xl" tone="acc" initials={parent.initials} />
    <div class="maggie-words">
      <p class="role-line">At the center</p>
      <h2 id="maggie-title">{parent.name}, “{parent.short}”</h2>
    </div>
    <ul role="list" class="maggie-points">
      {hers.map((h) => <li><IconBadge name={h.icon} tone="surface" size="sm" round /><span>{h.text}</span></li>)}
    </ul>
  </section>

  <div class="care-cols">
    <div class="care-main">
      <Part id="people" title="In the circle" icon="users" tone="sky">
        <ul role="list" class="cards">
          {circle.map((p, i) => {
            const main = p.role === 'main-caregiver';
            return (
              <li class="person" data-person={p.id}>
                <div class="person-head">
                  <Avatar size="lg" tone={toneAt(i)} initials={p.initials} />
                  <div>
                    <h3>{p.name}{p.id === viewer.id && <span class="you"> (you)</span>}</h3>
                    <p class="person-rel">{p.relation} · {p.joined}</p>
                  </div>
                  <Chip tone={main ? 'check' : 'usual'}>{ROLE[p.role]}</Chip>
                </div>
                <fieldset class="cf-set hearing">
                  <legend class="cf-legend">How {p.short} hears</legend>
                  <div class="hear-choices">
                    {HEAR.map((h) => (
                      <label class="cf-choice hear">
                        <input type="radio" name={`hear-${p.id}`} value={h.value} checked={p.hearing === h.value} />
                        <span><b>{h.label}</b><span>{h.hint}</span></span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              </li>
            );
          })}
        </ul>
      </Part>

      <Part id="can" title="Who can do what" icon="check" tone="sky">
        <div class="can-box" tabindex="0" role="group" aria-label="Who can do what, as a table">
          <table class="can">
            <thead>
              <tr>
                <td></td>
                {circle.map((p, i) => <th scope="col"><Avatar size="sm" tone={toneAt(i)} initials={p.initials} /><span>{p.short}</span></th>)}
              </tr>
            </thead>
            <tbody>
              {abilities.map((a) => (
                <tr>
                  <th scope="row"><Icon name={a.icon} size={16} /><span>{a.label}</span></th>
                  {circle.map((p) => can(p.id, a.id)
                    ? <td><span class="yes" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg></span><span class="sr-only">Yes</span></td>
                    : <td><span class="no" aria-hidden="true"></span><span class="sr-only">No</span></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Part>
    </div>

    <div class="care-side">
      <FormCard title="Invite someone" sub="A brother, a neighbor, a close friend. They join as family.">
        <form class="cf" data-invite novalidate>
          <Field label="Their name" for="inv-name">
            <input class="cf-input" id="inv-name" name="name" type="text" required maxlength="60" autocomplete="off" aria-describedby="inv-error" />
          </Field>
          <Field label="Who they are to her" for="inv-rel">
            <input class="cf-input" id="inv-rel" name="relation" type="text" maxlength="40" autocomplete="off" placeholder="Neighbor" />
          </Field>
          <Field label="Their email address" for="inv-email" hint="In this example no invite is sent.">
            <input class="cf-input" id="inv-email" name="email" type="email" maxlength="120" autocomplete="off" aria-describedby="inv-email-hint inv-email-error" />
            <p class="cf-hint err" id="inv-email-error" hidden>That does not look like an email address. Check it, or leave it empty.</p>
          </Field>
          <p class="cf-hint err" id="inv-error" hidden>Please add their name.</p>
          <div class="cf-actions"><Button type="submit" variant="dark"><Icon name="plus" size={16} />Invite</Button></div>
          <p class="cf-done" data-done hidden><Icon name="check" size={16} /><span data-msg></span></p>
        </form>
      </FormCard>
      <section class="invited" aria-labelledby="invited-title" data-invited-box hidden>
        <h2 id="invited-title">Invited</h2>
        <ul role="list" class="invited-list" data-invited></ul>
      </section>
    </div>
  </div>
  <ExampleNote />

  <template id="tpl-invite">
    <ListRow icon="users" tone="quiet">
      <p class="lr-title" data-slot="name"></p>
      <p class="lr-meta"><span data-slot="relation"></span><span>Invited, not joined yet</span></p>
      <button type="button" class="cf-link cancel" data-cancel>Cancel invite<span class="sr-only" data-slot="cancel-label"></span></button>
    </ListRow>
  </template>
</AppLayout>

<script>
  import { announce, fromTemplate, load, save, uid } from '@/components/app/care/store';
  interface Invite { id: string; name: string; relation: string }
  const hearing = load<Record<string, string>>('family-hearing', {});
  let invites = load<Invite[]>('family-invites', []);

  document.querySelectorAll<HTMLElement>('[data-person]').forEach((card) => {
    const id = card.dataset.person as string;
    const name = card.querySelector('h3')?.firstChild?.textContent ?? '';
    if (hearing[id]) {
      const r = card.querySelector<HTMLInputElement>(`input[value="${hearing[id]}"]`);
      if (r) r.checked = true;
    }
    card.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => r.addEventListener('change', () => {
      hearing[id] = r.value;
      save('family-hearing', hearing);
      announce(`${name} will get ${r.value === 'daily' ? 'a daily summary' : 'a message only when something changes'}.`);
    }));
  });

  const list = document.querySelector<HTMLUListElement>('[data-invited]')!;
  // The "Invited" card only shows while someone is waiting to join.
  const box = document.querySelector<HTMLElement>('[data-invited-box]');
  const refresh = () => { if (box) box.hidden = list.children.length === 0; };

  function render(inv: Invite) {
    const row = fromTemplate('tpl-invite', { name: inv.name, relation: inv.relation || 'Family', 'cancel-label': ` for ${inv.name}` });
    row.querySelector('[data-cancel]')?.addEventListener('click', () => {
      invites = invites.filter((x) => x.id !== inv.id);
      save('family-invites', invites);
      row.remove();
      refresh();
      announce(`Invite for ${inv.name} cancelled.`);
      document.getElementById('inv-name')?.focus();
    });
    list.append(row);
    refresh();
  }
  invites.forEach(render);

  const form = document.querySelector<HTMLFormElement>('[data-invite]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const nameInput = document.getElementById('inv-name') as HTMLInputElement;
    const err = document.getElementById('inv-error');
    const name = String(fd.get('name') ?? '').trim();
    if (!name) { if (err) err.hidden = false; nameInput.setAttribute('aria-invalid', 'true'); nameInput.focus(); return; }
    if (err) err.hidden = true;
    nameInput.removeAttribute('aria-invalid');
    const emailInput = document.getElementById('inv-email') as HTMLInputElement;
    const emailErr = document.getElementById('inv-email-error');
    const badEmail = emailInput.value.trim() !== '' && !emailInput.checkValidity();
    if (emailErr) emailErr.hidden = !badEmail;
    if (badEmail) { emailInput.setAttribute('aria-invalid', 'true'); emailInput.focus(); return; }
    emailInput.removeAttribute('aria-invalid');
    const inv: Invite = { id: uid(), name, relation: String(fd.get('relation') ?? '').trim() };
    invites.push(inv);
    save('family-invites', invites);
    render(inv);
    const msg = `Invite ready for ${name}. In this example nothing is sent.`;
    const m = form.querySelector('[data-msg]');
    if (m) m.textContent = msg;
    const done = form.querySelector<HTMLElement>('[data-done]');
    if (done) done.hidden = false;
    announce(msg);
    form.reset();
  });
</script>

<style>
  .maggie { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.3fr); align-items: center; gap: var(--s-4) var(--s-6); padding: var(--s-5) var(--s-8); border-radius: var(--r-xl); background: var(--acc-soft); }
  .maggie h2 { font-size: var(--fs-h3); font-weight: 500; line-height: 1.25; letter-spacing: -0.02em; }
  .role-line { font-size: var(--fs-sm); color: var(--ink-2); }
  .maggie-points { display: flex; flex-direction: column; gap: var(--s-2); }
  .maggie-points li { display: flex; align-items: center; gap: var(--s-3); line-height: 1.4; }

  .cards { display: flex; flex-direction: column; gap: var(--s-3); }
  .person { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); min-width: 0; }
  .person-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .person-head > div { flex: 1 1 12rem; min-width: 0; }
  .person h3 { font-size: 1.1875rem; font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; }
  .person-rel { font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.45; }
  .you { font-weight: 400; color: var(--ink-2); }
  .hearing { padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .hear-choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--s-2); }
  .hear { align-items: flex-start; padding: var(--s-3); border-radius: var(--r-md); }
  .hear input { flex: none; margin-top: 0.125rem; }
  .hear > span { display: flex; flex-direction: column; line-height: 1.4; }
  .hear b { font-weight: 500; }
  .hear > span span { font-size: var(--fs-sm); font-weight: 400; color: var(--ink-2); }

  /* who can do what: one small table for everyone */
  .can-box { overflow-x: auto; border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); padding: var(--s-3) var(--s-5) var(--s-4); }
  .can-box:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .can { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .can th, .can td { padding: var(--s-2) var(--s-2); text-align: center; }
  .can thead th { font-weight: 500; font-size: var(--fs-sm); }
  .can thead th :global(.av) { display: grid; margin: 0 auto 0.25rem; }
  .can tbody th { display: flex; align-items: center; gap: var(--s-2); text-align: left; font-weight: 400; padding-left: 0; min-width: 12rem; }
  .can tbody th :global(svg) { flex: none; color: var(--ink-2); }
  .can tbody tr { border-top: 1px solid var(--line); }
  .yes { display: inline-grid; place-items: center; width: 1.625rem; height: 1.625rem; border-radius: 50%; background: var(--leaf); color: var(--ink); vertical-align: middle; }
  .no { display: inline-block; width: 0.875rem; height: 0.125rem; border-radius: var(--r-pill); background: var(--line-strong); vertical-align: middle; }

  .invited { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); border-radius: var(--r-xl); background: var(--sky-soft); }
  .invited[hidden] { display: none; }
  .invited h2 { font-size: 1.1875rem; font-weight: 500; line-height: 1.3; letter-spacing: -0.015em; }
  .invited-list { display: flex; flex-direction: column; gap: var(--s-2); }
  .invited :global(.lr-quiet) { background: var(--surface); border-style: solid; }
  .cancel { align-self: flex-start; margin-left: calc(var(--s-3) * -1); }
  .err { color: var(--ink); font-weight: 500; }
  .err[hidden] { display: none; }
  @media (max-width: 62rem) {
    .maggie { grid-template-columns: auto minmax(0, 1fr); }
    .maggie-points { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) { .maggie { padding: var(--s-5); } .can-box { padding-inline: var(--s-3); } }
</style>
