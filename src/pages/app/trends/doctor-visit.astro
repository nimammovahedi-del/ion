---
import AppLayout from '@/layouts/AppLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { getDoctorQuestions, getHerWords, getMedicines, getMetrics, getParent, getPillTimesTaken, getViewer, getWeekNotes, lastDays } from '@/lib/loaders';
import { dayLabel, direction, tableValue } from '@/components/app/trends/measure';

const [parent, viewer, metrics, words, medicines, questions, notes, pills] = await Promise.all([
  getParent(), getViewer(), getMetrics(), getHerWords(), getMedicines(), getDoctorQuestions(), getWeekNotes(), getPillTimesTaken(30),
]);
const ORDER = ['sleep', 'feeling', 'pain', 'meals', 'fluids', 'medicines', 'falls', 'out'];
const measures = ORDER.map((id) => metrics.find((m) => m.id === id)).filter((m) => m !== undefined);
const pts30 = lastDays(measures[0], 30);
const from = dayLabel(pts30[0].date, { month: 'long', day: 'numeric' });
const to = dayLabel(pts30[pts30.length - 1].date, { month: 'long', day: 'numeric', year: 'numeric' });
const weeksChanged = notes.filter((w) => !(w.changed.length === 1 && /^Nothing changed/.test(w.changed[0])));
const changedMeasures = measures.filter((m) => m.status !== 'usual');
const changedWords = changedMeasures.map((m) => ({ m, words: words.filter((w) => w.metric === m.id) })).filter((x) => x.words.length);
const morning = medicines.filter((m) => m.when === 'morning');
const evening = medicines.filter((m) => m.when === 'evening');
const pillRows = [
  { when: 'Morning pills', list: morning, taken: pills.morning },
  { when: 'Evening pills', list: evening, taken: pills.evening },
].filter((r) => r.list.length);
const blankLines = 5;
---
<AppLayout
  title="For a doctor visit"
  active="trends"
  eyebrow="For a doctor visit"
  heading={`${parent.name}, last 30 days`}
  tone2={`${from} to ${to}`}
>
  <div class="dv">
    <div class="actions no-print">
      <Button variant="dark" data-print class="needs-js"><Icon name="print" size={18} />Print this page</Button>
      <Button href="/app/trends/" variant="secondary">Back to Trends</Button>
      <p class="muted small">Fits on one or two sheets. You can also show it on your phone at the appointment.</p>
    </div>

    <article class="sheet" aria-labelledby="about-h">
      <section class="block about">
        <h2 id="about-h" class="sr-only">About these notes</h2>
        <p><b>About these notes.</b> These are family notes from daily check-in calls with {parent.short}, in her own words. They are not a medical record and nothing here was measured. Prepared by {viewer.name} ({viewer.relation.toLowerCase()}) with I-on.</p>
      </section>

      <section class="block" aria-labelledby="changed-h">
        <h2 id="changed-h">What changed in the last 30 days</h2>
        <ul>
          {weeksChanged.map((w) => <li><b>{w.week}:</b> {w.changed.join(' ')}</li>)}
        </ul>
        <p class="steady"><b>Stayed the same this week:</b> {notes[0]?.steady.join(' ')}</p>
      </section>

      <section class="block" aria-labelledby="table-h">
        <h2 id="table-h">Each measure</h2>
        <div class="t-scroll" tabindex="0" role="group" aria-label="Measures table. Scroll sideways if needed.">
          <table>
            <caption class="sr-only">Each measure with her usual, the 30-day average, the last 7 days and the direction</caption>
            <thead>
              <tr><th scope="col">Measure</th><th scope="col">Her usual</th><th scope="col">Last 30 days</th><th scope="col">Last 7 days</th><th scope="col">Direction</th></tr>
            </thead>
            <tbody>
              {measures.map((m) => (
                <tr>
                  <th scope="row">{m.title}</th>
                  <td>{m.usualLabel.charAt(0).toUpperCase() + m.usualLabel.slice(1)}</td>
                  <td class="num">{tableValue(m, lastDays(m, 30))}</td>
                  <td class="num">{tableValue(m, lastDays(m, 7))}</td>
                  <td><b>{direction(m, lastDays(m, 7))}</b></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small muted">Averages are over the days she answered. "Direction" compares the last 7 days with her usual.</p>
      </section>

      {changedWords.length > 0 && (
        <section class="block" aria-labelledby="words-h">
          <h2 id="words-h">In her own words</h2>
          <ul class="words">
            {changedWords.map((x) => x.words.map((w) => (
              <li><span class="w-meta">{x.m.title}, {w.day}:</span> &ldquo;{w.text}&rdquo;</li>
            )))}
          </ul>
        </section>
      )}

      <section class="block" aria-labelledby="meds-h">
        <h2 id="meds-h">Her medicines, by the family's own labels</h2>
        <table class="meds">
          <caption class="sr-only">Pill times and how often she said she took them in the last 30 days</caption>
          <thead><tr><th scope="col">When</th><th scope="col">What the family calls them</th><th scope="col">She said she took them</th></tr></thead>
          <tbody>
            {pillRows.map((r) => (
              <tr>
                <th scope="row">{r.when}</th>
                <td>{r.list.map((p) => p.label).join(', ')}</td>
                <td class="num">{r.taken} of {pills.answered} days</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="small muted">Out of the {pills.answered} days she answered the medicine question. On days she did not say yes to both pill times, it was the evening pills she missed or was not sure about. One of those evenings has two different answers from her.</p>
      </section>

      <section class="block questions" aria-labelledby="q-h">
        <h2 id="q-h">Questions we want to ask</h2>
        <ol>
          {questions.map((q) => (
            <li><p>{q}</p><span class="rule" aria-hidden="true"></span><span class="rule" aria-hidden="true"></span></li>
          ))}
        </ol>
        <p class="small muted">Your own questions and the doctor's answers:</p>
        <div class="blank" aria-hidden="true">{Array.from({ length: blankLines }, () => <span class="rule"></span>)}</div>
      </section>
    </article>
  </div>
</AppLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
</script>

<style>
  .dv { display: flex; flex-direction: column; gap: var(--s-5); min-width: 0; max-width: 56rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .actions p { flex: 1 1 16rem; }
  .sheet { display: flex; flex-direction: column; gap: var(--s-6); padding: var(--s-8); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); min-width: 0; }
  .block { display: flex; flex-direction: column; gap: var(--s-3); min-width: 0; }
  .block + .block { padding-top: var(--s-6); border-top: 1px solid var(--line); }
  .block h2 { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .about p { font-size: 0.9375rem; line-height: 1.55; padding: var(--s-4); border-radius: var(--r-md); background: var(--paper); }
  ul, ol { padding-left: 1.25rem; display: flex; flex-direction: column; gap: var(--s-2); line-height: 1.5; }
  .steady { color: var(--ink-2); line-height: 1.5; }
  .steady b, .about b { color: var(--ink); }
  .t-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  th, td { padding: var(--s-2) var(--s-3); text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  thead th { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-2); border-bottom-color: var(--line-strong); }
  tbody th { font-weight: 600; }
  .unit { display: block; font-weight: 400; font-size: var(--fs-xs); color: var(--ink-2); }
  td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .t-scroll table { min-width: 36rem; }
  .words { list-style: none; padding: 0; }
  .words li { padding-left: var(--s-4); border-left: 3px solid var(--acc); }
  .w-meta { font-size: var(--fs-sm); color: var(--ink-2); }
  .questions ol { gap: var(--s-4); }
  .questions li p { margin-bottom: var(--s-1); }
  .rule { display: block; height: 2rem; border-bottom: 1px solid var(--line-strong); }
  .blank { display: flex; flex-direction: column; }
  @media (max-width: 30rem) { .sheet { padding: var(--s-4); border-radius: var(--r-lg); } }

  @media print {
    .dv { max-width: none; gap: 0; }
    .sheet { padding: 0; border: 0; border-radius: 0; gap: 0.9rem; background: transparent; color: var(--ink); font-size: 10.5pt; }
    .block + .block { padding-top: 0.9rem; border-top: 1px solid var(--ink); }
    .block { gap: 0.4rem; break-inside: avoid; }
    .block h2 { font-size: 12.5pt; }
    .about p { background: transparent; padding: 0; }
    th, td { padding: 0.2rem 0.4rem; border-bottom: 1px solid var(--ink); color: var(--ink); }
    thead th { color: var(--ink); }
    .t-scroll { overflow: visible; }
    .t-scroll table { min-width: 0; }
    .unit, .w-meta, .steady, .muted { color: var(--ink); }
    .words li { border-left: 2px solid var(--ink); }
    .rule { height: 1.5rem; border-bottom: 1px solid var(--ink); }
  }
</style>
<style is:global>
  @media print {
    @page { margin: 14mm; }
    body.app, body.app .content { background: var(--surface) !important; color: var(--ink); }
    body.app .content { gap: 0.8rem; }
    body.app .page-head { padding: 0; gap: 0.2rem; }
    body.app .page-head .h1 { font-size: 20pt; font-weight: 500; }
    body.app .page-head .tone-2 { color: var(--ink); font-size: 14pt; }
    body.app .page-eyebrow span { display: none; }
    body.app .standing { color: var(--ink); border-top-color: var(--ink); margin-top: 0.5rem; }
  }
</style>
