---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Card from '@/components/ui/Card.astro';
import Capybara from '@/components/ui/Capybara.astro';
import Switch from '@/components/app/care/Switch.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import '@/components/app/care/care.css';
import { STANDING_LINE } from '@/data/nav';
import { getCallSettings, getParent, getViewer } from '@/lib/loaders';
import { minutesOf } from '@/lib/loaders-care';
import { openingTopics } from '@/components/app/care/words';

const [settings, parent, viewer] = await Promise.all([getCallSettings(), getParent(), getViewer()]);
const mins = minutesOf(settings.time);
const timeValue = `${String(Math.floor(mins / 60)).padStart(2, '0')}:${String(mins % 60).padStart(2, '0')}`;
const WEEK = [['Mon', 'Monday'], ['Tue', 'Tuesday'], ['Wed', 'Wednesday'], ['Thu', 'Thursday'], ['Fri', 'Friday'], ['Sat', 'Saturday'], ['Sun', 'Sunday']] as const;
const voices = [settings.voice, 'Ion, bright and cheerful', 'Ion, slower, with longer pauses'];
const fixed = settings.topics.filter((t) => t.fixed);
const optional = settings.topics.filter((t) => !t.fixed);
const topicIds = settings.topics.filter((t) => t.on && t.id !== 'story').map((t) => t.id);
const story = settings.topics.find((t) => t.id === 'story')?.on;
const tries = settings.retry.match(/\d{1,2}:\d{2}/g) ?? [];
---
<AppLayout title="Call settings" active="settings" eyebrow="Call settings"
  heading="How Ion's call works." tone2={`Every morning at ${settings.time}.`}
  lede={`When Ion calls ${parent.short}, what it asks about, and what happens if she does not pick up. Changes take effect from the next call.`}>
  <LiveRegion />
  <p class="paused-banner" data-paused-banner hidden><Icon name="clock" size={18} /><span>Calls are paused. Ion will not call {parent.short} until you switch this off.</span></p>

  <div class="layout" data-settings data-parent={parent.short}>
    <div class="main">
      <Card as="section" pad="lg" class="block" aria-labelledby="when-title">
        <h2 id="when-title" class="bt"><Icon name="clock" size={20} />When Ion calls</h2>
        <div class="when-grid">
          <div class="cf-field">
            <label for="call-time">Time of the call</label>
            <input class="cf-input time" id="call-time" name="time" type="time" value={timeValue} step="300" />
          </div>
          <fieldset class="cf-set">
            <legend class="cf-legend">Days</legend>
            <div class="cf-choices days">
              {WEEK.map(([d, long]) => <label class="cf-choice day"><input type="checkbox" name="days" value={d} checked={settings.days.includes(d)} /><span aria-hidden="true">{d}</span><span class="sr-only">{long}</span></label>)}
            </div>
          </fieldset>
        </div>
      </Card>

      <Card as="section" pad="lg" class="block" aria-labelledby="retry-title">
        <h2 id="retry-title" class="bt"><Icon name="phone" size={20} />If she does not pick up</h2>
        <p>{settings.retry}</p>
        <ol role="list" class="tries">
          <li><b class="num">{settings.time.replace(' AM', '')}</b><span>Ion calls</span></li>
          {tries.map((t) => <li><b class="num">{t}</b><span>Tries again</span></li>)}
          <li><b><Icon name="users" size={16} /></b><span>{viewer.short} is told</span></li>
        </ol>
        <p class="muted small">Ion does not keep calling after that. A missed call is not a sign that anything is wrong, but it is worth a call from someone in the family.</p>
      </Card>

      <Card as="section" pad="lg" class="block" aria-labelledby="voice-title">
        <fieldset class="cf-set">
          <legend><h2 id="voice-title" class="bt"><Icon name="chat" size={20} />Ion's voice</h2></legend>
          <div class="cf-choices">
            {voices.map((v, i) => <label class="cf-choice"><input type="radio" name="voice" value={v} checked={i === 0} />{v.replace('Ion, ', '').replace(/^./, (c) => c.toUpperCase())}</label>)}
          </div>
        </fieldset>
      </Card>

      <Card as="section" pad="lg" class="block" aria-labelledby="topics-title">
        <h2 id="topics-title" class="bt"><Icon name="tasks" size={20} />What Ion asks about</h2>
        <div class="topics">
          <div>
            <h3 class="tt">Every call</h3>
            <p class="muted small">The everyday questions. They are always asked, so changes show up in the trends.</p>
            <ul role="list" class="fixed">
              {fixed.map((t) => <li><span>{t.label}</span><span class="always"><Icon name="lock" size={14} />Always on</span></li>)}
            </ul>
          </div>
          <div>
            <h3 class="tt">You choose</h3>
            <p class="muted small">Switch these off if they do not suit her.</p>
            <ul role="list" class="optional">
              {optional.map((t) => <li><Switch label={t.label} checked={t.on} name="topic" value={t.id} data-topic={t.id} /></li>)}
            </ul>
          </div>
        </div>
      </Card>

      <Card as="section" pad="lg" class="block pause" aria-labelledby="pause-title">
        <h2 id="pause-title" class="sr-only">Pause calls</h2>
        <Switch label="Pause calls while she is away" hint="For a hospital stay, a trip or a visit to family. Ion will not call until you switch this back off." data-pause />
      </Card>
    </div>

    <aside class="side" aria-labelledby="preview-title">
      <Card tone="soft" pad="lg" class="preview">
        <div class="preview-head">
          <Capybara size={96} ground="var(--surface)" label="Ion the capybara, on the phone" />
          <div>
            <h2 id="preview-title">How the call opens</h2>
            <p class="next" aria-live="off"><Icon name="today" size={16} /><span data-next>Next call: Wednesday at {settings.time}</span></p>
          </div>
        </div>
        <div class="bubble">
          <p>Good morning, {parent.short}. It's Ion. Is now a good time for a little chat?</p>
          <p data-opening>{openingTopics(topicIds)}</p>
          <p data-story-line hidden={!story}>And at the end, I have a story question for you.</p>
          <p>You can say no to any question, and we can stop whenever you like.</p>
        </div>
        <p class="muted small">Said in the voice you chose. Ion then asks each question in turn, with time for her to answer.</p>
      </Card>
    </aside>
  </div>

  <section class="truth" aria-labelledby="truth-title">
    <span class="truth-icon"><Icon name="shield" size={26} /></span>
    <div>
      <h2 id="truth-title">{STANDING_LINE}</h2>
      <p>Ion talks with {parent.short} once a day, and the family reads what she said. Between calls nobody is listening. If you are worried she is in danger, call her, a neighbor, or your local emergency number.</p>
    </div>
  </section>

  <section class="reset" aria-labelledby="reset-title">
    <h2 id="reset-title" class="tt">Reset the example</h2>
    <p class="muted small">Everything you have changed on these pages is kept in this browser only. Reset to start again with the example family as it was.</p>
    <ExampleNote />
  </section>
</AppLayout>

<script>
  import { announce, clock, load, save } from '@/components/app/care/store';
  import { openingTopics } from '@/components/app/care/words';

  interface S { time?: string; days?: string[]; voice?: string; topics?: Record<string, boolean>; paused?: boolean }
  const s = load<S>('settings', {});
  const root = document.querySelector<HTMLElement>('[data-settings]')!;
  const timeIn = root.querySelector<HTMLInputElement>('#call-time')!;
  const dayIns = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="days"]'));
  const voiceIns = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="voice"]'));
  const topicIns = Array.from(root.querySelectorAll<HTMLInputElement>('[data-topic]'));
  const pauseIn = root.querySelector<HTMLInputElement>('[data-pause]')!;
  const FIXED = ['sleep', 'meals', 'pain', 'medicines', 'falls'];
  const LONG: Record<string, string> = { Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday', Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday' };
  const ORDER = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

  // Bring back earlier changes.
  if (s.time) timeIn.value = s.time;
  if (s.days) dayIns.forEach((i) => { i.checked = s.days!.includes(i.value); });
  if (s.voice) voiceIns.forEach((i) => { i.checked = i.value === s.voice; });
  if (s.topics) topicIns.forEach((i) => { if (i.value in s.topics!) i.checked = s.topics![i.value]; });
  if (s.paused !== undefined) pauseIn.checked = s.paused;

  function preview() {
    const on = topicIns.filter((i) => i.checked).map((i) => i.value);
    const op = document.querySelector('[data-opening]');
    if (op) op.textContent = openingTopics([...FIXED, ...on.filter((id) => id !== 'story')]);
    const st = document.querySelector<HTMLElement>('[data-story-line]');
    if (st) st.hidden = !on.includes('story');
    const days = dayIns.filter((i) => i.checked).map((i) => i.value);
    const next = document.querySelector('[data-next]');
    const banner = document.querySelector<HTMLElement>('[data-paused-banner]');
    if (banner) banner.hidden = !pauseIn.checked;
    if (!next) return;
    if (pauseIn.checked) { next.textContent = 'Next call: paused'; return; }
    if (!days.length) { next.textContent = 'Next call: no days chosen'; return; }
    // Today in the example is Tuesday and the call is done, so look from Wednesday.
    const start = ORDER.indexOf('Wed');
    const day = Array.from({ length: 7 }, (_, k) => ORDER[(start + k) % 7]).find((d) => days.includes(d))!;
    next.textContent = `Next call: ${LONG[day]} at ${clock(timeIn.value || '09:00')}`;
  }

  function store(msg: string) {
    save('settings', {
      time: timeIn.value, days: dayIns.filter((i) => i.checked).map((i) => i.value),
      voice: voiceIns.find((i) => i.checked)?.value, topics: Object.fromEntries(topicIns.map((i) => [i.value, i.checked])), paused: pauseIn.checked,
    });
    preview();
    announce(`${msg} Kept in this browser.`);
  }

  timeIn.addEventListener('change', () => store(`Ion will call at ${clock(timeIn.value)}.`));
  dayIns.forEach((i) => i.addEventListener('change', () => store(`${LONG[i.value]} ${i.checked ? 'on' : 'off'}.`)));
  voiceIns.forEach((i) => i.addEventListener('change', () => store(`Voice: ${i.value}.`)));
  topicIns.forEach((i) => i.addEventListener('change', () => store(`${i.closest('label')?.querySelector('.sw-label')?.textContent ?? 'Topic'} ${i.checked ? 'on' : 'off'}.`)));
  pauseIn.addEventListener('change', () => store(pauseIn.checked ? 'Calls are paused.' : 'Calls are back on.'));
  preview();
</script>

<style>
  .paused-banner { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-4) var(--s-5); border-radius: var(--r-lg); background: var(--deep); color: var(--on-deep); font-weight: 500; }
  .paused-banner[hidden] { display: none; }
  .paused-banner :global(svg) { flex: none; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 24rem; gap: var(--s-6); align-items: start; }
  .main { display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  :global(.block) { display: flex; flex-direction: column; gap: var(--s-4); }
  .bt { display: flex; align-items: center; gap: var(--s-3); font-size: 1.25rem; font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; }
  .bt :global(svg) { color: var(--acc-text); flex: none; }
  .tt { font-size: 1.0625rem; font-weight: 500; }
  .when-grid { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: var(--s-5); align-items: start; }
  .time { font-size: 1.25rem; font-variant-numeric: tabular-nums; }
  .days { gap: var(--s-2); }
  .day { min-width: 3.75rem; justify-content: center; padding: 0 var(--s-3); }
  .tries { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr)); gap: var(--s-2); }
  .tries li { display: flex; flex-direction: column; gap: 0.125rem; padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--paper); font-size: var(--fs-sm); color: var(--ink-2); }
  .tries b { display: flex; align-items: center; min-height: 1.75rem; font-size: 1.25rem; font-weight: 500; color: var(--ink); }
  .tries li:last-child { background: var(--acc-soft); color: var(--ink); }
  .topics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); }
  .topics > div { display: flex; flex-direction: column; gap: var(--s-2); }
  .fixed, .optional { display: flex; flex-direction: column; margin-top: var(--s-2); }
  .fixed li { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: var(--tap); border-bottom: 1px solid var(--line); }
  .optional li { border-bottom: 1px solid var(--line); }
  .always { display: inline-flex; align-items: center; gap: var(--s-1); font-size: var(--fs-sm); color: var(--ink-2); }
  :global(.pause) { padding-block: var(--s-5) !important; }

  .side { position: sticky; top: var(--s-6); }
  :global(.preview) { display: flex; flex-direction: column; gap: var(--s-5); }
  .preview-head { display: flex; align-items: center; gap: var(--s-4); }
  .preview-head :global(svg.capy) { flex: none; }
  .preview-head h2 { font-size: var(--fs-h3); font-weight: 400; line-height: 1.2; letter-spacing: -0.02em; }
  .next { display: flex; align-items: center; gap: var(--s-2); margin-top: var(--s-2); font-size: var(--fs-sm); font-weight: 500; }
  .bubble { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); border-radius: var(--r-lg); border-top-left-radius: var(--r-sm); background: var(--surface); font-size: 1.125rem; line-height: 1.55; }
  .bubble [hidden] { display: none; }

  .truth { display: flex; gap: var(--s-5); align-items: flex-start; padding: var(--s-8); border-radius: var(--r-xl); background: var(--deep); color: var(--on-deep); }
  .truth-icon { display: grid; place-items: center; flex: none; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--acc); color: var(--on-acc); }
  .truth h2 { font-size: var(--fs-h3); font-weight: 400; line-height: 1.3; letter-spacing: -0.02em; max-width: 44rem; }
  .truth p { margin-top: var(--s-3); max-width: 44rem; line-height: 1.6; }
  .reset { display: flex; flex-direction: column; gap: var(--s-2); }

  @media (max-width: 75rem) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; order: -1; }
  }
  @media (max-width: 40rem) {
    .when-grid, .topics { grid-template-columns: minmax(0, 1fr); }
    .truth { flex-direction: column; padding: var(--s-5); }
    .preview-head :global(svg.capy) { width: 88px; height: 88px; }
    .day { min-width: 3.25rem; }
  }
</style>
