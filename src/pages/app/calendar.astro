---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import AgendaRow from '@/components/app/care/AgendaRow.astro';
import FormCard from '@/components/app/care/FormCard.astro';
import Field from '@/components/app/care/Field.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import { getAgenda } from '@/lib/loaders-care';

const days = await getAgenda(14);
const total = days.reduce((n, d) => n + d.items.length, 0);
const mentions = days.flatMap((d) => d.items.filter((i) => i.mention)).length;
const kinds = ['appointment', 'visit', 'refill'] as const;
const kindLabel = { appointment: 'Appointment', visit: 'Visit', refill: 'Refill' };
const things = (n: number) => (n === 0 ? 'nothing planned' : n === 1 ? '1 thing' : `${n} things`);
---
<AppLayout title="Calendar" active="calendar" eyebrow="Calendar"
  heading="The next two weeks." tone2={`${total} things planned, plus her call each morning.`}
  lede="Appointments, visits and refills in one list, shared with the whole family. Ion mentions what is coming up on her morning call, so she is not caught by surprise.">
  <Button slot="head-actions" href="#add" variant="secondary" size="sm" class="head-add"><Icon name="plus" size={16} />Add to the calendar</Button>
  <LiveRegion />

  <nav class="strip" aria-label="Jump to a day">
    <ol role="list">
      {days.map((d) => (
        <li>
          <a href={`#day-${d.iso}`} class:list={{ today: d.isToday }} aria-current={d.isToday ? 'date' : undefined} data-strip={d.iso}>
            <span class="strip-wd">{d.weekday}</span>
            <span class="strip-n num">{d.dayNum}</span>
            <span class="strip-dots" aria-hidden="true" data-dots>{d.items.map(() => <i></i>)}</span>
            <span class="sr-only" data-strip-label>{d.label}: {things(d.items.length)}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="layout">
    <section class="agenda" aria-labelledby="agenda-title">
      <h2 id="agenda-title" class="sr-only">Day by day</h2>
      <ol role="list" class="days">
        {days.map((d, i) => (
          <li class:list={['day', { 'is-today': d.isToday }]} id={`day-${d.iso}`} data-day={d.iso}>
            <div class="day-date">
              <span class="day-wd">{d.weekday}</span>
              <span class="day-n num">{d.dayNum}</span>
            </div>
            <div class="day-body">
              <h3 class="day-title">{d.label}{d.isToday && <span class="day-tag">Today</span>}{i === 1 && <span class="day-tag quiet">Tomorrow</span>}</h3>
              <p class="day-call"><Icon name="phone" size={16} /><span><span class="num">{d.call.time}</span> · Ion's daily call{d.call.note && <span>. {d.call.note}</span>}</span></p>
              <ul role="list" class="day-items" data-items>
                {d.items.map((it) => <AgendaRow id={it.id} kind={it.kind} title={it.title} time={it.time} note={it.note} mention={it.mention} sort={it.sort} />)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="side">
      <div class="mentions">
        <span class="mentions-icon"><Icon name="chat" size={20} /></span>
        <p><b>Ion will bring up {mentions} of these on her morning calls.</b> She hears about each one a day or two before, in Ion's words, and can ask Ion to say it again.</p>
      </div>

      <FormCard id="add" title="Add to the calendar" sub="It appears in the list straight away, for the whole family to see.">
        <form class="cf" data-add novalidate>
          <Field label="What is it" for="ev-title" hint="For example: Dentist, or Lunch with June.">
            <input class="cf-input" id="ev-title" name="title" type="text" required maxlength="80" autocomplete="off" aria-describedby="ev-title-hint ev-error" />
          </Field>
          <div class="cf-grid">
            <Field label="Day" for="ev-day">
              <select class="cf-select" id="ev-day" name="day">
                {days.map((d) => <option value={d.iso}>{d.short}{d.isToday ? ' (today)' : ''}</option>)}
              </select>
            </Field>
            <Field label="Time (if there is one)" for="ev-time">
              <input class="cf-input" id="ev-time" name="time" type="time" />
            </Field>
          </div>
          <fieldset class="cf-set">
            <legend class="cf-legend">Kind</legend>
            <div class="cf-choices">
              {kinds.map((k, i) => <label class="cf-choice"><input type="radio" name="kind" value={k} checked={i === 0} />{kindLabel[k]}</label>)}
            </div>
          </fieldset>
          <label class="cf-choice check"><input type="checkbox" name="mention" checked />Ask Ion to mention it on that morning's call</label>
          <p class="cf-hint err" id="ev-error" hidden>Please say what it is.</p>
          <div class="cf-actions"><Button type="submit" variant="dark"><Icon name="plus" size={16} />Add</Button></div>
          <p class="cf-done" data-done hidden><Icon name="check" size={16} /><span data-msg></span></p>
        </form>
      </FormCard>
      <ExampleNote />
    </div>
  </div>

  {kinds.map((k) => <template id={`tpl-${k}`}><AgendaRow kind={k} added /></template>)}
</AppLayout>

<script>
  import { announce, clock, fromTemplate, load, save, uid } from '@/components/app/care/store';

  interface Added { id: string; title: string; day: string; time: string; kind: 'appointment' | 'visit' | 'refill'; mention: boolean }
  let added = load<Added[]>('calendar', []);

  const sortOf = (t: string) => { if (!t) return -1; const [h, m] = t.split(':').map(Number); return h * 60 + m; };
  const dayLabel = (iso: string) => document.querySelector(`[data-day="${iso}"] .day-title`)?.firstChild?.textContent ?? iso;
  const weekdayLong = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { weekday: 'long', timeZone: 'UTC' });

  function refreshStrip(iso: string) {
    const list = document.querySelector(`[data-day="${iso}"] [data-items]`);
    const link = document.querySelector(`[data-strip="${iso}"]`);
    if (!list || !link) return;
    const n = list.children.length;
    const dots = link.querySelector('[data-dots]');
    if (dots) dots.replaceChildren(...Array.from({ length: n }, () => document.createElement('i')));
    const lab = link.querySelector('[data-strip-label]');
    if (lab) lab.textContent = `${dayLabel(iso)}: ${n === 0 ? 'nothing planned' : n === 1 ? '1 thing' : `${n} things`}`;
  }

  function render(a: Added) {
    const list = document.querySelector(`[data-day="${a.day}"] [data-items]`);
    if (!list) return null;
    const row = fromTemplate(`tpl-${a.kind}`, {
      title: a.title, time: a.time ? clock(a.time) : '', 'remove-label': ` ${a.title}`,
      mention: a.mention ? `Ion will mention it on ${weekdayLong(a.day)} morning's call.` : '',
    });
    row.dataset.item = a.id;
    row.dataset.sort = String(sortOf(a.time));
    const wrap = row.querySelector<HTMLElement>('[data-slot-wrap="mention"]');
    if (wrap) wrap.hidden = !a.mention;
    row.querySelector<HTMLButtonElement>('[data-remove]')?.addEventListener('click', () => {
      added = added.filter((x) => x.id !== a.id);
      save('calendar', added);
      row.remove();
      refreshStrip(a.day);
      announce(`${a.title} removed from ${dayLabel(a.day)}.`);
      document.getElementById('ev-title')?.focus();
    });
    const after = Array.from(list.children).find((c) => Number((c as HTMLElement).dataset.sort) > sortOf(a.time));
    list.insertBefore(row, after ?? null);
    refreshStrip(a.day);
    return row;
  }

  added.forEach(render);

  const form = document.querySelector<HTMLFormElement>('[data-add]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const title = String(fd.get('title') ?? '').trim();
    const err = document.getElementById('ev-error');
    const titleInput = document.getElementById('ev-title') as HTMLInputElement;
    if (!title) { if (err) err.hidden = false; titleInput.setAttribute('aria-invalid', 'true'); titleInput.focus(); return; }
    if (err) err.hidden = true;
    titleInput.removeAttribute('aria-invalid');
    const a: Added = { id: uid(), title, day: String(fd.get('day')), time: String(fd.get('time') ?? ''), kind: (fd.get('kind') as Added['kind']) ?? 'appointment', mention: fd.get('mention') === 'on' };
    added.push(a);
    save('calendar', added);
    render(a);
    const msg = `Added ${title} on ${dayLabel(a.day)}${a.time ? ` at ${clock(a.time)}` : ''}.${a.mention ? ' Ion will mention it that morning.' : ''}`;
    const done = form.querySelector<HTMLElement>('[data-done]');
    const m = form.querySelector('[data-msg]');
    if (m) m.textContent = msg;
    if (done) done.hidden = false;
    announce(msg);
    titleInput.value = '';
    (form.querySelector('#ev-time') as HTMLInputElement).value = '';
  });
</script>

<style>
  :global(.head-add) { align-self: flex-start; }
  .strip ol { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: var(--s-1); padding: var(--s-2); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .strip a { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; min-height: 4.5rem; padding: var(--s-2) 0; border-radius: var(--r-md); text-decoration: none; color: var(--ink); }
  .strip a:hover { background: var(--paper); }
  .strip a.today { background: var(--deep); color: var(--on-deep); }
  .strip-wd { font-size: var(--fs-xs); color: inherit; opacity: 0.8; }
  .strip-n { font-size: 1.25rem; font-weight: 500; line-height: 1.2; }
  .strip-dots { display: flex; gap: 3px; min-height: 0.375rem; }
  .strip-dots :global(i) { width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--acc-text); }
  .today .strip-dots :global(i) { background: var(--acc); }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 24rem; gap: var(--s-8); align-items: start; }
  .days { display: flex; flex-direction: column; }
  .day { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: var(--s-4); padding: var(--s-5) 0; border-top: 1px solid var(--line); scroll-margin-top: var(--s-4); }
  .day:first-child { border-top: 0; padding-top: 0; }
  .day-date { display: flex; flex-direction: column; align-items: center; padding: var(--s-2) 0; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line); line-height: 1.1; }
  .is-today .day-date { background: var(--deep); color: var(--on-deep); border-color: var(--deep); }
  .day-wd { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.06em; }
  .day-n { font-size: 1.5rem; font-weight: 500; }
  .day-body { display: flex; flex-direction: column; gap: var(--s-2); min-width: 0; }
  .day-title { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); font-size: 1.125rem; font-weight: 500; line-height: 1.4; }
  .day-tag { font-size: var(--fs-xs); font-weight: 500; padding: 0.125rem 0.5rem; border-radius: var(--r-pill); background: var(--acc); color: var(--on-acc); }
  .day-tag.quiet { background: var(--grey-1); color: var(--ink); }
  .day-call { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .day-call :global(svg) { flex: none; }
  .day-items { display: flex; flex-direction: column; gap: var(--s-2); }
  .day-items:empty { display: none; }

  .side { position: sticky; top: var(--s-6); display: flex; flex-direction: column; gap: var(--s-4); }
  .mentions { display: flex; gap: var(--s-3); padding: var(--s-5); border-radius: var(--r-lg); background: var(--acc-soft); font-size: 0.9375rem; line-height: 1.55; }
  .mentions b { font-weight: 500; }
  .mentions-icon { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--surface); color: var(--acc-text); }
  .check { border-radius: var(--r-md); align-self: flex-start; }
  .err { color: var(--ink); font-weight: 500; }
  .err[hidden] { display: none; }

  @media (max-width: 75rem) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
  }
  @media (max-width: 40rem) {
    .strip ol { grid-template-columns: repeat(7, minmax(0, 1fr)); }
    .strip a { min-height: 4rem; }
    .day { grid-template-columns: 2.75rem minmax(0, 1fr); gap: var(--s-3); }
    .day-n { font-size: 1.25rem; }
  }
</style>
