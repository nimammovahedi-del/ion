---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import Capybara from '@/components/ui/Capybara.astro';
import AgendaRow from '@/components/app/care/AgendaRow.astro';
import Part from '@/components/app/care/Part.astro';
import HeadArt from '@/components/app/care/HeadArt.astro';
import FormCard from '@/components/app/care/FormCard.astro';
import Field from '@/components/app/care/Field.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import { getAgenda } from '@/lib/loaders-care';

const days = await getAgenda(14);
const total = days.reduce((n, d) => n + d.items.length, 0);
const mentions = days.flatMap((d) => d.items.filter((i) => i.mention)).length;
const kinds = ['appointment', 'visit', 'refill'] as const;
const kindLabel = { appointment: 'Appointment', visit: 'Visit', refill: 'Refill' };
const things = (n: number) => (n === 0 ? 'nothing planned' : n === 1 ? '1 thing' : `${n} things`);
const month = (short: string) => short.split(' ')[1];
const callTime = days[0]?.call.time ?? '';
---
<AppLayout title="Calendar" active="calendar" eyebrow="Calendar"
  heading="The next two weeks." tone2={`${total} things planned.`}
  lede="One calendar for the whole family. Ion mentions what is coming up on her morning call.">
  <HeadArt slot="head-art" name="calendar" />
  <Button slot="head-actions" href="#add" variant="primary" size="sm"><Icon name="plus" size={16} />Add to the calendar</Button>
  <LiveRegion />

  <nav class="wk" aria-label="The next two weeks. Jump to a day">
    <ol role="list" class="wk-grid">
      {days.map((d, i) => (
        <li>
          <a href={`#day-${d.iso}`} class:list={['wk-day', { today: d.isToday, busy: d.items.length > 0 }]} aria-current={d.isToday ? 'date' : undefined} data-strip={d.iso}>
            <span class="wk-top" aria-hidden="true">
              <span class="wk-wd">{d.isToday ? 'Today' : d.weekday}</span>
              <span class="wk-n num">{(i === 0 || d.dayNum === '1') && <span class="wk-month">{month(d.short)} </span>}{d.dayNum}</span>
            </span>
            <span class="wk-items" aria-hidden="true" data-dots>{d.items.map((it) => <span class={`wk-chip wk-${it.kind}`}>{it.title}</span>)}</span>
            <span class="sr-only" data-strip-label>{d.label}: {things(d.items.length)}</span>
          </a>
        </li>
      ))}
    </ol>
    <ul role="list" class="wk-key">
      <li><span class="wk-dot wk-call"><Icon name="phone" size={14} /></span>Ion calls every morning at {callTime}</li>
      <li><span class="wk-dot wk-appointment"></span>Appointment</li>
      <li><span class="wk-dot wk-visit"></span>Visit</li>
      <li><span class="wk-dot wk-refill"></span>Refill</li>
    </ul>
  </nav>

  <div class="layout">
    <Part id="agenda" title="Day by day" icon="calendar" tone="butter">
      <ol role="list" class="days">
        {days.map((d, i) => (
          <li class:list={['day', { 'is-today': d.isToday, 'is-empty': d.items.length === 0 && !d.isToday }]} id={`day-${d.iso}`} data-day={d.iso}>
            <div class="day-date" aria-hidden="true">
              <span class="day-wd">{d.weekday}</span>
              <span class="day-n num">{d.dayNum}</span>
            </div>
            <div class="day-body">
              <h3 class="day-title">{d.label}{d.isToday && <span class="day-tag">Today</span>}{i === 1 && <span class="day-tag quiet">Tomorrow</span>}</h3>
              {d.call.note && <p class="day-call"><Icon name="phone" size={16} /><span>Ion called at <span class="num">{d.call.time}</span>. {d.call.note}.</span></p>}
              <ul role="list" class="day-items" data-items>
                {d.items.map((it) => <AgendaRow id={it.id} kind={it.kind} title={it.title} time={it.time} note={it.note} mention={it.mention} sort={it.sort} />)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </Part>

    <div class="side">
      <FormCard id="add" title="Add something" accent="butter">
        <form class="cf" data-add novalidate>
          <Field label="What is it" for="ev-title">
            <input class="cf-input" id="ev-title" name="title" type="text" required maxlength="80" autocomplete="off" placeholder="Dentist, or lunch with June" aria-describedby="ev-error" />
          </Field>
          <div class="cf-grid">
            <Field label="Day" for="ev-day">
              <select class="cf-select" id="ev-day" name="day">
                {days.map((d) => <option value={d.iso}>{d.short}{d.isToday ? ' (today)' : ''}</option>)}
              </select>
            </Field>
            <Field label="Time, if any" for="ev-time">
              <input class="cf-input" id="ev-time" name="time" type="time" />
            </Field>
          </div>
          <fieldset class="cf-set">
            <legend class="cf-legend">Kind</legend>
            <div class="cf-choices">
              {kinds.map((k, i) => <label class="cf-choice"><input type="radio" name="kind" value={k} checked={i === 0} />{kindLabel[k]}</label>)}
            </div>
          </fieldset>
          <label class="cf-choice check"><input type="checkbox" name="mention" checked />Ask Ion to mention it on that morning's call</label>
          <p class="cf-hint err" id="ev-error" hidden>Please say what it is.</p>
          <div class="cf-actions"><Button type="submit" variant="dark"><Icon name="plus" size={16} />Add</Button></div>
          <p class="cf-done" data-done hidden><Icon name="check" size={16} /><span data-msg></span></p>
        </form>
      </FormCard>

      <div class="mentions">
        <Capybara size={64} ground="var(--surface)" label="" />
        <p><b>Ion will bring up {mentions} of these</b> on her morning calls, a day or two before, so nothing catches her by surprise.</p>
      </div>
      <ExampleNote />
    </div>
  </div>

  {kinds.map((k) => <template id={`tpl-${k}`}><AgendaRow kind={k} added /></template>)}
</AppLayout>

<script>
  import { announce, clock, fromTemplate, load, save, uid } from '@/components/app/care/store';

  interface Added { id: string; title: string; day: string; time: string; kind: 'appointment' | 'visit' | 'refill'; mention: boolean }
  let added = load<Added[]>('calendar', []);

  const sortOf = (t: string) => { if (!t) return -1; const [h, m] = t.split(':').map(Number); return h * 60 + m; };
  const dayLabel = (iso: string) => document.querySelector(`[data-day="${iso}"] .day-title`)?.firstChild?.textContent ?? iso;
  const todayIso = document.querySelector('[data-day]')?.getAttribute('data-day') ?? '';
  const weekdayLong = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { weekday: 'long', timeZone: 'UTC' });

  /** Redraw one day in the two-week picture from what is in that day's list. */
  function refreshStrip(iso: string) {
    const day = document.querySelector<HTMLElement>(`[data-day="${iso}"]`);
    const list = day?.querySelector('[data-items]');
    const link = document.querySelector(`[data-strip="${iso}"]`);
    if (!day || !list || !link) return;
    const rows = Array.from(list.children) as HTMLElement[];
    const n = rows.length;
    day.classList.toggle('is-empty', n === 0 && iso !== todayIso);
    link.classList.toggle('busy', n > 0);
    const dots = link.querySelector('[data-dots]');
    if (dots) dots.replaceChildren(...rows.map((r) => {
      const chip = document.createElement('span');
      chip.className = `wk-chip wk-${r.dataset.kind ?? 'appointment'}`;
      chip.textContent = r.querySelector('[data-slot="title"]')?.textContent ?? '';
      return chip;
    }));
    const lab = link.querySelector('[data-strip-label]');
    if (lab) lab.textContent = `${dayLabel(iso)}: ${n === 0 ? 'nothing planned' : n === 1 ? '1 thing' : `${n} things`}`;
  }

  function render(a: Added) {
    const list = document.querySelector(`[data-day="${a.day}"] [data-items]`);
    if (!list) return null;
    const row = fromTemplate(`tpl-${a.kind}`, {
      title: a.title, time: a.time ? clock(a.time) : '', 'remove-label': ` ${a.title}`,
      mention: !a.mention ? '' : a.day === todayIso ? 'Today\'s call is done, so Ion will not mention this one.' : `Ion will mention it on ${weekdayLong(a.day)} morning's call.`,
    });
    row.dataset.item = a.id;
    row.dataset.sort = String(sortOf(a.time));
    const wrap = row.querySelector<HTMLElement>('[data-slot-wrap="mention"]');
    if (wrap) wrap.hidden = !a.mention;
    row.querySelector<HTMLButtonElement>('[data-remove]')?.addEventListener('click', () => {
      added = added.filter((x) => x.id !== a.id);
      save('calendar', added);
      row.remove();
      refreshStrip(a.day);
      announce(`${a.title} removed from ${dayLabel(a.day)}.`);
      document.getElementById('ev-title')?.focus();
    });
    const after = Array.from(list.children).find((c) => Number((c as HTMLElement).dataset.sort) > sortOf(a.time));
    list.insertBefore(row, after ?? null);
    refreshStrip(a.day);
    return row;
  }

  added.forEach(render);

  const form = document.querySelector<HTMLFormElement>('[data-add]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const title = String(fd.get('title') ?? '').trim();
    const err = document.getElementById('ev-error');
    const titleInput = document.getElementById('ev-title') as HTMLInputElement;
    if (!title) { const was = form.querySelector<HTMLElement>('[data-done]'); if (was) was.hidden = true; if (err) err.hidden = false; titleInput.setAttribute('aria-invalid', 'true'); titleInput.focus(); return; }
    if (err) err.hidden = true;
    titleInput.removeAttribute('aria-invalid');
    const a: Added = { id: uid(), title, day: String(fd.get('day')), time: String(fd.get('time') ?? ''), kind: (fd.get('kind') as Added['kind']) ?? 'appointment', mention: fd.get('mention') === 'on' };
    added.push(a);
    save('calendar', added);
    render(a);
    const msg = `Added ${title} on ${dayLabel(a.day)}${a.time ? ` at ${clock(a.time)}` : ''}.${a.mention && a.day !== todayIso ? ' Ion will mention it that morning.' : ''}`;
    const done = form.querySelector<HTMLElement>('[data-done]');
    const m = form.querySelector('[data-msg]');
    if (m) m.textContent = msg;
    if (done) done.hidden = false;
    announce(msg);
    titleInput.value = '';
    (form.querySelector('#ev-time') as HTMLInputElement).value = '';
  });
</script>

<style>
  /* the two weeks as a picture: one column per day, a chip for each thing */
  .wk { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-xl); background: var(--butter-soft); }
  .wk-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--s-2); }
  .wk-day { display: flex; flex-direction: column; gap: var(--s-2); height: 100%; min-height: 6.5rem; padding: var(--s-2) var(--s-3) var(--s-3); border-radius: var(--r-md); background: var(--surface); color: var(--ink); text-decoration: none; opacity: 0.72; transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease); }
  .wk-day.busy, .wk-day.today { opacity: 1; }
  .wk-day:hover { color: var(--ink); transform: translateY(-2px); box-shadow: var(--shadow-1); opacity: 1; }
  .wk-day.today { background: var(--deep); color: var(--on-deep); }
  .wk-day.today:hover { color: var(--on-deep); }
  .wk-top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2); }
  .wk-wd { font-size: var(--fs-sm); font-weight: 500; }
  .wk-n { font-size: 1.125rem; font-weight: 500; line-height: 1.2; white-space: nowrap; }
  .wk-month { font-size: var(--fs-sm); font-weight: 400; }
  .wk-items { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .wk-items :global(.wk-chip) { display: block; padding: 0.1875rem 0.5rem; border-radius: var(--r-sm); font-size: 0.8125rem; line-height: 1.3; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wk :global(.wk-appointment) { background: var(--acc-soft); }
  .wk :global(.wk-visit) { background: var(--leaf-soft); }
  .wk :global(.wk-refill) { background: var(--sky-soft); }
  .wk-key { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: var(--fs-sm); color: var(--ink-2); }
  .wk-key li { display: inline-flex; align-items: center; gap: var(--s-2); }
  .wk-key li:first-child { margin-right: auto; color: var(--ink); }
  .wk-dot { display: inline-grid; place-items: center; width: 1rem; height: 1rem; border-radius: 0.3125rem; border: 1px solid var(--hair); }
  .wk-dot.wk-call { width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 0; background: var(--surface); }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 24rem; gap: var(--s-8); align-items: start; }
  .days { display: flex; flex-direction: column; gap: var(--s-5); }
  .day { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: var(--s-4); scroll-margin-top: var(--s-4); }
  .day.is-empty { display: none; }
  .day-date { display: flex; flex-direction: column; align-items: center; align-self: start; padding: var(--s-2) 0; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line); line-height: 1.15; }
  .is-today .day-date { background: var(--deep); color: var(--on-deep); border-color: var(--deep); }
  .day-wd { font-size: var(--fs-sm); }
  .day-n { font-size: 1.5rem; font-weight: 500; }
  .day-body { display: flex; flex-direction: column; gap: var(--s-2); min-width: 0; }
  .day-title { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); font-size: 1.0625rem; font-weight: 500; line-height: 1.4; }
  .day-tag { font-size: var(--fs-xs); font-weight: 500; padding: 0.125rem 0.5rem; border-radius: var(--r-pill); background: var(--butter); color: var(--ink); }
  .day-tag.quiet { background: var(--surface); border: 1px solid var(--line); }
  .day-call { display: flex; align-items: center; gap: var(--s-2); font-size: 0.9375rem; color: var(--ink-2); }
  .day-call :global(svg) { flex: none; }
  .day-items { display: flex; flex-direction: column; gap: var(--s-2); }
  .day-items:empty { display: none; }

  .side { position: sticky; top: var(--s-6); display: flex; flex-direction: column; gap: var(--s-4); }
  .mentions { display: flex; align-items: center; gap: var(--s-4); padding: var(--s-4) var(--s-5); border-radius: var(--r-lg); background: var(--acc-soft); font-size: 0.9375rem; line-height: 1.5; }
  .mentions :global(svg) { flex: none; width: 3.5rem; height: 3.5rem; }
  .mentions b { font-weight: 600; }
  .check { border-radius: var(--r-md); align-self: flex-start; min-height: var(--tap); height: auto; padding-block: var(--s-2); line-height: 1.35; }
  .err { color: var(--ink); font-weight: 500; }
  .err[hidden] { display: none; }

  @media (max-width: 75rem) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
  }
  @media (max-width: 48rem) {
    .wk { padding: var(--s-3); }
    .wk-grid { gap: var(--s-1); }
    .wk-day { min-height: 4rem; padding: var(--s-2) var(--s-1); align-items: center; }
    .wk-top { flex-direction: column; align-items: center; gap: 0; }
    .wk-month { display: none; }
    .wk-wd { font-size: var(--fs-xs); }
    .wk-items { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 0.1875rem; }
    .wk-items :global(.wk-chip) { width: 0.5rem; height: 0.5rem; padding: 0; border-radius: 50%; font-size: 0; border: 1px solid var(--hair); }
    .day { grid-template-columns: 2.75rem minmax(0, 1fr); gap: var(--s-3); }
    .day-n { font-size: 1.25rem; }
  }
</style>
