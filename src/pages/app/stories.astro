---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Capybara from '@/components/ui/Capybara.astro';
import Button from '@/components/ui/Button.astro';
import HerWords from '@/components/app/care/HerWords.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import { getFamily, getParent, getViewer } from '@/lib/loaders';
import { getNextStoryQuestion, getStoryEntries } from '@/lib/loaders-care';
import { listWords } from '@/components/app/care/words';

const [stories, parent, family, viewer, next] = await Promise.all([getStoryEntries(), getParent(), getFamily(), getViewer(), getNextStoryQuestion()]);
const others = listWords(family.filter((p) => p.id !== viewer.id).map((p) => p.short));
const [latest, ...rest] = stories;
---
<AppLayout title="Stories" active="stories" eyebrow="Stories"
  heading={`In ${parent.short}'s own words.`} tone2="Kept for the family."
  lede={`Every call ends with one story question. These are the things ${parent.short} has told Ion, written down so they are not lost.`}>
  <LiveRegion />
  <div hidden data-others={others}></div>

  <article class="feature" aria-labelledby={`s-${latest.id}`} data-story={latest.id}>
    <div class="feature-meta">
      <p class="date">{latest.date} · Latest</p>
      <p class="asked">Ion asked, “{latest.question}”</p>
    </div>
    <h2 id={`s-${latest.id}`} class="feature-title">{latest.title}</h2>
    {latest.quote && <HerWords text={latest.quote} size="lg" cite={parent.short} />}
    <p class="feature-text">{latest.text}</p>
    <div class="share">
      <Button variant="secondary" size="sm" data-share><Icon name="users" size={16} />Share with the family</Button>
      <p class="shared" data-shared hidden><Icon name="check" size={16} />Shared with {others}.</p>
    </div>
  </article>

  <section class="more" aria-labelledby="more-title">
    <h2 id="more-title" class="more-title">Earlier this week</h2>
    <ol role="list" class="list">
      {rest.map((s) => (
        <li>
          <article class="story" aria-labelledby={`s-${s.id}`} data-story={s.id}>
            <p class="date">{s.date}</p>
            <div class="story-body">
              <p class="asked">Ion asked, “{s.question}”</p>
              <h3 id={`s-${s.id}`}>{s.title}</h3>
              <p class="story-text">{s.text}</p>
              {s.quote && <HerWords text={s.quote} cite={parent.short} />}
              <div class="share">
                <Button variant="ghost" size="sm" data-share><Icon name="users" size={16} />Share with the family</Button>
                <p class="shared" data-shared hidden><Icon name="check" size={16} />Shared with {others}.</p>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>

  <aside class="next" aria-label="Tomorrow's story question">
    <Capybara size={96} waves={false} ground="var(--surface)" label="Ion the capybara" />
    <div>
      <p class="next-label">Tomorrow, Ion will ask</p>
      <p class="next-q">“{next}”</p>
      <p class="next-note">If she would rather not tell a story, Ion simply says goodbye. Every story is kept here for the family.</p>
    </div>
  </aside>

  <ExampleNote />
</AppLayout>

<script>
  import { announce, load, save } from '@/components/app/care/store';
  const shared = load<string[]>('stories-shared', []);
  const others = document.querySelector<HTMLElement>('[data-others]')?.dataset.others ?? 'the family';
  function mark(card: HTMLElement) {
    const btn = card.querySelector<HTMLButtonElement>('[data-share]');
    const done = card.querySelector<HTMLElement>('[data-shared]');
    if (btn) btn.hidden = true;
    if (done) done.hidden = false;
  }
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((card) => {
    const id = card.dataset.story as string;
    if (shared.includes(id)) mark(card);
    card.querySelector('[data-share]')?.addEventListener('click', () => {
      shared.push(id);
      save('stories-shared', shared);
      mark(card);
      const done = card.querySelector<HTMLElement>('[data-shared]');
      done?.setAttribute('tabindex', '-1');
      done?.focus();
      const title = card.querySelector('h2, h3')?.textContent ?? 'Story';
      announce(`${title}: shared with ${others}.`);
    });
  });
</script>

<style>
  .feature { display: flex; flex-direction: column; gap: var(--s-6); padding: clamp(var(--s-6), 5vw, var(--s-16)); border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); }
  .feature-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-6); }
  .date { font-family: var(--mono); font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .asked { font-size: var(--fs-sm); color: var(--ink-2); font-style: italic; }
  .feature-title { font-size: var(--fs-h2); font-weight: 300; line-height: 1.08; letter-spacing: -0.03em; max-width: 40rem; }
  .feature-text { font-size: 1.25rem; line-height: 1.7; max-width: 40rem; }
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .share :global([hidden]) { display: none; }
  .shared { display: inline-flex; align-items: center; gap: var(--s-2); min-height: var(--tap); padding: 0 var(--s-4); border-radius: var(--r-pill); background: var(--acc-soft); font-size: var(--fs-sm); font-weight: 500; }
  .shared[hidden] { display: none; }

  .more { display: flex; flex-direction: column; gap: var(--s-4); }
  .more-title { font-size: var(--fs-h3); font-weight: 400; letter-spacing: -0.02em; }
  .list { display: flex; flex-direction: column; }
  .story { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--s-4) var(--s-8); padding: var(--s-8) 0; border-top: 1px solid var(--line-strong); }
  .story .date { padding-top: 0.375rem; }
  .story-body { display: flex; flex-direction: column; gap: var(--s-4); max-width: 42rem; }
  .story h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 300; line-height: 1.2; letter-spacing: -0.02em; }
  .story-text { font-size: 1.125rem; line-height: 1.7; }

  .next { display: flex; align-items: center; gap: var(--s-6); padding: var(--s-6) var(--s-8); border-radius: var(--r-xl); background: var(--acc-soft); }
  .next :global(svg) { flex: none; }
  .next-label { font-family: var(--mono); font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .next-q { font-size: clamp(1.375rem, 2.6vw, 1.875rem); font-weight: 300; line-height: 1.25; letter-spacing: -0.02em; margin: var(--s-1) 0 var(--s-2); }
  .next-note { font-size: var(--fs-sm); color: var(--ink-2); max-width: 40rem; }

  @media (max-width: 40rem) {
    .story { grid-template-columns: minmax(0, 1fr); gap: var(--s-2); padding: var(--s-6) 0; }
    .next { flex-direction: column; align-items: flex-start; padding: var(--s-5); }
    .feature-text { font-size: 1.125rem; }
  }
</style>
