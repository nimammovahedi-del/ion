---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Chip from '@/components/ui/Chip.astro';
import Button from '@/components/ui/Button.astro';
import Part from '@/components/app/care/Part.astro';
import Avatar from '@/components/app/care/Avatar.astro';
import Bubble from '@/components/app/care/Bubble.astro';
import HeadArt from '@/components/app/care/HeadArt.astro';
import HowFlow from '@/components/app/care/HowFlow.astro';
import ServiceArt from '@/components/app/care/ServiceArt.astro';
import AlsoOn from '@/components/app/care/AlsoOn.astro';
import ExampleNote from '@/components/app/care/ExampleNote.astro';
import LiveRegion from '@/components/app/care/LiveRegion.astro';
import { getParent } from '@/lib/loaders';
import { getAlso, getPlannedServices, getPreparedRequest } from '@/lib/loaders-care';

const [services, request, parent, also] = await Promise.all([getPlannedServices(), getPreparedRequest(), getParent(), getAlso()]);
const how = [
  { icon: 'phone', title: 'She asks', text: 'On a call, in her own words', tone: 'leaf' },
  { icon: 'check', title: 'You approve', text: 'Nothing happens without a yes', tone: 'acc' },
  { icon: 'car', title: 'It is arranged', text: 'And Ion lets her know', tone: 'leaf' },
] as const;
---
<AppLayout title="Services" active="services"
  heading="Errands I-on could help with."
  lede="Coming later. None of this is ready yet.">
  <HeadArt slot="head-art" name="errands" />
  <LiveRegion />

  <Part id="planned" title="What is planned" icon="cart" tone="leaf">
    <ul role="list" class="cards" data-draw>
      {services.map((s, i) => (
        <li class="svc draw-pop" style={`--i:${i * 2}`}>
          <div class="svc-top">
            <ServiceArt name={s.id} />
            <Chip tone="info">Planned</Chip>
          </div>
          <h3>{s.title}</h3>
          <p class="svc-plan">{s.plan}</p>
          <p class="svc-today"><Icon name="users" size={16} /><span><b>Today:</b> {s.today}</span></p>
        </li>
      ))}
    </ul>
  </Part>

  <HowFlow steps={[...how]} label="How a service would work, in three steps" title="How it would work" tag="Planned"
    note="Nothing is ever booked or bought without a yes from the family. That stays true when services arrive." />

  <section class="now" id="now" aria-labelledby="now-title">
    <div class="now-text">
      <h2 id="now-title">Today, I-on writes the request.<span class="tone-2">The family does the rest.</span></h2>
      <p>Here is the one from this morning's call. You will find it in Tasks.</p>
      <Button href="/app/tasks/" variant="dark" size="sm" arrow>See it in Tasks</Button>
    </div>
    <figure class="ticket">
      <figcaption>{request.title}</figcaption>
      <div class="ticket-quote">
        <Avatar size="sm" tone="acc" initials={parent.initials} />
        <Bubble as="blockquote" tone="acc"><p>“{request.quote}”</p></Bubble>
      </div>
      <dl>
        {request.lines.map(([k, v, icon]) => <div><dt><Icon name={icon} size={16} />{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="ticket-foot"><Chip tone="waiting" dot><span data-ride-state>Waiting for a yes</span></Chip><AlsoOn links={also('services', 'now').filter((l) => l.place !== 'tasks')} /></p>
    </figure>
  </section>
  <ExampleNote />
</AppLayout>

<script>
  // The ride card follows what was done on the Tasks page in this browser.
  import { load } from '@/components/app/care/store';
  const st = load<Record<string, { status: string; who?: string }>>('tasks', {}).ride;
  const el = document.querySelector('[data-ride-state]');
  if (el && st && st.status !== 'needs-you') el.textContent = st.status === 'done' ? 'Marked done in Tasks' : `${st.who ?? 'Someone'} said yes`;
</script>

<style>
  .ticket-foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); }
  .now { scroll-margin-top: var(--s-6); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--s-4); }
  .svc { display: flex; flex-direction: column; gap: var(--s-2); padding: var(--s-5); border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); }
  .svc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-2); margin-bottom: var(--s-2); }
  .svc h3 { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.015em; line-height: 1.3; }
  .svc-plan { font-size: 0.9375rem; line-height: 1.5; }
  .svc-today { display: flex; align-items: flex-start; gap: var(--s-2); margin-top: auto; padding-top: var(--s-3); border-top: 1px dashed var(--line-strong); font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.5; }
  .svc-today :global(svg) { flex: none; margin-top: 0.1875rem; }
  .svc-today b { font-weight: 500; color: var(--ink); }

  .now { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--s-8); align-items: center; padding: var(--s-8); border-radius: var(--r-xl); background: var(--leaf-soft); }
  .now-text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-4); }
  .now h2 { font-size: var(--fs-h2); font-weight: 400; line-height: 1.1; letter-spacing: -0.03em; text-wrap: balance; }
  .now-text p { line-height: 1.5; max-width: 26rem; }
  .ticket { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5) var(--s-6); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-2); transform: rotate(0.6deg); }
  .ticket figcaption { font-weight: 500; }
  .ticket-quote { display: flex; align-items: flex-start; gap: var(--s-3); }
  .ticket-quote :global(.bub) p { font-size: 1.0625rem; }
  .ticket dl { display: flex; flex-direction: column; margin: 0; }
  .ticket dl div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--s-3); padding: var(--s-2) 0; border-top: 1px dashed var(--line-strong); }
  .ticket dt { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .ticket dd { margin: 0; font-size: 0.9375rem; }
  @media (max-width: 62rem) { .now { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 40rem) {
    .now { padding: var(--s-5); }
    .ticket { padding: var(--s-4); transform: none; }
    .ticket dl div { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }
</style>
