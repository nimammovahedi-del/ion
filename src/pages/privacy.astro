---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import Doodle from '@/components/site/Doodle.astro';
const KEEP = ['Your email address', 'Your answer to "Who are you looking out for?", if you choose one', 'Which page you joined from, and the day you joined'];
const NOT = ['No cookies', 'No trackers, no analytics scripts and no advertising', 'We do not store your IP address or details about your device with your email', 'We do not sell or share the list'];
---
<SiteLayout title="Privacy · I-on" description="What the I-on website collects today, in plain words." active="">
  <article class="priv wrap" aria-labelledby="priv-title">
    <header class="priv-head">
      <div class="priv-copy">
        <Eyebrow>Privacy</Eyebrow>
        <h1 id="priv-title" class="h1">What this site collects,<span class="tone-2">in plain words.</span></h1>
        <p class="lede">I-on is in development and is not calling anyone yet. This short page covers the website as it is today. A full privacy notice will come before any family starts.</p>
      </div>
      <div class="priv-pic" aria-hidden="true"><Doodle name="lock" size={168} /></div>
    </header>

    <div class="priv-grid">
      <section class="pcard pcard-keep" aria-labelledby="p1">
        <IconBadge name="check" tone="leaf" size="lg" />
        <h2 id="p1" class="h3">What we keep</h2>
        <p>Only what you give us on the waitlist form:</p>
        <ul role="list" class="ticks">{KEEP.map((k) => <li>{k}</li>)}</ul>
        <p>We use your address for one thing: to write once, when I-on is ready for families.</p>
      </section>

      <section class="pcard pcard-not" aria-labelledby="p2">
        <IconBadge name="shield" tone="acc" size="lg" />
        <h2 id="p2" class="h3">What we do not do</h2>
        <ul role="list" class="ticks ticks-no">{NOT.map((k) => <li>{k}</li>)}</ul>
      </section>

      <section class="pcard" aria-labelledby="p3">
        <IconBadge name="book" tone="butter" size="lg" />
        <h2 id="p3" class="h3">The example pages</h2>
        <p>The family app on this site shows Maggie Ellis and her family. They are invented. Every name, answer, chart and task in those pages is example data.</p>
      </section>

      <section class="pcard" aria-labelledby="p4">
        <IconBadge name="lock" tone="sky" size="lg" />
        <h2 id="p4" class="h3">Before any family starts</h2>
        <p>Real calls will hold personal information about your parent. Before the first family starts, we will publish a full privacy notice that explains what is kept from each call, where, for how long, who can see it, and how to have it deleted.</p>
      </section>

      <section class="pcard pcard-wide" aria-labelledby="p5">
        <IconBadge name="chat" tone="surface" size="lg" />
        <div class="stack" style="--gap: var(--s-2)">
          <h2 id="p5" class="h3">Being removed from the list</h2>
          <p>Reply to the email you receive from us and ask to be removed. We will delete your address. There is no other contact address yet; when there is one, it will be listed here.</p>
        </div>
      </section>
    </div>

    <div class="row">
      <Button href="/#waitlist" arrow>Join the waitlist</Button>
      <Button href="/" variant="secondary">Back to the home page</Button>
    </div>
  </article>
</SiteLayout>
<style>
  .priv { display: flex; flex-direction: column; gap: var(--s-8); padding-top: var(--s-12); }
  .priv-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s-10); background: var(--acc-soft); border-radius: var(--r-xl); padding: var(--s-12) var(--s-16); }
  .priv-copy { display: flex; flex-direction: column; gap: var(--s-4); max-width: 40rem; }
  .priv-pic { display: grid; place-items: center; width: 14rem; height: 14rem; border-radius: 50%; background: var(--surface); }
  .priv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  .pcard { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); padding: var(--s-8); border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .pcard p, .pcard li { line-height: 1.6; color: var(--ink-2); }
  .pcard-wide { grid-column: 1 / -1; flex-direction: row; align-items: center; gap: var(--s-5); background: var(--paper); border-color: var(--paper); }
  .ticks { display: flex; flex-direction: column; gap: var(--s-2); }
  .ticks li { display: flex; gap: var(--s-3); }
  .ticks li::before { content: ''; flex: none; width: 0.5rem; height: 0.5rem; margin-top: 0.55rem; border-radius: 50%; background: var(--leaf-text); }
  .ticks-no li::before { background: var(--acc-text); }
  @media (max-width: 48rem) {
    .priv { padding-top: var(--s-8); }
    .priv-head { grid-template-columns: minmax(0, 1fr); padding: var(--s-6); border-radius: var(--r-lg); gap: var(--s-6); }
    .priv-pic { order: -1; width: 7rem; height: 7rem; }
    .priv-pic :global(svg) { width: 4.5rem; }
    .priv-grid { grid-template-columns: minmax(0, 1fr); }
    .pcard { padding: var(--s-6); border-radius: var(--r-lg); }
    .pcard-wide { flex-direction: column; align-items: flex-start; }
  }
</style>
