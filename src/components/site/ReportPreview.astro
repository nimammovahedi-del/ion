---
/** A small card of today's report for the example family: a ring, a week of sleep as little bars, and the one line that changed. */
import Chip from '@/components/ui/Chip.astro';
import Ring from '@/components/ui/Ring.astro';
import { getReport, getToday, getParent, getMetric, lastDays } from '@/lib/loaders';
const [report, today, parent, sleep] = await Promise.all([getReport(), getToday(), getParent(), getMetric('sleep')]);
const week = lastDays(sleep, 7);
const last = week[week.length - 1].value;
const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(1));
const BAR_W = 9, GAP = 5, H = 56, TOP = 9;   // chart top: 9 hours
const W = week.length * BAR_W + (week.length - 1) * GAP;
const bars = week.map((n, i) => ({ x: i * (BAR_W + GAP), h: n.value === null ? 0 : (n.value / TOP) * H, low: n.value !== null && n.value < sleep.usual - 1 }));
---
<article class="rp" aria-label={`Example report for ${parent.short}`}>
  <div class="rp-top">
    <p class="rp-title">{parent.short}'s report</p>
    <Chip tone="info">Example</Chip>
  </div>
  <p class="rp-when">{today.short} · {today.callTime}</p>
  <div class="rp-tiles">
    <div class="rp-tile">
      <Ring value={report.feeling} max={10} size={56} thickness={12} label={`Feeling: ${report.feeling} out of 10. Her usual is ${report.feelingUsual}.`}>{report.feeling}</Ring>
      <p aria-hidden="true"><b>Feeling</b><span>usual {report.feelingUsual}</span></p>
    </div>
    <div class="rp-tile">
      <svg class="rp-bars" viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={`Sleep: ${last === null ? 'no answer' : `${fmt(last)} hours`} last night. Her usual is ${sleep.usualLabel}. The last four nights are shorter.`}>
        {bars.map((b, i) => <rect class:list={['draw-grow', { low: b.low }]} style={`--i:${i + 6}`} x={b.x} y={H - b.h} width={BAR_W} height={b.h} rx="4" />)}
      </svg>
      <p aria-hidden="true"><b>Sleep {last !== null && `${fmt(last)} h`}</b><span>usual {fmt(sleep.usual)}</span></p>
    </div>
  </div>
  <p class="rp-line"><span class="rp-dot" aria-hidden="true"></span>{report.changed}</p>
</article>
<style>
  .rp { display: flex; flex-direction: column; gap: var(--s-3); width: 100%; background: var(--surface); color: var(--ink); border-radius: var(--r-lg); padding: var(--s-5); box-shadow: var(--shadow-3); min-width: 0; }
  .rp-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .rp-title { font-size: var(--fs-lg); font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; }
  .rp-when { margin-top: calc(var(--s-3) * -1); font-size: var(--fs-sm); color: var(--ink-2); }
  .rp-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); }
  .rp-tile { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); background: var(--cream); border-radius: var(--r-md); padding: var(--s-3); min-width: 0; }
  .rp-tile p { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .rp-tile b { font-size: 0.9375rem; font-weight: 600; white-space: nowrap; }
  .rp-tile span { font-size: var(--fs-xs); color: var(--ink-2); }
  .rp-bars { flex: none; }
  /* sage for her usual nights, apricot for the shorter ones */
  .rp-bars rect { fill: var(--leaf); }
  .rp-bars rect.low { fill: var(--acc); }
  .rp-line { display: flex; gap: var(--s-2); font-size: var(--fs-sm); line-height: 1.5; }
  .rp-dot { flex: none; width: 0.5rem; height: 0.5rem; margin-top: 0.4rem; border-radius: 50%; background: var(--acc); }
</style>
