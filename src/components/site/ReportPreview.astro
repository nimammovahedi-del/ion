---
/** A small card of today's report for the example family, drawn through the loaders. */
import Chip from '@/components/ui/Chip.astro';
import { getReport, getHealthCards, getToday, getParent, getTasks, getMetric } from '@/lib/loaders';
const [report, cards, today, parent, tasks, sleepSeries] = await Promise.all([getReport(), getHealthCards(), getToday(), getParent(), getTasks(), getMetric('sleep')]);
const sleep = cards.find((c) => c.id === 'sleep');
const waiting = tasks.filter((t) => t.status === 'needs-you');
---
<article class="rp" aria-label={`Example report for ${parent.short}`}>
  <div class="rp-top">
    <span class="mono">{today.short} · {today.callTime}</span>
    <Chip tone="info">Example</Chip>
  </div>
  <p class="rp-title">{parent.short}'s report</p>
  <dl class="rp-tiles">
    <div class="rp-tile">
      <dt>Feeling</dt>
      <dd class="rp-num num">{report.feeling} / 10</dd>
      <dd class="rp-usual">usual {report.feelingUsual}</dd>
    </div>
    {sleep && (
      <div class="rp-tile">
        <dt>Sleep</dt>
        <dd class="rp-num num">{sleep.value} h</dd>
        <dd class="rp-usual flag">usual {sleepSeries.usual}, changed</dd>
      </div>
    )}
  </dl>
  <p class="rp-line">{report.changed}</p>
  <div class="rp-steps">
    <p class="rp-steps-head"><span class="rp-dot" aria-hidden="true"></span>{waiting.length} next steps for the family</p>
    <ul role="list">
      {waiting.map((t) => <li>{t.title}</li>)}
    </ul>
  </div>
</article>
<style>
  .rp { display: flex; flex-direction: column; gap: var(--s-4); width: 100%; background: var(--surface); color: var(--ink); border-radius: var(--r-lg); padding: var(--s-5); box-shadow: var(--shadow-3); min-width: 0; }
  .rp-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .rp-title { font-size: var(--fs-lg); font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; }
  .rp-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); margin: 0; }
  .rp-tile { display: flex; flex-direction: column; background: var(--paper); border-radius: var(--r-md); padding: var(--s-2) var(--s-3); min-width: 0; }
  .rp-tile dt { font-size: var(--fs-xs); color: var(--ink-2); }
  .rp-tile dd { margin: 0; }
  .rp-num { font-size: 1.375rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.02em; }
  .rp-usual { font-size: var(--fs-xs); color: var(--ink-2); }
  .rp-usual.flag { color: var(--acc-text); font-weight: 500; }
  .rp-line { font-size: var(--fs-sm); line-height: 1.55; border-top: 1px solid var(--line); padding-top: var(--s-3); }
  .rp-steps { display: flex; flex-direction: column; gap: var(--s-1); }
  .rp-steps-head { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); font-weight: 500; }
  .rp-dot { width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--acc-text); }
  .rp-steps ul { display: flex; flex-direction: column; gap: 0.125rem; padding-left: var(--s-4); font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.5; }
</style>
