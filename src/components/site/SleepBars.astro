---
/**
 * Sleep over the last 14 nights: one rounded bar per night, her usual as a dashed line.
 * Sage bars are nights close to her usual, apricot bars are the shorter nights (the same rule as everywhere else).
 * Built at build time from the example data. The bars grow when the chart comes into view; without JavaScript
 * or with reduced motion they are simply shown.
 */
import Chip from '@/components/ui/Chip.astro';
import { getMetric, lastDays, getParent } from '@/lib/loaders';
const [sleep, parent] = await Promise.all([getMetric('sleep'), getParent()]);
const nights = lastDays(sleep, 14);
const LOW_FROM = nights.length - 4;           // the last four nights are the change
const TOP = 9;                                 // hours at the top of the chart
const dayLetter = (iso: string) => 'SMTWTFS'[new Date(`${iso}T12:00:00Z`).getUTCDay()];
const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(1));
const bars = nights.map((n, i) => ({ ...n, h: n.value === null ? 0 : Math.min(1, n.value / TOP), low: i >= LOW_FROM, letter: dayLetter(n.date) }));
const last = nights[nights.length - 1];
const under = last.value !== null ? sleep.usual - last.value : 0;
const summary = `Bar chart of ${parent.short}'s sleep over the last 14 nights, one bar per night. Her usual is ${sleep.usualLabel}. ` +
  `The first ten nights are close to her usual. The last four nights are shorter: ${nights.slice(LOW_FROM).map((n) => n.value === null ? 'no answer' : `${fmt(n.value)}`).join(', ')} hours.`;
---
<figure class="sb">
  <figcaption class="sb-head">
    <span class="sb-title">{parent.short}'s sleep, last 14 nights</span>
    <Chip tone="info">Example data</Chip>
  </figcaption>
  <p class="sb-callout"><strong class="num">{last.value !== null ? fmt(last.value) : 'No answer'} hours last night.</strong> {under > 0 ? `${fmt(under)} hours under her usual, the fourth short night in a row.` : 'Close to her usual.'}</p>
  <div class="sb-plot" role="img" aria-label={summary} style={`--usual:${sleep.usual / TOP}`} data-reveal>
    {bars.map((b, i) => (
      <span class:list={['sb-col', { low: b.low }]}>
        {i === bars.length - 1 && b.value !== null && <span class="sb-val num">{fmt(b.value)}</span>}
        {b.value !== null && <span class="sb-bar draw-grow" style={`--h:${b.h.toFixed(3)};--i:${i}`}></span>}
        <span class="sb-day">{b.letter}</span>
      </span>
    ))}
    <span class="sb-usual"><span>Her usual, {sleep.usualLabel}</span></span>
  </div>
  <div class="sb-axis" aria-hidden="true"><span>{nights[0].label}</span><span>Today</span></div>
  <div class="sb-foot">
    <ul role="list" class="sb-keys">
      <li class="key"><span class="key-bar" aria-hidden="true"></span>Close to her usual</li>
      <li class="key"><span class="key-bar low" aria-hidden="true"></span>The last four nights, shorter</li>
    </ul>
    <details class="sb-table">
      <summary>See the numbers</summary>
      <div class="sb-scroll">
        <table>
          <caption class="sr-only">{parent.short}'s hours of sleep, last 14 nights</caption>
          <thead><tr><th scope="col">Night</th><th scope="col">Hours</th></tr></thead>
          <tbody>
            {nights.map((n) => <tr><th scope="row">{n.label}</th><td class="num">{n.value === null ? 'No answer' : fmt(n.value)}</td></tr>)}
          </tbody>
        </table>
      </div>
    </details>
  </div>
</figure>
<style>
  .sb { display: flex; flex-direction: column; gap: var(--s-3); min-width: 0; }
  .sb-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .sb-title { font-weight: 500; font-size: var(--fs-h3); letter-spacing: -0.02em; line-height: 1.3; }
  .sb-callout { line-height: 1.5; color: var(--ink-2); }
  .sb-callout strong { color: var(--ink); font-weight: 600; }

  .sb-plot { --plot-h: 11rem; --day-h: 1.75rem; position: relative; display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: var(--s-2); margin-top: var(--s-4); min-width: 0; }
  .sb-col { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: calc(var(--plot-h) + var(--day-h)); min-width: 0; }
  .sb-bar { width: 100%; max-width: 2rem; height: calc(var(--h) * var(--plot-h)); border-radius: var(--r-sm) var(--r-sm) 0.25rem 0.25rem; background: var(--leaf); }
  .low .sb-bar { background: var(--acc); }
  .sb-val { margin-bottom: var(--s-1); font-size: var(--fs-sm); font-weight: 600; line-height: 1; }
  .sb-day { font-size: var(--fs-xs); color: var(--ink-2); line-height: var(--day-h); }
  .sb-usual { position: absolute; left: 0; right: 0; bottom: calc(var(--day-h) + var(--usual) * var(--plot-h)); border-top: 2px dashed var(--ink); pointer-events: none; }
  .sb-usual span { position: absolute; right: 0; bottom: var(--s-2); padding: 0.125rem var(--s-2); border-radius: var(--r-sm); background: var(--surface); font-size: var(--fs-xs); font-weight: 500; line-height: 1.4; white-space: nowrap; }
  .sb-axis { display: flex; justify-content: space-between; font-size: var(--fs-sm); color: var(--ink-2); }

  .sb-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 var(--s-5); }
  .sb-keys { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: var(--fs-sm); color: var(--ink-2); }
  .key { display: inline-flex; align-items: center; gap: var(--s-2); }
  .key-bar { width: 0.625rem; height: 1rem; border-radius: 0.25rem; background: var(--leaf); }
  .key-bar.low { background: var(--acc); }
  .sb-table { flex: 1 1 100%; }
  .sb-table summary { display: inline-flex; align-items: center; min-height: var(--tap); cursor: pointer; font-size: var(--fs-sm); font-weight: 500; color: var(--acc-text); }
  .sb-scroll { overflow-x: auto; }
  table { border-collapse: collapse; font-size: var(--fs-sm); min-width: 12rem; }
  th, td { text-align: left; padding: var(--s-1) var(--s-6) var(--s-1) 0; border-bottom: 1px solid var(--line-strong); font-weight: 400; }
  thead th { font-weight: 600; }
  @media (max-width: 40rem) { .sb-plot { --plot-h: 8rem; gap: var(--s-1); } }

  /* The plot itself stays put; only the bars grow. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .sb-plot[data-reveal] { opacity: 1; transform: none; }
  }
</style>
