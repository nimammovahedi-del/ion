---
/** Built with care: the plain limit first, then three honest points, one line each. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import { CARE_FIRST, CARE_POINTS } from '@/data/site';
---
<section id="care" class="care wrap" aria-labelledby="care-title">
  <SectionHeading id="care-title" align="center" eyebrow="Built with care" title="Honest about what it is, and what it is not." />

  <div class="care-first" data-reveal>
    <span class="care-shield" aria-hidden="true"><Icon name="shield" size={30} /></span>
    <div class="care-first-words">
      <h3 class="care-first-title">{CARE_FIRST.title}</h3>
      <p>{CARE_FIRST.text}</p>
    </div>
    <p class="care-911">{CARE_FIRST.strong}</p>
  </div>

  <ul role="list" class="care-grid" data-reveal>
    {CARE_POINTS.map((c, i) => (
      <li class="care-item draw-pop" style={`--i:${i * 2}`}>
        <IconBadge name={c.icon} tone={c.tone} size="lg" />
        <div>
          <h3 class="care-title">{c.title}</h3>
          <p>{c.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
<style>
  .care { display: flex; flex-direction: column; gap: var(--s-4); padding-top: var(--s-24); }
  .care > :global(.sh) { margin-bottom: var(--s-6); }
  .care-first { display: flex; align-items: center; gap: var(--s-6); background: var(--deep); color: var(--on-deep); border-radius: var(--r-xl); padding: var(--s-6) var(--s-8); }
  .care-shield { flex: none; display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; background: var(--acc); color: var(--on-acc); }
  .care-first-words { flex: 1 1 20rem; display: flex; flex-direction: column; gap: var(--s-1); line-height: 1.5; min-width: 0; }
  .care-first-title { font-size: 1.625rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
  .care-911 { flex: none; padding: var(--s-3) var(--s-6); border-radius: var(--r-pill); background: var(--on-deep); color: var(--ink); font-size: var(--fs-lg); font-weight: 600; line-height: 1.3; }
  .care-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
  .care-item { display: flex; align-items: center; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--surface); font-size: 0.9375rem; line-height: 1.45; color: var(--ink-2); min-width: 0; }
  .care-title { font-size: 1.0625rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.3; color: var(--ink); }
  @media (max-width: 64rem) { .care-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 48rem) {
    .care-first { flex-wrap: wrap; padding: var(--s-6); border-radius: var(--r-lg); }
    .care-911 { flex: 1 1 100%; text-align: center; }
  }
  @media (max-width: 40rem) { .care { padding-top: var(--s-16); } }
</style>
