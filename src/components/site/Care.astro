---
/** Built with care: the honest limits and promises. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { CARE_POINTS } from '@/data/site';
---
<section id="care" class="care wrap" aria-labelledby="care-title">
  <SectionHeading id="care-title" align="center" eyebrow="Built with care" title="Honest about what it is, and what it is not." text="Your parent is the one on the phone. These are the rules that keep the call kind and the report truthful." />
  <ul role="list" class="care-grid">
    {CARE_POINTS.map((c, i) => (
      <li class:list={['care-item', { first: i === 0 }]} data-reveal>
        <span class="care-icon"><Icon name={c.icon} size={20} /></span>
        <h3 class="care-title">{c.title}</h3>
        <p>{c.text}</p>
      </li>
    ))}
  </ul>
</section>
<style>
  .care { display: flex; flex-direction: column; gap: var(--s-12); padding-top: var(--s-32); scroll-margin-top: var(--s-6); }
  .care-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: var(--s-4); }
  .care-item { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-6); border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--surface); line-height: 1.6; color: var(--ink-2); }
  .care-item.first { background: var(--deep); border-color: var(--deep); color: var(--on-deep); }
  .care-item.first .care-title { color: var(--on-deep); }
  .care-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--acc-soft); color: var(--acc-text); }
  .first .care-icon { background: var(--acc); color: var(--on-acc); }
  .care-title { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.3; color: var(--ink); }
  @media (max-width: 40rem) { .care { padding-top: var(--s-24); gap: var(--s-10); } }
</style>
