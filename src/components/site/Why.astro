---
/** Why it matters: four sourced figures, what is happening, and an honest before and after. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { FIGURES, WHY_TEXT, COMPARE, sourceLine } from '@/data/site';
---
<section id="why" class="why wrap" aria-labelledby="why-title">
  <SectionHeading id="why-title" align="center" eyebrow="Why it matters" title="More parents are growing older at home. Fewer of us live close enough to notice the small changes." />

  <ul role="list" class="figs">
    {FIGURES.map((f) => (
      <li class="fig" data-reveal>
        <p class="fig-value num">{f.value}</p>
        <p class="fig-label">{f.label}</p>
        {f.detail && <p class="fig-detail">{f.detail}</p>}
        <p class="fig-source">
          <span class="sr-only">Source: </span>
          <a href={f.source.href} rel="noopener" class="fig-link">{sourceLine(f.source)}</a>
        </p>
      </li>
    ))}
  </ul>

  <div class="why-text">
    {WHY_TEXT.map((p) => <p>{p}</p>)}
  </div>

  <div class="compare">
    <div class="cmp cmp-without" data-reveal>
      <p class="mono">{COMPARE.without.label}</p>
      <h3 class="h3">{COMPARE.without.title}</h3>
      <ul role="list" class="cmp-list">
        {COMPARE.without.points.map((p) => <li><span class="cmp-mark" aria-hidden="true"></span>{p}</li>)}
      </ul>
    </div>
    <div class="cmp cmp-with" data-reveal>
      <p class="mono">{COMPARE.with.label}</p>
      <h3 class="h3">{COMPARE.with.title}</h3>
      <ul role="list" class="cmp-list">
        {COMPARE.with.points.map((p) => <li><span class="cmp-mark" aria-hidden="true"></span>{p}</li>)}
      </ul>
    </div>
  </div>
</section>
<style>
  .why { display: flex; flex-direction: column; gap: var(--s-12); padding-top: var(--s-32); scroll-margin-top: var(--s-6); }
  .figs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--s-8); padding-inline: var(--s-2); }
  .fig { display: flex; flex-direction: column; gap: var(--s-2); border-top: 1px solid var(--ink); padding-top: var(--s-4); min-width: 0; }
  .fig-value { font-weight: 300; font-size: 3.5rem; line-height: 1.05; letter-spacing: -0.04em; color: var(--acc-text); }
  .fig-label { font-weight: 600; line-height: 1.45; }
  .fig-detail { font-size: var(--fs-sm); line-height: 1.55; color: var(--ink-2); }
  .fig-source { margin-top: auto; }
  .fig-link { display: inline-flex; align-items: center; min-height: var(--tap); font-family: var(--mono); font-size: var(--fs-xs); letter-spacing: 0.04em; line-height: 1.45; text-transform: uppercase; color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--line-strong); }
  .fig-link:hover { color: var(--acc-text); text-decoration-color: currentColor; }
  .why-text { display: flex; flex-direction: column; gap: var(--s-4); max-width: 44rem; margin-inline: auto; font-size: var(--fs-lg); line-height: 1.65; color: var(--ink-2); text-align: center; text-wrap: pretty; }
  .compare { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--s-4); }
  .cmp { display: flex; flex-direction: column; gap: var(--s-4); border-radius: var(--r-xl); padding: var(--s-8); min-width: 0; }
  .cmp-without { background: var(--grey-1); }
  .cmp-with { background: var(--deep); color: var(--on-deep); }
  .cmp-with .mono { color: var(--on-deep); }
  .cmp-list { display: flex; flex-direction: column; gap: var(--s-3); }
  .cmp-list li { display: flex; gap: var(--s-3); line-height: 1.5; }
  .cmp-without .cmp-list li { color: var(--ink-2); }
  .cmp-mark { flex: none; width: 0.5rem; height: 0.5rem; margin-top: 0.5rem; border-radius: 50%; border: 1.5px solid currentColor; }
  .cmp-with .cmp-mark { background: var(--acc); border-color: var(--acc); }
  @media (max-width: 40rem) {
    .why { padding-top: var(--s-24); gap: var(--s-10); }
    .cmp { padding: var(--s-6); border-radius: var(--r-lg); }
    .why-text { text-align: left; font-size: var(--fs-body); }
  }
</style>
