---
/** Questions, answered plainly, in native details elements. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { FAQS } from '@/data/site';
---
<section id="questions" class="qs wrap" aria-labelledby="qs-title">
  <div class="qs-grid">
    <SectionHeading id="qs-title" eyebrow="Questions" title="Fair questions," tone2="plain answers." text="If yours is not here, join the waitlist. We will write once, when there is more to tell." />
    <div class="qs-list">
      {FAQS.map((f) => (
        <details class="q">
          <summary><span>{f.q}</span><span class="q-mark" aria-hidden="true"></span></summary>
          <div class="q-a">{f.a.map((p) => <p>{p}</p>)}</div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .qs { padding-top: var(--s-32); scroll-margin-top: var(--s-6); }
  .qs-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: var(--s-12); align-items: start; }
  .qs-list { border-top: 1px solid var(--line); }
  .q { border-bottom: 1px solid var(--line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); min-height: 3.5rem; padding: var(--s-4) var(--s-2); cursor: pointer; list-style: none; font-size: 1.125rem; font-weight: 500; line-height: 1.4; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--acc-text); }
  .q-mark { position: relative; flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: var(--grey-1); }
  .q-mark::before, .q-mark::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 2px; margin: -1px 0 0 -0.375rem; background: var(--ink); border-radius: 2px; transition: transform 0.2s var(--ease); }
  .q-mark::after { transform: rotate(90deg); }
  .q[open] .q-mark { background: var(--acc); }
  .q[open] .q-mark::after { transform: rotate(0deg); }
  .q-a { display: flex; flex-direction: column; gap: var(--s-3); padding: 0 var(--s-12) var(--s-6) var(--s-2); color: var(--ink-2); line-height: 1.65; max-width: 44rem; }
  @media (max-width: 56rem) { .qs-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); } }
  @media (max-width: 40rem) { .qs { padding-top: var(--s-24); } .q-a { padding-right: var(--s-2); } summary { font-size: 1.0625rem; } }
</style>
