---
/** Questions, answered plainly, in native details elements. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Capybara from '@/components/ui/Capybara.astro';
import { FAQS } from '@/data/site';
---
<section id="questions" class="qs wrap" aria-labelledby="qs-title">
  <div class="qs-grid">
    <div class="qs-side">
      <SectionHeading id="qs-title" eyebrow="Questions" title="Fair questions," tone2="plain answers." />
      <div class="qs-card">
        <div class="qs-ion" aria-hidden="true">
          <Capybara size={168} ground="var(--surface)" label="" waves={false} />
          <span class="qs-mark">?</span>
        </div>
        <p class="qs-more"><b>Is yours not here?</b> <a href="#waitlist">Join the waitlist</a> and we will write once, when there is more to tell.</p>
      </div>
    </div>
    <div class="qs-list">
      {FAQS.map((f) => (
        <details class="q">
          <summary><span>{f.q}</span><span class="q-mark" aria-hidden="true"></span></summary>
          <div class="q-a">{f.a.map((p) => <p>{p}</p>)}</div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .qs { padding-top: var(--s-24); }
  .qs-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr); gap: var(--s-12); align-items: start; }
  .qs-side { position: sticky; top: 7.5rem; display: flex; flex-direction: column; gap: var(--s-6); }
  .qs-ion { position: relative; align-self: flex-start; }
  .qs-mark { position: absolute; top: 0; left: -0.5rem; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50% 50% 50% var(--r-sm); background: var(--acc); color: var(--on-acc); font-size: 1.5rem; font-weight: 600; box-shadow: var(--shadow-1); }
  /* the left column stays beside the list as it scrolls, and carries enough to sit level with it */
  .qs-card { display: flex; flex-direction: column; gap: var(--s-5); padding: var(--s-8); border-radius: var(--r-xl); background: var(--paper); }
  .qs-more { max-width: 22rem; line-height: 1.55; color: var(--ink-2); }
  .qs-more b { display: block; font-size: var(--fs-lg); font-weight: 500; color: var(--ink); }
  /* a comfortable tap area around the inline link, without moving the sentence */
  .qs-more a { display: inline-block; padding: var(--s-3) var(--s-1); margin: calc(var(--s-3) * -1) calc(var(--s-1) * -1); color: var(--acc-text); font-weight: 500; }
  .qs-list { display: flex; flex-direction: column; gap: var(--s-2); }
  .q { border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); transition: box-shadow 0.2s var(--ease); }
  .q[open] { box-shadow: var(--shadow-1); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); min-height: 3.5rem; padding: var(--s-2) var(--s-3) var(--s-2) var(--s-6); border-radius: var(--r-lg); cursor: pointer; list-style: none; font-size: 1.0625rem; font-weight: 500; line-height: 1.4; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--acc-text); }
  summary:focus-visible { border-radius: var(--r-lg); }
  .q-mark { position: relative; flex: none; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--grey-1); }
  .q-mark::before, .q-mark::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 2px; margin: -1px 0 0 -0.375rem; background: var(--ink); border-radius: 2px; transition: transform 0.2s var(--ease); }
  .q-mark::after { transform: rotate(90deg); }
  .q[open] .q-mark { background: var(--acc); }
  .q[open] .q-mark::after { transform: rotate(0deg); }
  .q-a { display: flex; flex-direction: column; gap: var(--s-3); padding: 0 var(--s-16) var(--s-6) var(--s-6); color: var(--ink-2); line-height: 1.6; max-width: 46rem; }
  @media (max-width: 56rem) {
    .qs-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); }
    .qs-ion { display: none; }
    .qs-card { padding: var(--s-5); border-radius: var(--r-lg); }
    .qs-side { position: static; }
  }
  @media (max-width: 40rem) { .qs { padding-top: var(--s-16); } .q-a { padding-right: var(--s-6); } summary { padding-left: var(--s-4); } .q-a { padding-left: var(--s-4); } }
</style>
