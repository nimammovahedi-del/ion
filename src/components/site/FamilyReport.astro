---
/**
 * A small picture of the family report for the example family: three rings, one steady line,
 * something she said, and the next steps waiting for a yes. Everything comes through the loaders.
 */
import Chip from '@/components/ui/Chip.astro';
import Ring from '@/components/ui/Ring.astro';
import Spark from '@/components/ui/Spark.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import { getReport, getToday, getParent, getTasks, getMetric, lastDays } from '@/lib/loaders';
const [report, today, parent, tasks, meals, pills, pain] = await Promise.all([getReport(), getToday(), getParent(), getTasks(), getMetric('meals'), getMetric('medicines'), getMetric('pain')]);
const waiting = tasks.filter((t) => t.status === 'needs-you');
const lastOf = (m: typeof meals) => lastDays(m, 1)[0].value ?? 0;
const rings = [
  { name: 'Feeling', value: report.feeling, max: 10, mid: String(report.feeling), tone: 'acc', say: `Feeling: ${report.feeling} out of 10. Her usual is ${report.feelingUsual}.`, sub: `usual ${report.feelingUsual}` },
  { name: 'Meals', value: lastOf(meals), max: meals.usual, mid: `${lastOf(meals)}/${meals.usual}`, tone: 'leaf', say: `Meals: ${lastOf(meals)} of ${meals.usual} yesterday.`, sub: 'as usual' },
  { name: 'Pill times', value: lastOf(pills), max: pills.usual, mid: `${lastOf(pills)}/${pills.usual}`, tone: 'butter', say: `Pill times taken: ${lastOf(pills)} of ${pills.usual} since yesterday's call.`, sub: 'worth a check' },
] as const;
const painDays = lastDays(pain, 14).map((p) => p.value);
const TONES = ['acc', 'leaf', 'butter'] as const;
---
<article class="fr" aria-label={`A picture of the family report, with example data for ${parent.short}`} data-reveal>
  <header class="fr-head">
    <p class="fr-when">{today.short} · after the {today.callTime} call</p>
    <Chip tone="info">Example data</Chip>
  </header>
  <p class="fr-headline">{report.headline}</p>

  <ul role="list" class="fr-rings">
    {rings.map((r) => (
      <li>
        <Ring value={r.value} max={r.max} size={76} thickness={11} tone={r.tone} label={r.say}>{r.mid}</Ring>
        <p aria-hidden="true"><b>{r.name}</b><span>{r.sub}</span></p>
      </li>
    ))}
  </ul>

  <div class="fr-line">
    <p><b>Knee, 14 days</b><span>steady, as usual</span></p>
    <Spark values={painDays} min={0} max={10} usual={pain.usual} tone="leaf" width={190} height={40} summary={`Line of her knee pain over 14 days. It stays close to her usual, ${pain.usualLabel}.`} />
  </div>

  <blockquote class="fr-quote">
    <p>"{report.quote}"</p>
    <footer>{parent.short}, about last night</footer>
  </blockquote>

  <div class="fr-steps">
    <p class="fr-steps-head">{waiting.length} next steps, waiting for a yes</p>
    <ul role="list">
      {waiting.map((t, i) => <li><IconBadge name={t.icon} tone={TONES[i % 3]} size="sm" /><span>{t.title}</span></li>)}
    </ul>
  </div>
</article>
<style>
  .fr { display: flex; flex-direction: column; gap: var(--s-5); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: var(--s-8); box-shadow: var(--shadow-2); min-width: 0; }
  .fr-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .fr-when { font-size: var(--fs-sm); color: var(--ink-2); }
  .fr-headline { font-size: 1.5rem; font-weight: 400; line-height: 1.2; letter-spacing: -0.025em; text-wrap: balance; }
  .fr-rings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-2); }
  .fr-rings li { display: flex; flex-direction: column; align-items: center; gap: var(--s-2); padding: var(--s-4) var(--s-2); border-radius: var(--r-lg); background: var(--cream); text-align: center; }
  .fr-rings p, .fr-line p { display: flex; flex-direction: column; line-height: 1.3; }
  .fr b { font-weight: 500; font-size: 0.9375rem; }
  .fr-rings span, .fr-line p span { font-size: var(--fs-sm); color: var(--ink-2); }
  .fr-rings :global(.ring-mid) { font-size: 1.125rem; color: var(--ink); }
  .fr-line { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: var(--s-3) var(--s-5); border-radius: var(--r-lg); background: var(--cream); }
  .fr-quote { margin: 0; padding: var(--s-4) var(--s-5); border-radius: var(--r-lg) var(--r-lg) var(--r-lg) var(--r-sm); background: var(--butter-soft); }
  .fr-quote p { font-size: var(--fs-lg); line-height: 1.35; letter-spacing: -0.01em; }
  .fr-quote footer { font-size: var(--fs-sm); color: var(--ink-2); }
  .fr-steps { display: flex; flex-direction: column; gap: var(--s-2); }
  .fr-steps-head { font-size: 0.9375rem; font-weight: 500; }
  .fr-steps ul { display: flex; flex-direction: column; gap: var(--s-2); }
  .fr-steps li { display: flex; align-items: center; gap: var(--s-3); font-size: 0.9375rem; line-height: 1.3; }
  @media (max-width: 40rem) {
    .fr { padding: var(--s-5) var(--s-4); border-radius: var(--r-lg); }
    .fr-line { flex-direction: column; align-items: flex-start; }
  }
</style>
