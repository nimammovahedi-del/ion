---
/** An ordinary telephone ringing on a kitchen table, with a small mobile and a cup of tea, under a window with a plant. Flat shapes, token colours. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const holes = Array.from({ length: 8 }, (_, i) => ({ x: 214 + 15.5 * Math.cos((i * Math.PI) / 4), y: 207 + 15.5 * Math.sin((i * Math.PI) / 4) }));
---
<svg class:list={['pt', cls]} viewBox="0 0 420 330" role="img" aria-label="An ordinary telephone ringing on a kitchen table, beside a small mobile phone and a cup of tea. A plant sits in the window.">
  <circle cx="210" cy="168" r="150" fill="var(--surface)" fill-opacity="0.6" />
  <!-- a window with a plant on the sill -->
  <rect x="288" y="22" width="92" height="74" rx="10" fill="var(--sky-soft)" stroke="var(--fur-dark)" stroke-width="5" />
  <path d="M334 24v70M290 56h88" fill="none" stroke="var(--fur-dark)" stroke-width="4" />
  <g fill="var(--leaf)">
    <path d="M352 80q-14-6-12-22 12 4 12 22z" /><path d="M352 80q14-6 12-22-12 4-12 22z" /><path d="M352 82q-5-18 0-30 5 12 0 30z" fill="var(--leaf-text)" />
  </g>
  <path d="M342 80h20l-3 15h-14z" fill="var(--acc)" />
  <rect x="280" y="94" width="108" height="9" rx="4.5" fill="var(--fur-dark)" />
  <!-- the table, standing on a rug -->
  <ellipse cx="210" cy="318" rx="176" ry="9" fill="var(--surface)" />
  <rect x="56" y="250" width="14" height="68" rx="5" fill="var(--fur-dark)" /><rect x="350" y="250" width="14" height="68" rx="5" fill="var(--fur-dark)" />
  <rect x="12" y="238" width="396" height="16" rx="8" fill="var(--fur)" />
  <ellipse cx="214" cy="239" rx="118" ry="6" fill="var(--surface)" />
  <!-- the telephone -->
  <g class="pt-waves" fill="none" stroke="var(--acc-text)" stroke-width="5" stroke-linecap="round">
    <path d="M108 130q-12 20 0 40" /><path d="M320 130q12 20 0 40" />
    <path d="M94 120q-18 30 0 60" /><path d="M334 120q18 30 0 60" />
  </g>
  <path d="M136 178q-16 8-6 20 10 10-4 20-12 10 6 18" fill="none" stroke="var(--deep)" stroke-width="4" stroke-linecap="round" />
  <rect x="184" y="162" width="12" height="14" rx="3" fill="var(--leaf-text)" /><rect x="232" y="162" width="12" height="14" rx="3" fill="var(--leaf-text)" />
  <path d="M158 172h112q12 0 15 12l11 44q2 10-8 10H140q-10 0-8-10l11-44q3-12 15-12z" fill="var(--leaf)" />
  <circle cx="214" cy="207" r="24" fill="var(--surface)" />
  {holes.map((h) => <circle cx={h.x.toFixed(1)} cy={h.y.toFixed(1)} r="3.6" fill="var(--leaf)" />)}
  <circle cx="214" cy="207" r="5" fill="var(--acc)" />
  <path class="pt-handset" d="M126 160q0-22 22-22h132q22 0 22 22v10q0 10-10 10h-20q-10 0-10-10v-8h-96v8q0 10-10 10h-20q-10 0-10-10z" fill="var(--deep)" />
  <!-- a small mobile -->
  <g transform="rotate(-6 60 212)">
    <rect x="44" y="184" width="32" height="54" rx="7" fill="var(--deep)" />
    <rect x="48" y="189" width="24" height="18" rx="3" fill="var(--sky)" />
    {[215, 222, 229].map((y) => [53, 60, 67].map((x) => <circle cx={x} cy={y} r="2" fill="var(--surface)" />))}
  </g>
  <!-- a cup of tea -->
  <g fill="none" stroke="var(--line-strong)" stroke-width="3" stroke-linecap="round" class="pt-steam">
    <path d="M356 186q-6-8 0-15t0-15" /><path d="M370 186q-6-8 0-15t0-15" />
  </g>
  <path d="M384 208q14 0 14 10t-14 10" fill="none" stroke="var(--butter)" stroke-width="7" stroke-linecap="round" />
  <rect x="342" y="196" width="44" height="42" rx="9" fill="var(--butter)" />
</svg>
<style>
  .pt { display: block; width: 100%; height: auto; overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .pt-waves path { animation: pt-wave 3.2s ease-in-out infinite; }
    .pt-waves path:nth-child(n + 3) { animation-delay: 0.25s; }
    .pt-handset { transform-origin: 214px 180px; animation: pt-shake 3.2s ease-in-out infinite; }
  }
  @keyframes pt-wave { 0%, 45%, 100% { opacity: 0.2; } 12%, 30% { opacity: 1; } }
  @keyframes pt-shake { 0%, 40%, 100% { transform: rotate(0); } 6%, 18%, 30% { transform: rotate(-2deg); } 12%, 24%, 36% { transform: rotate(2deg); } }
</style>
