---
/**
 * Sleep over the last 14 nights as a dot matrix: one column per night, one row of dots per half hour.
 * Drawn at build time. The dots fill in from the bottom when the chart comes into view (BaseLayout's
 * [data-reveal] observer adds .is-in). Without JavaScript or with reduced motion every dot is simply shown.
 */
import { getMetric, lastDays, getParent } from '@/lib/loaders';
const [sleep, parent] = await Promise.all([getMetric('sleep'), getParent()]);
const nights = lastDays(sleep, 14);
const LOW_FROM = nights.length - 4;           // the last four nights are the change
const STEP = 0.5;                              // hours per row of dots
const ROWS = Math.ceil(9 / STEP);              // chart top: 9 hours
const COL_W = 30, GAP = 10, ROW_H = 10, PAD_T = 10;   // keep these multiples of 10 so the dot pattern lines up
const W = nights.length * COL_W + (nights.length - 1) * GAP;
const H = PAD_T + ROWS * ROW_H;
const yOf = (hours: number) => H - (hours / STEP) * ROW_H;
const cols = nights.map((n, i) => {
  const rows = n.value === null ? 0 : Math.round(n.value / STEP);
  return { ...n, x: i * (COL_W + GAP), rows, low: i >= LOW_FROM };
});
const last = nights[nights.length - 1];
const under = last.value !== null ? sleep.usual - last.value : 0;
const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(1));
const summary = `Dot chart of ${parent.short}'s sleep over the last 14 nights. Her usual is ${sleep.usualLabel}. ` +
  `The first ten nights are close to her usual. The last four nights are lower: ${nights.slice(LOW_FROM).map((n) => n.value === null ? 'no answer' : `${fmt(n.value)}`).join(', ')} hours.`;
const uid = `sd-${Math.random().toString(36).slice(2, 7)}`;
---
<figure class="sd">
  <div class="sd-chart">
    <div class="sd-plot" data-reveal>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary} preserveAspectRatio="xMidYMid meet">
        <defs>
          <pattern id={`${uid}-a`} width="10" height={ROW_H} patternUnits="userSpaceOnUse"><circle cx="5" cy="5" r="3.2" class="dot-usual" /></pattern>
          <pattern id={`${uid}-b`} width="10" height={ROW_H} patternUnits="userSpaceOnUse"><circle cx="5" cy="5" r="3.2" class="dot-low" /></pattern>
        </defs>
        {cols.map((c, ci) => (
          <g>
            {Array.from({ length: c.rows }, (_, r) => (
              <rect class="sd-row" x={c.x} y={H - (r + 1) * ROW_H} width={COL_W} height={ROW_H} fill={`url(#${uid}-${c.low ? 'b' : 'a'})`} style={`--d:${ci * 45 + r * 22}ms`} />
            ))}
          </g>
        ))}
        <line class="sd-usual" x1="0" x2={W} y1={yOf(sleep.usual)} y2={yOf(sleep.usual)} />
      </svg>
    </div>
    <div class="sd-axis" aria-hidden="true"><span>{nights[0].label}</span><span>Today</span></div>
  </div>
  <figcaption class="sd-info">
    <span class="sd-head">
      <span class="sd-title"><span class="sd-key-dot" aria-hidden="true"></span>{parent.short}'s sleep, last 14 nights</span>
      <span class="mono">Example data</span>
    </span>
    <span class="sd-callout"><strong class="num">{last.value !== null ? fmt(last.value) : 'No answer'} hours last night.</strong> {under > 0 ? `${fmt(under)} hours under her usual, the fourth short night in a row.` : 'Close to her usual.'}</span>
    <span class="sd-keys">
      <span class="key"><span class="key-dash" aria-hidden="true"></span>Her usual, {sleep.usualLabel}</span>
      <span class="key"><span class="key-dot" aria-hidden="true"></span>Each row of dots is half an hour of sleep</span>
      <span class="key"><span class="key-dot low" aria-hidden="true"></span>The last four nights, lower than usual</span>
    </span>
    <details class="sd-table">
      <summary>See the numbers</summary>
      <div class="sd-scroll">
        <table>
          <caption class="sr-only">{parent.short}'s hours of sleep, last 14 nights</caption>
          <thead><tr><th scope="col">Night</th><th scope="col">Hours</th></tr></thead>
          <tbody>
            {nights.map((n) => <tr><th scope="row">{n.label}</th><td class="num">{n.value === null ? 'No answer' : fmt(n.value)}</td></tr>)}
          </tbody>
        </table>
      </div>
    </details>
  </figcaption>
</figure>
<style>
  .sd { display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: var(--s-6) var(--s-12); align-items: end; min-width: 0; }
  .sd-chart { order: 2; display: flex; flex-direction: column; gap: var(--s-2); min-width: 0; }
  .sd-info { order: 1; display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  @media (max-width: 60rem) {
    .sd { grid-template-columns: minmax(0, 1fr); }
  }
  .sd-head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-1); }
  .sd-title { display: inline-flex; line-height: 1.35; align-items: center; gap: var(--s-2); font-weight: 500; font-size: var(--fs-lg); }
  .sd-key-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--deep); }
  .sd-callout { display: block; line-height: 1.55; font-size: var(--fs-body); color: var(--ink-2); }
  .sd-callout strong { color: var(--ink); font-weight: 600; }
  .sd-plot svg { width: 100%; height: auto; overflow: visible; }
  .dot-usual { fill: var(--acc); }
  .dot-low { fill: var(--deep); }
  .sd-usual { stroke: var(--ink); stroke-width: 1.5; stroke-dasharray: 5 5; }
  .sd-axis { display: flex; justify-content: space-between; font-size: var(--fs-sm); color: var(--ink-2); }
  .sd-keys { display: flex; flex-direction: column; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  .key { display: inline-flex; align-items: center; gap: var(--s-2); }
  .key-dash { width: 1.25rem; border-top: 2px dashed var(--ink); }
  .key-dot { width: 0.625rem; height: 0.625rem; border-radius: 50%; background: var(--acc); }
  .key-dot.low { background: var(--deep); }
  .sd-table summary { display: inline-flex; align-items: center; min-height: var(--tap); cursor: pointer; font-size: var(--fs-sm); font-weight: 500; color: var(--acc-text); }
  .sd-scroll { overflow-x: auto; }
  table { border-collapse: collapse; font-size: var(--fs-sm); min-width: 12rem; }
  th, td { text-align: left; padding: var(--s-1) var(--s-6) var(--s-1) 0; border-bottom: 1px solid var(--line); font-weight: 400; }
  thead th { font-weight: 600; }

  /* Fill in from the bottom, night by night. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .sd-plot[data-reveal] { opacity: 1; transform: none; }
    :global(.js) .sd-plot .sd-row { opacity: 0; transition: opacity 0.35s var(--ease); transition-delay: var(--d, 0ms); }
    :global(.js) .sd-plot.is-in .sd-row { opacity: 1; }
  }
</style>
