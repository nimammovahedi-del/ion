---
/** What you see: her sleep as one bar per night, beside the longer view (30-day trends and the one-page doctor sheet). Example family throughout. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import Button from '@/components/ui/Button.astro';
import SleepBars from './SleepBars.astro';
import FamilyReport from './FamilyReport.astro';
import { getParent } from '@/lib/loaders';
const parent = await getParent();
const MORE = [
  { icon: 'users', tone: 'acc', title: 'Two answers?', text: 'You see both.' },
  { icon: 'trends', tone: 'leaf', title: 'Trends', text: 'over 14, 30 and 90 days.' },
] as const;
---
<section id="see" class="see wrap" aria-labelledby="see-title">
  <div class="see-grid">
    <div class="see-left">
      <SectionHeading id="see-title" eyebrow="What you see" title="Change against her own usual," tone2="at a glance." text={`Here is ${parent.short}, our invented example. Each answer sits beside what is normal for her, not for anyone else.`} />
      <div class="see-chart"><SleepBars /></div>
    </div>
    <FamilyReport />
  </div>

  <div class="see-more">
    <ul role="list" class="more">
      {MORE.map((m) => (
        <li><IconBadge name={m.icon} tone={m.tone} round /><span><b>{m.title}</b> {m.text}</span></li>
      ))}
    </ul>
    <Button href="/app/" variant="dark" size="lg" arrow>See the example app</Button>
  </div>
</section>
<style>
  .see { display: flex; flex-direction: column; gap: var(--s-6); padding-top: var(--s-24); }
  .see-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--s-6); align-items: stretch; }
  .see-left { display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-8); min-width: 0; }
  .see-chart { background: var(--paper); border-radius: var(--r-xl); padding: var(--s-8); min-width: 0; }
  .see-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4) var(--s-8); padding: var(--s-3) var(--s-3) var(--s-3) var(--s-6); border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); }
  .more { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-10); }
  .more li { display: flex; align-items: center; gap: var(--s-3); line-height: 1.35; color: var(--ink-2); }
  .more b { font-weight: 500; color: var(--ink); }
  @media (max-width: 64rem) { .see-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 40rem) {
    .see { padding-top: var(--s-16); }
    .see-chart { padding: var(--s-5) var(--s-4); border-radius: var(--r-lg); }
    .see-more { padding: var(--s-4); border-radius: var(--r-lg); }
  }
</style>
