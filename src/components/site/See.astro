---
/** What you see: the pieces of the family app, drawn from the example family. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import HealthCard from '@/components/ui/HealthCard.astro';
import Card from '@/components/ui/Card.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import SleepDots from './SleepDots.astro';
import { getHealthCards, getParent } from '@/lib/loaders';
const [cards, parent] = await Promise.all([getHealthCards(), getParent()]);
const pick = ['sleep', 'medicines', 'feeling'];
const shown = pick.map((id) => cards.find((c) => c.id === id)).filter((c) => c !== undefined);
---
<section id="see" class="see wrap" aria-labelledby="see-title">
  <SectionHeading id="see-title" eyebrow="What you see" title="Change against her own usual," tone2="at a glance." text={`Here is ${parent.short}, our invented example. Each answer is set beside what is normal for her, not for anyone else, and shows where it came from.`} />

  <div class="see-chart" data-reveal>
    <SleepDots />
  </div>

  <div class="see-cards">
    {shown.map((c) => <HealthCard card={c} compact />)}
  </div>

  <div class="see-more">
    <Card tone="soft" pad="lg" class="more">
      <span class="more-icon"><Icon name="users" size={20} /></span>
      <h3 class="more-title">Two answers</h3>
      <p>Sometimes she says one thing on Monday and another on Tuesday. I-on does not pick one for you. It shows both, with where each came from, so you can ask her.</p>
    </Card>
    <Card tone="paper" pad="lg" class="more">
      <span class="more-icon"><Icon name="trends" size={20} /></span>
      <h3 class="more-title">Trends over 14, 30 and 90 days</h3>
      <p>See sleep, meals, pain and the rest over two weeks, a month or three months, always beside her usual.</p>
    </Card>
    <Card tone="paper" pad="lg" class="more">
      <span class="more-icon"><Icon name="print" size={20} /></span>
      <h3 class="more-title">A page for the doctor</h3>
      <p>Print a plain one-page summary to take to an appointment, so nobody has to remember it all on the day.</p>
    </Card>
  </div>

  <div class="see-cta">
    <p class="muted">Every screen of the family app is open to look around, with {parent.short}'s invented data.</p>
    <Button href="/app/" variant="dark" arrow>See the example app</Button>
  </div>
</section>
<style>
  .see { display: flex; flex-direction: column; gap: var(--s-8); padding-top: var(--s-32); scroll-margin-top: var(--s-6); }
  .see-chart { background: var(--paper); border-radius: var(--r-xl); padding: var(--s-8); min-width: 0; }
  .see-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: var(--s-4); align-items: start; }
  .see-more { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: var(--s-4); }
  .see-more :global(.more) { display: flex; flex-direction: column; gap: var(--s-3); }
  .more-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--surface); color: var(--acc-text); }
  .more-title { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.3; }
  .see-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4); border-top: 1px solid var(--line); padding-top: var(--s-6); }
  @media (max-width: 40rem) {
    .see { padding-top: var(--s-24); }
    .see-chart { padding: var(--s-5); border-radius: var(--r-lg); }
  }
</style>
