---
/**
 * A measure in miniature for an overview card or a compact row: a small line against her usual, rows of marked days,
 * or, for falls, one calm mark and a few words (a row of empty boxes would be a picture of nothing).
 * The line is sage when the measure is as usual and apricot when it is different from her usual.
 */
import type { MetricSeries } from '@/data/types';
import Icon from '@/components/ui/Icon.astro';
import Spark from '@/components/ui/Spark.astro';
import DayStrip from './DayStrip.astro';
import { lastDays } from '@/lib/loaders';
import { CHART, chartTone, dayRows, summarise } from './measure';
interface Props { m: MetricSeries; days: number; width?: number; height?: number }
const { m, days, width = 200, height = 52 } = Astro.props;
const pts = lastDays(m, days);
const s = summarise(m, pts);
const summary = `${m.title}, last ${days} days. ${s.label}: ${s.value}${s.unit ? ` ${s.unit}` : ''}. Her usual is ${m.usualLabel}.`;
const kind = CHART[m.id];
const strip = kind === 'days' ? dayRows(m, pts) : null;
const falls = kind === 'calm' ? pts.filter((p) => (p.value ?? 0) > 0) : [];
---
{kind === 'calm' ? (
  falls.length === 0
    ? <span class="calm"><span class="calm-mark" aria-hidden="true"><Icon name="check" size={14} /></span>None in {days} days</span>
    : <span class="calm"><span class="calm-mark flag" aria-hidden="true"></span>{falls.length === 1 ? `One, on ${falls[0].label}` : `${falls.length} in ${days} days`}</span>
) : strip
  ? <DayStrip mini points={pts} rows={strip.rows} keys={strip.keys} summary={summary} />
  : <Spark values={pts.map((p) => p.value)} usual={m.usual} min={m.id === 'meals' ? 0 : Math.max(m.min, m.usual - 3.5)} max={m.id === 'meals' ? 4 : Math.min(m.max, m.usual + 3.5)} summary={summary} width={width} height={height} tone={chartTone(m.status)} />}
<style>
  .calm { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); font-weight: 500; white-space: nowrap; }
  .calm-mark { flex: none; display: grid; place-items: center; width: 2rem; height: 1.375rem; border-radius: var(--r-pill); background: var(--leaf); color: var(--ink); }
  .calm-mark.flag { width: 1.375rem; border-radius: 0.3125rem; background: var(--acc); }
  .calm-mark.flag::after { content: ''; width: 0.4375rem; height: 0.4375rem; background: var(--ink); transform: rotate(45deg); }
</style>
