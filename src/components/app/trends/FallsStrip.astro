---
/**
 * Yes-or-no measures read better as marked days than as a line: one small block per day.
 * kind="falls": a fall is a filled block with a diamond. kind="out": a day out is a filled block, a day in is pale.
 * A day with no answer is an empty dashed block.
 */
import type { DayPoint } from '@/data/types';
import { dayLabel } from './measure';
interface Props { points: DayPoint[]; summary: string; kind?: 'falls' | 'out' }
const { points, summary, kind = 'falls' } = Astro.props;
const marked = (p: DayPoint) => (p.value ?? 0) > 0;
const falls = kind === 'falls' ? points.filter(marked) : [];
const first = points[0], last = points[points.length - 1];
const word = (p: DayPoint) => p.value === null ? 'no answer' : kind === 'falls' ? (p.value ? 'a fall' : 'no fall') : (p.value ? (p.value > 1 ? 'out twice' : 'went out') : 'stayed in');
const KEY = kind === 'falls'
  ? { off: 'No fall', on: 'A fall she told us about' }
  : { off: 'Stayed in', on: 'Went out' };
---
<figure class:list={['strip-fig', `k-${kind}`]}>
  <div class:list={['strip', { dense: points.length > 40 }]} role="img" aria-label={summary}>
    {points.map((p) => (
      <span class:list={['d', { on: marked(p), none: p.value === null }]} title={`${p.label}: ${word(p)}`}></span>
    ))}
  </div>
  <div class="ends" aria-hidden="true"><span>{first?.label}</span><span>{last?.label}</span></div>
  <figcaption>
    <span class="key"><span class="d" aria-hidden="true"></span>{KEY.off}</span>
    <span class="key"><span class="d on" aria-hidden="true"></span>{KEY.on}</span>
    <span class="key"><span class="d none" aria-hidden="true"></span>No answer</span>
  </figcaption>
  {falls.length > 0 && (
    <ul role="list" class="list">
      {falls.map((p) => <li><b>{dayLabel(p.date, { weekday: 'long', month: 'long', day: 'numeric' })}</b>: she told Ion about {p.value === 1 ? 'a fall' : `${p.value} falls`}.</li>)}
    </ul>
  )}
</figure>
<style>
  .strip-fig { display: flex; flex-direction: column; gap: var(--s-2); min-width: 0; }
  .strip { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 0.1875rem; padding: var(--s-3); border-radius: var(--r-md); background: var(--paper); }
  .strip .d { width: auto; height: 2.5rem; }
  .strip.dense { gap: 1px; }
  .d { display: inline-grid; place-items: center; width: 0.875rem; height: 1rem; border-radius: 0.2rem; background: var(--grey-2); }
  .d.on { background: var(--acc-text); }
  .k-falls .d.on::after { content: ''; width: 0.35rem; height: 0.35rem; background: var(--surface); transform: rotate(45deg); }
  .k-out .d:not(.on):not(.none) { background: var(--grey-1); border: 1px solid var(--line-strong); }
  .d.none { background: transparent; border: 2px dashed var(--line-strong); }
  .ends { display: flex; justify-content: space-between; font-size: var(--fs-xs); color: var(--ink-2); }
  figcaption { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: var(--fs-sm); color: var(--ink-2); }
  .key { display: inline-flex; align-items: center; gap: var(--s-2); }
  .list { font-size: 0.9375rem; }
</style>
