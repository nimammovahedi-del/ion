---
/**
 * One measure on the Trends page. The range blocks (14, 30, 90 days) are all rendered;
 * the page shows one at a time with radio inputs and CSS.
 */
import type { HerWords, MetricSeries } from '@/data/types';
import Chip from '@/components/ui/Chip.astro';
import Icon from '@/components/ui/Icon.astro';
import LineChart from '@/components/ui/LineChart.astro';
import StatTile from '@/components/ui/StatTile.astro';
import FallsStrip from './FallsStrip.astro';
import { lastDays } from '@/lib/loaders';
import { ABOUT, STEPPED, TICKS, dayLabel, summarise, valueWords, short, usualShort } from './measure';
interface Props { m: MetricSeries; words: HerWords[]; ranges: readonly number[] }
const { m, words, ranges } = Astro.props;
const statusLabel = { changed: 'Changed', check: 'Check', usual: 'As usual' }[m.status];
const blocks = ranges.map((n) => {
  const pts = lastDays(m, n);
  const s = summarise(m, pts);
  const chartSummary = `${m.title}, last ${n} days. ${s.label}: ${s.value}${s.unit ? ` ${s.unit}` : ''}. Her usual is ${m.usualLabel}. ${s.diff} ${s.noAnswer ? `${s.noAnswer} days with no answer.` : 'An answer on every day.'}`;
  return { n, pts, s, chartSummary };
});
const week = summarise(m, lastDays(m, 7));
const usual = usualShort(m);
const STRIP = { falls: 'falls', out: 'out' } as const;
const stripKind = m.id === 'falls' || m.id === 'out' ? STRIP[m.id] : null;
const table = lastDays(m, 14).slice().reverse();
---
<section class="measure" id={m.id} aria-labelledby={`${m.id}-h`}>
  <header class="m-head">
    <span class="m-icon" aria-hidden="true"><Icon name={m.icon} size={20} /></span>
    <h2 id={`${m.id}-h`} class="h3">{m.title}</h2>
    <Chip tone={m.status}>{statusLabel}</Chip>
  </header>
  <p class="m-note">{m.note}</p>

  {blocks.map((b) => (
    <div class="m-range" data-range={b.n}>
      <div class="tiles">
        <StatTile label={b.s.label.startsWith("Average") ? `Average, last ${b.n} days` : `Last ${b.n} days`} value={b.s.value} unit={b.s.unit} caption={b.s.diff} flag={b.s.flag} tone={b.s.flag ? 'soft' : 'plain'} />
        <StatTile label={week.label.startsWith("Average") ? "Average, last 7 days" : "Last 7 days"} value={week.value} unit={week.unit} caption={week.diff} flag={week.flag} tone={week.flag ? 'soft' : 'plain'} />
        <StatTile label="Her usual" value={usual.value} caption={usual.caption} />
        <StatTile label="No answer" value={String(b.s.noAnswer)} unit={b.s.noAnswer === 1 ? 'day' : 'days'} caption={`of ${b.n}`} />
      </div>
      {stripKind ? (
        <FallsStrip points={b.pts} summary={b.chartSummary} kind={stripKind} />
      ) : (
        <LineChart points={b.pts} min={m.min} max={m.max} usual={m.usual} usualLabel={m.usualLabel} unit={`${m.title}, ${m.unit}`} summary={b.chartSummary} ticks={TICKS[m.id]} stepped={STEPPED.includes(m.id)} height={200} />
      )}
    </div>
  ))}

  {words.length > 0 && (
    <ul role="list" class="m-words" aria-label={`What she said about ${m.title.toLowerCase()}`}>
      {words.map((w) => (
        <li><blockquote>&ldquo;{w.text}&rdquo;</blockquote><span>She said, on the {w.day} call</span></li>
      ))}
    </ul>
  )}

  <p class="m-about"><b>What this is.</b> {ABOUT[m.id]} It comes from what she said on the call, not from a measurement.</p>

  <details class="m-table">
    <summary>Last 14 days as numbers</summary>
    <div class="t-scroll">
      <table>
        <caption class="sr-only">{m.title}, her answer on each of the last 14 days, newest first</caption>
        <thead><tr><th scope="col">Day</th><th scope="col">Her answer</th><th scope="col">Number</th></tr></thead>
        <tbody>
          {table.map((p) => (
            <tr class:list={{ none: p.value === null }}>
              <th scope="row">{dayLabel(p.date, { weekday: 'short', month: 'short', day: 'numeric' })}</th>
              <td>{valueWords(m.id, p.value)}</td>
              <td class="num">{short(p.value)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</section>
<style>
  .measure { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-6); border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); min-width: 0; scroll-margin-top: var(--s-6); }
  .m-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .m-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--acc-soft); color: var(--acc-text); }
  .m-head h2 { margin-right: auto; }
  .m-note { font-size: var(--fs-lg); line-height: 1.5; max-width: 44rem; }
  .m-range { display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.25rem), 1fr)); gap: var(--s-3); }
  .m-words { display: flex; flex-direction: column; gap: var(--s-2); }
  .m-words li { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-1) var(--s-3); padding-left: var(--s-4); border-left: 3px solid var(--acc); }
  .m-words blockquote { margin: 0; font-size: 1.0625rem; }
  .m-words span { font-size: var(--fs-sm); color: var(--ink-2); }
  .m-about { font-size: var(--fs-sm); color: var(--ink-2); }
  .m-about b { color: var(--ink); font-weight: 600; }
  .m-table summary { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 var(--s-4); border-radius: var(--r-pill); border: 1px solid var(--grey-2); font-size: var(--fs-sm); font-weight: 500; cursor: pointer; }
  .m-table summary:hover { border-color: var(--line-strong); }
  .m-table[open] summary { margin-bottom: var(--s-3); }
  .t-scroll { overflow-x: auto; }
  table { width: 100%; max-width: 32rem; border-collapse: collapse; font-size: 0.9375rem; }
  th, td { padding: var(--s-2) var(--s-3); text-align: left; border-bottom: 1px solid var(--line); }
  thead th { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-2); }
  tbody th { font-weight: 400; white-space: nowrap; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.none td { color: var(--ink-2); font-style: italic; }
  @media (max-width: 30rem) {
    .measure { padding: var(--s-4); border-radius: var(--r-lg); }
    .tiles :global(.tile) { padding: var(--s-3) var(--s-4); }
    .tiles :global(.tile-value) { font-size: 1.375rem; }
  }
</style>
