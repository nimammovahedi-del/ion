---
/**
 * The overview grid: one small card per measure with its icon, the last 14 days against her usual, her latest answer
 * and a status word. Each card jumps to that measure's section, so this is the main way around the page.
 */
import type { MetricSeries } from '@/data/types';
import Chip from '@/components/ui/Chip.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import MiniTrend from './MiniTrend.astro';
import { lastDays } from '@/lib/loaders';
import { ICON, TONE, STATUS_WORD, latest, valueWords } from './measure';
interface Props { measures: MetricSeries[] }
const { measures } = Astro.props;
---
<section class="ov" aria-labelledby="ov-h" data-reveal>
  <div class="ov-head">
    <h2 id="ov-h" class="h3">Each measure, last 14 days</h2>
    <p class="muted small">Pick one to see more. The dotted line is her usual.</p>
  </div>
  <ul role="list" class="ov-grid">
    {measures.map((m, i) => {
      const last = latest(lastDays(m, 14));
      return (
        <li class="draw-pop" style={`--i:${i}`}>
          <a class:list={['ov-card', `ov-${m.status}`]} href={`#${m.id}`}>
            <span class="ov-top"><IconBadge name={ICON[m.id]} tone={m.status === 'usual' ? TONE[m.id] : 'surface'} size="md" /><b>{m.title}</b></span>
            <span class="ov-pic"><MiniTrend m={m} days={14} width={220} height={56} /></span>
            <span class="ov-foot">
              <span class="ov-val"><span class="ov-when">Latest</span>{last ? valueWords(m.id, last.value) : 'No answer'}</span>
              <Chip tone={m.status}>{STATUS_WORD[m.status]}</Chip>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>
<style>
  .ov { display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  .ov-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-1) var(--s-4); }
  .ov-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--s-4); }
  .ov-grid li { display: flex; min-width: 0; }
  .ov-card { flex: 1; display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); color: var(--ink); text-decoration: none; min-width: 0; transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  .ov-card:hover { color: var(--ink); transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .ov-changed { background: var(--acc-soft); border-color: transparent; }
  .ov-check { background: var(--butter-soft); border-color: transparent; }
  .ov-top { display: flex; align-items: center; gap: var(--s-3); }
  .ov-top b { font-size: 1.0625rem; font-weight: 500; }
  .ov-pic { display: flex; align-items: center; min-height: 3.5rem; }
  .ov-pic :global(svg) { width: 100%; }
  .ov-foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--s-2); margin-top: auto; }
  .ov-val { display: flex; flex-direction: column; font-size: 1.1875rem; font-weight: 500; line-height: 1.25; letter-spacing: -0.015em; }
  .ov-when { font-size: var(--fs-sm); font-weight: 400; letter-spacing: 0; color: var(--ink-2); }
</style>
