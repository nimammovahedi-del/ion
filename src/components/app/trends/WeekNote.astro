---
/** The weekly "what changed" note: this week against the weeks before. Changed things first, steady things after. */
import type { WeekNote } from '@/data/types';
interface Props { notes: WeekNote[] }
const { notes } = Astro.props;
const [now, ...earlier] = notes;
const nothing = (w: WeekNote) => w.changed.length === 1 && /^Nothing changed/.test(w.changed[0]);
---
{now && (
  <section class="wn" aria-labelledby="wn-h">
    <h2 id="wn-h" class="h3">This week, {now.week}</h2>
    <div class="cols">
      <div class="col col-changed">
        <h3><span class="mk" aria-hidden="true"></span>What changed</h3>
        <ul>{now.changed.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="col">
        <h3><span class="mk mk-same" aria-hidden="true"></span>What stayed the same</h3>
        <ul>{now.steady.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
    {earlier.length > 0 && (
      <details>
        <summary>The weeks before</summary>
        <ul role="list" class="earlier">
          {earlier.map((w) => (
            <li>
              <b>{w.week}.</b> {nothing(w) ? 'Nothing changed.' : w.changed.join(' ')} <span class="muted">{w.steady.join(' ')}</span>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>
)}
<style>
  .wn { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-6); border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--s-3); }
  .col { padding: var(--s-4) var(--s-5); border-radius: var(--r-lg); background: var(--paper); }
  .col-changed { background: var(--acc-soft); }
  h3 { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); font-weight: 600; margin-bottom: var(--s-2); }
  ul:not(.earlier) { padding-left: 1.125rem; display: flex; flex-direction: column; gap: var(--s-1); line-height: 1.5; }
  .mk { width: 0.75rem; height: 0.75rem; border-radius: 0.2rem; background: var(--acc-text); transform: rotate(45deg); }
  .mk-same { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ink-2); transform: none; }
  summary { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 var(--s-4); border-radius: var(--r-pill); border: 1px solid var(--grey-2); font-size: var(--fs-sm); font-weight: 500; cursor: pointer; }
  details[open] summary { margin-bottom: var(--s-3); }
  .earlier { display: flex; flex-direction: column; gap: var(--s-3); font-size: 0.9375rem; line-height: 1.55; }
  .earlier b { font-weight: 600; }
  @media (max-width: 30rem) { .wn { padding: var(--s-4); border-radius: var(--r-lg); } }
</style>
