---
/** "Find your way": every other page of the app as a shortcut tile, drawn from the one list of pages in nav.ts. */
import IconBadge from '@/components/ui/IconBadge.astro';
import { appNav } from '@/data/nav';
interface Props { current: string }
const { current } = Astro.props;
const pages = appNav.filter((n) => n.id !== current);
---
<nav class="way" aria-labelledby="way-h" data-reveal>
  <h2 id="way-h" class="h3">Find your way</h2>
  <ul role="list">
    {pages.map((n, i) => (
      <li class="draw-pop" style={`--i:${i}`}>
        <a href={n.href}>
          <IconBadge name={n.icon} tone={n.tone ?? 'acc'} size="md" />
          <span class="way-words">
            <b>{n.label}{n.soon && <em>Soon</em>}</b>
            {n.hint && <span>{n.hint}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>
<style>
  .way { display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: var(--s-3); }
  li { display: flex; min-width: 0; }
  a { flex: 1; display: flex; align-items: center; gap: var(--s-3); min-height: 4.25rem; padding: var(--s-3) var(--s-4); border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); color: var(--ink); text-decoration: none; min-width: 0; transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  a:hover { color: var(--ink); transform: translateY(-2px); box-shadow: var(--shadow-1); }
  .way-words { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; }
  .way-words b { display: flex; align-items: center; gap: var(--s-2); font-weight: 500; }
  .way-words span { font-size: var(--fs-sm); color: var(--ink-2); }
  em { font-style: normal; font-size: var(--fs-xs); font-weight: 500; color: var(--ink-2); background: var(--grey-1); border-radius: var(--r-pill); padding: 0.125rem 0.5rem; }
</style>
