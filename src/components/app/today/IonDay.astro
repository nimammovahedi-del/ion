---
/**
 * "What Ion did today" as a short timeline: called, she answered, report written, what waits for the family, what comes later.
 * It is an ordered list, so it reads in order. Each stop says its state in words.
 * The stop that waits for the family shows a different line once they have said yes: the Today page renders this
 * component twice (before and after) and the task cards' script shows the one that fits.
 */
import type { DayFlowStep } from '@/data/types';
import Chip from '@/components/ui/Chip.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
interface Props { steps: DayFlowStep[]; said?: boolean; label: string }
const { steps, said = false, label } = Astro.props;
const view = steps.map((s) => (said && s.status === 'needs-you' ? { ...s, status: 'done' as const, text: s.doneText ?? s.text } : s));
const TONE = { done: 'leaf', 'needs-you': 'butter', later: 'paper' } as const;
---
<ol class="day" role="list" aria-label={label} data-draw>
  {view.map((s, i) => (
    <li class:list={['stop', `stop-${s.status}`, 'draw-pop']} style={`--i:${i * 2}`}>
      <span class="stop-time num">{s.time}</span>
      <span class="stop-node"><IconBadge name={s.icon} tone={TONE[s.status]} size="lg" round /></span>
      <span class="stop-words">
        <b>{s.title}</b>
        <span>{s.text}</span>
      </span>
      {s.status === 'done' && <Chip tone="done">Done</Chip>}
      {s.status === 'needs-you' && <a class="stop-link" href="#needs"><Chip tone="waiting" dot>Waiting for you</Chip></a>}
      {s.status === 'later' && <Chip tone="info">Later today</Chip>}
    </li>
  ))}
</ol>
<style>
  .day { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--s-4); }
  .stop { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--s-2); text-align: center; min-width: 0; }
  .stop-time { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-2); }
  .stop-node { position: relative; z-index: 1; display: grid; border-radius: 50%; box-shadow: 0 0 0 0.375rem var(--surface); }
  /* the line that joins this stop to the next: solid when the next one is done, dashed when it is still to come */
  .stop:not(:last-child)::after { content: ''; position: absolute; top: calc(var(--fs-sm) * 1.625 + var(--s-2) + 1.75rem - 1.5px); left: 50%; width: calc(100% + var(--s-4)); border-top: 3px solid var(--leaf); }
  .stop-needs-you:not(:last-child)::after, .stop-later:not(:last-child)::after { border-top: 3px dotted var(--line-strong); }
  .stop-words { display: flex; flex-direction: column; gap: 0.125rem; line-height: 1.4; margin-top: var(--s-1); }
  .stop-words b { font-weight: 500; font-size: 1.0625rem; }
  .stop-words span { min-height: 2.8em; font-size: var(--fs-sm); color: var(--ink-2); text-wrap: balance; }
  .stop :global(.chip) { margin-top: var(--s-1); }
  .stop-link { display: inline-flex; align-items: center; min-height: var(--tap); margin: -0.25rem 0 -0.5rem; border-radius: var(--r-pill); text-decoration: none; }
  .stop-link :global(.chip) { margin-top: 0; }
  .stop-link:hover :global(.chip) { box-shadow: var(--shadow-1); }
  @container (max-width: 44rem) {
    .day { grid-auto-flow: row; gap: var(--s-5); }
    .stop { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; justify-items: start; text-align: left; gap: var(--s-1) var(--s-4); }
    .stop-time { grid-column: 2; }
    .stop-node { grid-row: 1 / span 3; grid-column: 1; }
    .stop-words { grid-column: 2; margin-top: 0; }
    .stop-words span { min-height: 0; }
    .stop :global(.chip), .stop-link { grid-column: 2; }
    .stop:not(:last-child)::after { display: none; }
  }
</style>
