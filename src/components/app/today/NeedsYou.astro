---
/**
 * "What needs you": the tasks waiting for the main caregiver.
 * r1: the buttons work in this browser only. A small script marks a card done, updates the counts and keeps the change
 * in the same local store the Tasks page uses, so the two pages agree. Nothing is sent.
 */
import type { Task } from '@/data/types';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Chip from '@/components/ui/Chip.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
interface Props { tasks: Task[]; viewer?: string }
const { tasks, viewer = '' } = Astro.props;
const NUM = ['Nothing', 'One thing', 'Two things', 'Three things', 'Four things', 'Five things'];
const countText = (n: number) => (n === 0 ? 'Nothing is waiting for you' : `${NUM[n] ?? `${n} things`} ${n === 1 ? 'needs' : 'need'} you`);
const fromText = (t: Task) => {
  if (t.from === 'Tue call') return "She asked on today's call";
  if (t.from === 'Medicine list') return 'From her medicine list';
  if (t.from === 'Family note') return 'From a family note';
  return `From the ${t.from}`;
};
---
<section class="needs" id="needs" aria-labelledby="needs-h" data-needs data-viewer={viewer} data-reveal>
  <div class="needs-head">
    <IconBadge name="tasks" tone="surface" size="md" round />
    <h2 id="needs-h" class="h3"><span data-needs-count>{countText(tasks.length)}</span></h2>
    <a class="all" href="/app/tasks/">All tasks<Icon name="arrow" size={16} /></a>
  </div>
  {tasks.length === 0 ? (
    <p class="calm">Nothing is waiting for you today. If something comes up on a call, it will be here.</p>
  ) : (
    <>
      <ol role="list" class="list">
        {tasks.map((t, i) => (
          <li class="task draw-pop" style={`--i:${i * 2}`} data-task={t.id}>
            <div class="task-top">
              <IconBadge name={t.icon} tone="butter" size="lg" />
              {t.due && <span class="task-due"><Icon name="clock" size={14} />Due {t.due}</span>}
            </div>
            <div class="task-text">
              <p class="task-from">{fromText(t)}</p>
              <h3 class="task-title">{t.title}</h3>
              <p class="task-detail">{t.detail}</p>
            </div>
            <div class="task-actions" data-actions>
              {t.actions.map((a) => (
                <Button size="sm" variant={a.kind === 'primary' ? 'primary' : 'secondary'} data-act={a.label}>{a.label}</Button>
              ))}
            </div>
            <div class="task-done" data-done hidden>
              <span data-chip="in-progress"><Chip tone="working">In progress</Chip></span>
              <span data-chip="done" hidden><Chip tone="done">Done</Chip></span>
              <p><span data-done-text></span> Example only, nothing was sent.</p>
              <button type="button" class="undo" data-undo>Undo<span class="sr-only"> for {t.title}</span></button>
            </div>
          </li>
        ))}
      </ol>
      <p class="calm" data-all-done hidden>That is everything for today. Thank you. Ion will add anything new after tomorrow's call.</p>
      <p class="note"><Icon name="lock" size={14} />Example data. Nothing is sent. Changes are kept in this browser only.</p>
    </>
  )}
  <p class="sr-only" aria-live="polite" data-live></p>
</section>

<script>
  import { load, save, syncWaitingBadge } from '@/components/app/care/store';

  type State = Record<string, { status: 'needs-you' | 'in-progress' | 'done'; who?: string }>;
  const NUM = ['Nothing', 'One thing', 'Two things', 'Three things', 'Four things', 'Five things'];
  const countText = (n: number) => (n === 0 ? 'Nothing is waiting for you' : `${NUM[n] ?? `${n} things`} ${n === 1 ? 'needs' : 'need'} you`);
  document.querySelectorAll<HTMLElement>('[data-needs]').forEach((root) => {
    const live = root.querySelector<HTMLElement>('[data-live]');
    const viewer = root.dataset.viewer || undefined;
    const state = load<State>('tasks', {});
    const update = (store: boolean) => {
      const left = root.querySelectorAll('[data-task]:not(.is-done)').length;
      const count = root.querySelector('[data-needs-count]');
      if (count) count.textContent = countText(left);
      const all = root.querySelector<HTMLElement>('[data-all-done]');
      if (all) all.hidden = left > 0;
      if (store) { save('tasks', state); save('waiting', left); }
      syncWaitingBadge(left);
      return left;
    };
    const show = (card: HTMLElement, done: boolean, words = '', finished = false) => {
      const actions = card.querySelector<HTMLElement>('[data-actions]');
      const box = card.querySelector<HTMLElement>('[data-done]');
      const text = card.querySelector<HTMLElement>('[data-done-text]');
      if (!actions || !box || !text) return;
      card.classList.toggle('is-done', done);
      actions.hidden = done;
      box.hidden = !done;
      if (done) text.textContent = words;
      card.querySelectorAll<HTMLElement>('[data-chip]').forEach((c) => { c.hidden = (c.dataset.chip === 'done') !== finished; });
    };
    // Step 4 of "What Ion did today" is the ride. Keep it in step with the ride card.
    const syncRideStep = () => {
      const waiting = !state.ride || state.ride.status === 'needs-you';
      document.querySelectorAll<HTMLElement>('[data-ride-step]').forEach((el) => { el.hidden = !waiting; });
      document.querySelectorAll<HTMLElement>('[data-ride-step-done]').forEach((el) => { el.hidden = waiting; });
    };
    root.querySelectorAll<HTMLElement>('[data-task]').forEach((card) => {
      const id = card.dataset.task as string;
      const title = card.querySelector('.task-title')?.textContent ?? '';
      // Bring back what was chosen earlier in this browser, here or on the Tasks page.
      const before = state[id];
      if (before && before.status !== 'needs-you') show(card, true, before.status === 'done' ? 'Marked done.' : `${!before.who || before.who === viewer ? 'You have' : `${before.who} has`} this one.`, before.status === 'done');
      card.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const label = btn.dataset.act ?? '';
          const finished = /already|done/i.test(label);
          const other = label.match(/^(\w+) will /)?.[1];
          show(card, true, `You chose "${label}".`, finished);
          state[id] = { status: finished ? 'done' : 'in-progress', who: other ?? viewer };
          const left = update(true);
          syncRideStep();
          if (live) live.textContent = `${title}: ${finished ? 'marked done' : 'now in progress'}. ${countText(left)}.`;
          card.querySelector<HTMLButtonElement>('[data-undo]')?.focus();
        });
      });
      card.querySelector<HTMLButtonElement>('[data-undo]')?.addEventListener('click', () => {
        show(card, false);
        delete state[id];
        const left = update(true);
        syncRideStep();
        if (live) live.textContent = `${title} is waiting again. ${countText(left)}.`;
        card.querySelector<HTMLButtonElement>('[data-actions] button')?.focus();
      });
    });
    if (Object.keys(state).length) update(false);
    syncRideStep();
  });
</script>

<style>
  .needs { display: flex; flex-direction: column; gap: var(--s-5); padding: var(--s-8); background: var(--butter-soft); border-radius: var(--r-xl); min-width: 0; scroll-margin-top: var(--s-6); }
  .needs-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .needs-head h2 { margin-right: auto; font-size: 1.625rem; font-weight: 400; letter-spacing: -0.025em; }
  .all { display: inline-flex; align-items: center; gap: var(--s-2); min-height: var(--tap); font-size: 0.9375rem; font-weight: 500; color: var(--ink); }
  .all:hover { color: var(--acc-text); }
  .list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.5rem), 1fr)); gap: var(--s-4); }
  .task { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-1); min-width: 0; }
  .task.is-done { background: transparent; box-shadow: none; outline: 1px dashed var(--line-strong); outline-offset: -1px; }
  .task.is-done .task-title { color: var(--ink-2); }
  .task-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-3); }
  .task-due { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 1.75rem; padding: 0 0.75rem; border-radius: var(--r-pill); background: var(--paper); font-size: 0.8125rem; font-weight: 500; white-space: nowrap; }
  .task-text { display: flex; flex-direction: column; gap: var(--s-1); min-width: 0; }
  .task-from { font-size: var(--fs-sm); font-weight: 500; color: var(--acc-text); }
  .task-title { font-size: 1.25rem; font-weight: 500; line-height: 1.25; letter-spacing: -0.015em; }
  .task-detail { font-size: 0.9375rem; line-height: 1.5; color: var(--ink-2); }
  .task-actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: auto; }
  .task-actions[hidden], .task-done[hidden] { display: none; }
  .task-done { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); margin-top: auto; font-size: var(--fs-sm); color: var(--ink-2); }
  .task-done p { flex: 1 1 100%; }
  .undo { min-height: var(--tap); padding: 0 var(--s-3); border: 0; border-radius: var(--r-pill); background: transparent; color: var(--acc-text); font-size: var(--fs-sm); font-weight: 500; text-decoration: underline; text-underline-offset: 0.2em; }
  .undo:hover { background: var(--acc-soft); }
  .calm { font-size: var(--fs-lg); line-height: 1.5; padding: var(--s-4) var(--s-5); border-radius: var(--r-lg); background: var(--surface); }
  .calm[hidden] { display: none; }
  .note { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--ink-2); }
  @media (max-width: 30rem) {
    .needs { padding: var(--s-5); border-radius: var(--r-lg); }
    .task-actions :global(.btn) { flex: 1 1 auto; }
  }
</style>
