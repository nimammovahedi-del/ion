---
/**
 * The week at a glance: seven days across, one row per measure.
 * Each cell is a shape and a word for screen readers: a small dot for "as usual", a filled diamond for "changed",
 * an empty dashed ring for "no answer". It is a real table, so screen readers can move by row and column.
 */
import type { MetricSeries } from '@/data/types';
import { lastDays } from '@/lib/loaders';
import { dayLabel, dayState, valueWords, type DayState } from '@/components/app/trends/measure';
interface Props { metrics: MetricSeries[] }
const { metrics } = Astro.props;
const ORDER = ['sleep', 'feeling', 'pain', 'meals', 'medicines', 'falls', 'out'] as const;
const rows = ORDER.map((id) => metrics.find((m) => m.id === id)).filter((m): m is MetricSeries => !!m).map((m) => {
  const pts = lastDays(m, 7);
  return { m, cells: pts.map((p) => ({ p, state: dayState(m, p.value) })) };
});
const days = rows[0]?.cells.map((c) => c.p) ?? [];
const WORD: Record<DayState, string> = { usual: 'As usual', changed: 'Changed', none: 'No answer' };

// A plain summary a screen reader (and anyone) can use.
const listDays = (ds: string[]) => (ds.length <= 2 ? ds.join(' and ') : `${ds.slice(0, -1).join(', ')} and ${ds[ds.length - 1]}`);
const changedRows = rows.map((r) => ({ title: r.m.title, days: r.cells.filter((c) => c.state === 'changed').map((c) => dayLabel(c.p.date)) })).filter((r) => r.days.length);
const noAnswer = rows.reduce((a, r) => a + r.cells.filter((c) => c.state === 'none').length, 0);
const steady = rows.filter((r) => !r.cells.some((c) => c.state === 'changed')).map((r) => r.m.title.toLowerCase());
const summary = [
  changedRows.length ? `Different from her usual: ${changedRows.map((r) => `${r.title.toLowerCase()} on ${listDays(r.days)}`).join('; ')}.` : 'Everything was close to her usual all week.',
  steady.length && changedRows.length ? `As usual all week: ${listDays(steady)}.` : '',
  noAnswer ? `${noAnswer} answer${noAnswer > 1 ? 's' : ''} missing.` : 'She answered every question on every call.',
].filter(Boolean).join(' ');
const first = days[0], last = days[days.length - 1];
---
<section class="week" aria-labelledby="week-h">
  <div class="week-head">
    <div>
      <h2 id="week-h" class="h3">The week at a glance</h2>
      <p class="muted small">{first && last ? `${dayLabel(first.date, { weekday: 'short', month: 'short', day: 'numeric' })} to ${dayLabel(last.date, { weekday: 'short', month: 'short', day: 'numeric' })}` : ''}, from her answers on each call</p>
    </div>
    <ul role="list" class="legend" aria-label="Key">
      <li><span class="mk mk-usual" aria-hidden="true"></span>As usual</li>
      <li><span class="mk mk-changed" aria-hidden="true"></span>Changed</li>
      <li><span class="mk mk-none" aria-hidden="true"></span>No answer</li>
    </ul>
  </div>
  <p class="summary">{summary}</p>
  <div class="scroll" tabindex="0" role="group" aria-label="Week at a glance table. Scroll sideways if needed.">
    <table>
      <caption class="sr-only">Each measure for the last seven days, as usual, changed or no answer</caption>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">Measure</span></th>
          {days.map((d, i) => (
            <th scope="col" class:list={{ today: i === days.length - 1 }}>
              <span class="dw">{i === days.length - 1 ? 'Today' : dayLabel(d.date)}</span>
              <span class="dn">{dayLabel(d.date, { day: 'numeric' })}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row"><a href={`/app/trends/#${r.m.id}`}>{r.m.title}</a></th>
            {r.cells.map((c, i) => (
              <td class:list={{ today: i === r.cells.length - 1 }} title={`${dayLabel(c.p.date)}: ${valueWords(r.m.id, c.p.value)}`}>
                <span class:list={['mk', `mk-${c.state}`]} aria-hidden="true"></span>
                <span class="sr-only">{WORD[c.state]}: {valueWords(r.m.id, c.p.value)}</span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
<style>
  .week { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-6); border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .week-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: var(--s-3) var(--s-6); }
  .legend { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); font-size: var(--fs-sm); color: var(--ink-2); }
  .legend li { display: inline-flex; align-items: center; gap: var(--s-2); }
  .summary { max-width: 46rem; line-height: 1.55; }
  .scroll { overflow-x: auto; }
  table { width: 100%; min-width: 18.5rem; border-collapse: separate; border-spacing: 0; }
  th, td { padding: var(--s-2) var(--s-1); text-align: center; }
  thead th { font-weight: 400; font-size: var(--fs-xs); color: var(--ink-2); line-height: 1.2; }
  thead th span { display: block; }
  .dn { font-size: var(--fs-sm); color: var(--ink); font-variant-numeric: tabular-nums; }
  thead th.today { color: var(--ink); font-weight: 600; }
  th.today, td.today { background: var(--paper); }
  thead th.today { border-radius: var(--r-md) var(--r-md) 0 0; }
  tbody tr:last-child td.today { border-radius: 0 0 var(--r-md) var(--r-md); }
  tbody th { text-align: left; font-weight: 500; font-size: 0.9375rem; white-space: nowrap; padding-right: var(--s-3); }
  tbody th a { display: inline-flex; align-items: center; min-height: var(--tap); text-decoration: none; }
  tbody th a:hover { text-decoration: underline; }
  tbody tr + tr > * { border-top: 1px solid var(--line); }
  .mk { display: inline-block; vertical-align: middle; }
  .mk-usual { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ink-2); }
  .mk-changed { width: 1rem; height: 1rem; border-radius: 0.2rem; background: var(--acc-text); transform: rotate(45deg); }
  .mk-none { width: 0.875rem; height: 0.875rem; border-radius: 50%; border: 2px dashed var(--ink-2); }
  @media (max-width: 30rem) {
    .week { padding: var(--s-4); border-radius: var(--r-lg); }
    th, td { padding-inline: 0.125rem; }
    tbody th { font-size: var(--fs-sm); padding-right: var(--s-2); }
  }
</style>
