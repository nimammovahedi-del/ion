---
/** A quote in her own words, with who said it and when. size="lg" for the Stories page. */
interface Props { text: string; cite?: string; size?: 'md' | 'lg'; class?: string }
const { text, cite, size = 'md', class: cls = '' } = Astro.props;
---
<figure class:list={['hw', `hw-${size}`, cls]}>
  <span class="hw-mark" aria-hidden="true"></span>
  <blockquote><p>“{text}”</p></blockquote>
  {cite && <figcaption>{cite}</figcaption>}
</figure>
<style>
  .hw { position: relative; display: flex; flex-direction: column; gap: var(--s-2); padding-left: var(--s-5); min-width: 0; }
  .hw-mark { position: absolute; left: 0; top: 0.25rem; bottom: 0.25rem; width: 0.25rem; border-radius: var(--r-pill); background: var(--sun); }
  blockquote { margin: 0; }
  blockquote p { font-size: var(--fs-lg); line-height: 1.5; font-weight: 400; }
  .hw-lg blockquote p { font-size: clamp(1.5rem, 3vw, 2.125rem); font-weight: 300; line-height: 1.3; letter-spacing: -0.02em; }
  figcaption { font-size: var(--fs-sm); color: var(--ink-2); }
</style>
