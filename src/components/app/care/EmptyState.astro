---
/** Shown when a list has nothing in it. Pages toggle `hidden` when items come and go. */
import Icon from '@/components/ui/Icon.astro';
interface Props { icon?: string; text: string; hidden?: boolean; id?: string; [key: string]: unknown }
const { icon = 'check', text, hidden = false, id, ...rest } = Astro.props;
---
<p class="empty" id={id} hidden={hidden} {...rest}><span class="empty-icon"><Icon name={icon} size={18} /></span><span>{text}</span></p>
<style>
  .empty { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-4) var(--s-5); border: 1px dashed var(--line-strong); border-radius: var(--r-lg); color: var(--ink-2); font-size: 0.9375rem; }
  .empty[hidden] { display: none; }
  .empty-icon { display: grid; place-items: center; flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: var(--grey-1); color: var(--ink-2); }
</style>
