---
/**
 * The small picture beside a page heading: one simple flat drawing per care page, coloured with tokens.
 * It is decoration (the heading says where you are), so it is hidden from screen readers.
 */
import Capybara from '@/components/ui/Capybara.astro';
interface Props {
  name: 'tasks' | 'calendar' | 'pills' | 'bell' | 'ask' | 'car' | 'errands' | 'family' | 'phone';
  center?: string;                                  // family: the initial in the middle
  people?: { initials: string; tone: string }[];    // family: the people around her, in their own colours
}
const { name, center = '', people = [] } = Astro.props;
/** Ring marks: a few short, slightly bent strokes fanning out from a point, on both sides. Angles in degrees, 0 pointing right. */
function fan(cx: number, cy: number, r1: number, r2: number, angles: number[]): string[] {
  const one = (deg: number) => {
    const a = (deg * Math.PI) / 180, c = Math.cos(a), s = Math.sin(a);
    const mid = (r1 + r2) / 2, bend = 2.5;
    const f = (n: number) => n.toFixed(1);
    return `M${f(cx + r1 * c)} ${f(cy + r1 * s)}Q${f(cx + mid * c - bend * s)} ${f(cy + mid * s + bend * c)} ${f(cx + r2 * c)} ${f(cy + r2 * s)}`;
  };
  return angles.flatMap((d) => [one(d), one(180 - d)]);
}
const SPOTS = [{ x: 56, y: 46 }, { x: 166, y: 50 }, { x: 110, y: 134 }, { x: 40, y: 112 }, { x: 182, y: 112 }];
const LETTERS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
---
<div class:list={['head-art', `head-art-${name}`]} aria-hidden="true">
  {name === 'tasks' && (
    <svg viewBox="0 0 220 160">
      <ellipse cx="110" cy="96" rx="104" ry="58" fill="var(--butter)" />
      <circle cx="184" cy="34" r="9" fill="var(--sun)" />
      <g transform="rotate(-5 110 84)">
        <rect x="64" y="22" width="92" height="124" rx="14" fill="var(--surface)" />
        <rect x="90" y="13" width="40" height="18" rx="9" fill="var(--deep)" />
        <circle cx="86" cy="60" r="10" fill="var(--leaf)" />
        <path d="M81 60l4 4 7-8" fill="none" stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="104" y="55" width="38" height="10" rx="5" fill="var(--grey-2)" />
        <circle cx="86" cy="89" r="10" fill="var(--acc)" />
        <rect x="104" y="84" width="30" height="10" rx="5" fill="var(--acc-soft)" />
        <circle cx="86" cy="118" r="9" fill="none" stroke="var(--line-strong)" stroke-width="2.4" stroke-dasharray="3 4" />
        <rect x="104" y="113" width="36" height="10" rx="5" fill="var(--grey-2)" />
      </g>
    </svg>
  )}
  {name === 'calendar' && (
    <svg viewBox="0 0 220 160">
      <ellipse cx="110" cy="96" rx="104" ry="58" fill="var(--butter)" />
      <g transform="rotate(4 110 86)">
        <rect x="50" y="30" width="120" height="112" rx="16" fill="var(--surface)" />
        <path d="M50 46a16 16 0 0 1 16-16h88a16 16 0 0 1 16 16v16H50z" fill="var(--acc)" />
        <rect x="78" y="19" width="9" height="24" rx="4.5" fill="var(--deep)" />
        <rect x="133" y="19" width="9" height="24" rx="4.5" fill="var(--deep)" />
        {[0, 1, 2].map((r) => [0, 1, 2, 3, 4].map((c) => <circle cx={70 + c * 20} cy={82 + r * 20} r="5.5" fill={r === 0 && c === 3 ? 'var(--leaf)' : r === 2 && c === 1 ? 'var(--sky)' : 'var(--grey-2)'} />))}
        <circle cx="110" cy="102" r="10" fill="var(--deep)" />
      </g>
    </svg>
  )}
  {name === 'pills' && (
    <svg viewBox="0 0 220 160">
      <ellipse cx="110" cy="92" rx="106" ry="60" fill="var(--leaf)" />
      <rect x="18" y="52" width="184" height="88" rx="18" fill="var(--surface)" />
      {LETTERS.map((l, i) => <text x={61 + i * 21} y="45" text-anchor="middle" font-size="12" font-weight="600" fill="var(--ink)">{l}</text>)}
      <circle cx="36" cy="77" r="7" fill="var(--sun)" />
      <path d="M41 108a8 8 0 0 1-10-10 8 8 0 1 0 10 10z" fill="var(--ink-3)" />
      {LETTERS.map((_, i) => <rect x={52 + i * 21} y="64" width="18" height="26" rx="7" fill="var(--butter)" />)}
      {LETTERS.map((_, i) => <rect x={52 + i * 21} y="100" width="18" height="26" rx="7" fill="var(--sky)" />)}
    </svg>
  )}
  {name === 'bell' && (
    <svg viewBox="0 0 220 160">
      <ellipse cx="110" cy="96" rx="104" ry="58" fill="var(--butter)" />
      <g transform="rotate(-8 110 80)">
        <circle cx="110" cy="28" r="8" fill="var(--deep)" />
        <path d="M98 116a12 12 0 0 0 24 0z" fill="var(--deep)" />
        <path d="M110 32c-22 0-38 17-38 40v24l-10 14h96l-10-14V72c0-23-16-40-38-40z" fill="var(--acc)" />
        <rect x="56" y="104" width="108" height="13" rx="6.5" fill="var(--acc-hover)" />
        <path d="M92 52q-8 9-8 22" fill="none" stroke="var(--surface)" stroke-width="5" stroke-linecap="round" opacity="0.7" />
      </g>
      <g fill="none" stroke="var(--acc-text)" stroke-width="4.5" stroke-linecap="round">
        {fan(110, 74, 64, 80, [-48, -24, 0]).map((d) => <path d={d} />)}
      </g>
    </svg>
  )}
  {name === 'ask' && (
    <div class="ask">
      <svg class="ask-bubble" viewBox="0 0 96 84">
        <path d="M20 4h56a16 16 0 0 1 16 16v26a16 16 0 0 1-16 16H62l10 18-26-18H20A16 16 0 0 1 4 46V20A16 16 0 0 1 20 4z" fill="var(--surface)" />
        <path d="M38 26a10 10 0 1 1 15 8.600c-3.400 2-5 4-5 7" fill="none" stroke="var(--leaf-text)" stroke-width="5" stroke-linecap="round" />
        <circle cx="48" cy="52" r="3.200" fill="var(--leaf-text)" />
      </svg>
      <Capybara size={150} ground="var(--leaf)" waves={false} label="" />
    </div>
  )}
  {name === 'car' && (
    <svg viewBox="0 0 220 160">
      <ellipse cx="110" cy="92" rx="104" ry="58" fill="var(--leaf)" />
      <rect x="22" y="130" width="176" height="6" rx="3" fill="var(--surface)" opacity="0.8" />
      <path d="M64 88l16-30q4-8 13-8h40q9 0 13 8l16 30z" fill="var(--acc)" />
      <rect x="30" y="84" width="160" height="38" rx="17" fill="var(--acc)" />
      <path d="M79 84l11-21q2-4 6-4h11v25z" fill="var(--surface)" />
      <path d="M114 59h15q4 0 6 4l11 21h-32z" fill="var(--surface)" />
      <circle cx="126" cy="76" r="7" fill="var(--fur)" />
      <circle cx="184" cy="98" r="5" fill="var(--butter)" />
      <rect x="30" y="100" width="12" height="7" rx="3.500" fill="var(--acc-text)" />
      <circle cx="72" cy="122" r="15" fill="var(--deep)" /><circle cx="72" cy="122" r="6" fill="var(--paper)" />
      <circle cx="150" cy="122" r="15" fill="var(--deep)" /><circle cx="150" cy="122" r="6" fill="var(--paper)" />
    </svg>
  )}
  {name === 'errands' && (
    <svg viewBox="0 0 220 160">
      <ellipse cx="110" cy="92" rx="104" ry="58" fill="var(--leaf)" />
      <circle cx="112" cy="46" r="8" fill="var(--sun)" />
      <path d="M90 118q30 20 50-6t30-30" fill="none" stroke="var(--surface)" stroke-width="4.500" stroke-linecap="round" stroke-dasharray="1 10" />
      <rect x="34" y="80" width="48" height="42" rx="7" fill="var(--surface)" />
      <path d="M26 86l32-30 32 30z" fill="var(--acc)" />
      <rect x="52" y="98" width="13" height="24" rx="3" fill="var(--deep)" />
      <path d="M180 92c-13-17-19-25-19-34a19 19 0 0 1 38 0c0 9-6 17-19 34z" fill="var(--deep)" />
      <circle cx="180" cy="58" r="7.500" fill="var(--butter)" />
    </svg>
  )}
  {name === 'family' && (
    <svg viewBox="0 0 220 160">
      <ellipse cx="110" cy="84" rx="106" ry="62" fill="var(--sky-soft)" />
      <circle cx="110" cy="84" r="56" fill="none" stroke="var(--line-strong)" stroke-width="2.400" stroke-dasharray="2 8" stroke-linecap="round" />
      <circle cx="110" cy="84" r="27" fill="var(--acc)" />
      <text x="110" y="93" text-anchor="middle" font-size="26" font-weight="600" fill="var(--ink)">{center}</text>
      {people.slice(0, SPOTS.length).map((p, i) => (
        <g transform={`translate(${SPOTS[i].x} ${SPOTS[i].y})`}>
          <circle r="20" fill={`var(--${p.tone})`} stroke="var(--surface)" stroke-width="3" />
          <text y="5" text-anchor="middle" font-size="14" font-weight="600" fill="var(--ink)">{p.initials}</text>
        </g>
      ))}
    </svg>
  )}
  {name === 'phone' && (
    <svg viewBox="0 0 220 160">
      <ellipse cx="110" cy="92" rx="104" ry="58" fill="var(--sky)" />
      <g transform="rotate(6 110 80)">
        <rect x="72" y="10" width="76" height="140" rx="18" fill="var(--deep)" />
        <rect x="79" y="20" width="62" height="116" rx="11" fill="var(--surface)" />
        <circle cx="110" cy="68" r="24" fill="var(--butter)" />
        <path d="M110 52v16l10 7" fill="none" stroke="var(--deep)" stroke-width="4.500" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="90" y="106" width="40" height="14" rx="7" fill="var(--acc)" />
      </g>
      <g fill="none" stroke="var(--acc-text)" stroke-width="4.5" stroke-linecap="round">
        {fan(110, 56, 58, 74, [-36, -12, 12]).map((d) => <path d={d} />)}
      </g>
    </svg>
  )}
</div>
<style>
  .head-art { width: 13.75rem; }
  .head-art svg { width: 100%; height: auto; }
  .ask { position: relative; display: flex; justify-content: flex-end; padding-top: var(--s-2); }
  .ask :global(svg.capy) { width: 9.5rem; height: 9.5rem; }
  .ask-bubble { position: absolute; left: 0; top: 0; width: 5.5rem !important; }
</style>
