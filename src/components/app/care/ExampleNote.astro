---
/** The one visible line on every page that takes input: this is an example, nothing leaves this browser. With a quiet reset. */
import Icon from '@/components/ui/Icon.astro';
interface Props { reset?: boolean; class?: string }
const { reset = true, class: cls = '' } = Astro.props;
---
<aside class:list={['xnote', cls]} aria-label="About this example">
  <Icon name="lock" size={18} />
  <p>This is an example. Nothing you do here is sent anywhere or saved outside this browser.</p>
  {reset && <button type="button" class="xnote-reset" data-ion-reset>Reset the example</button>}
</aside>
<script>
  import { resetAll } from './store';
  document.querySelectorAll<HTMLButtonElement>('[data-ion-reset]').forEach((b) => {
    b.addEventListener('click', () => { resetAll(); location.reload(); });
  });
</script>
<style>
  .xnote { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4); border: 1px dashed var(--line-strong); border-radius: var(--r-md); color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.5; }
  .xnote :global(svg) { flex: none; }
  .xnote p { flex: 1 1 14rem; }
  .xnote-reset { min-height: var(--tap); padding: 0 var(--s-3); border: 0; border-radius: var(--r-sm); background: transparent; color: var(--acc-text); font-size: var(--fs-sm); font-weight: 500; text-decoration: underline; text-underline-offset: 0.2em; }
  .xnote-reset:hover { background: var(--acc-soft); }
</style>
