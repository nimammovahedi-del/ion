---
/**
 * On/off switch. A real checkbox with role="switch", so it works with a keyboard, with a screen reader and without JavaScript.
 * The state is also written in words next to it, so it never rests on colour alone.
 */
interface Props { label: string; hideLabel?: boolean; hint?: string; checked?: boolean; name?: string; id?: string; value?: string; class?: string; [key: string]: unknown }
const { label, hideLabel = false, hint, checked = false, name, id, value, class: cls = '', ...rest } = Astro.props;
---
<label class:list={['sw', { 'sw-bare': hideLabel }, cls]}>
  <span class:list={['sw-text', { 'sr-only': hideLabel }]}>
    <span class="sw-label">{label}</span>
    {hint && <span class="sw-hint">{hint}</span>}
  </span>
  <span class="sw-control">
    <input class="sw-input" type="checkbox" role="switch" name={name} id={id} value={value} checked={checked} {...rest} />
    <span class="sw-track" aria-hidden="true"><span class="sw-thumb"></span></span>
    <span class="sw-state" aria-hidden="true"><span class="sw-on">On</span><span class="sw-off">Off</span></span>
  </span>
</label>
<style>
  .sw { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); min-height: var(--tap); cursor: pointer; }
  .sw-bare { justify-content: flex-end; }
  .sw-text { display: flex; flex-direction: column; min-width: 0; }
  .sw-label { font-weight: 500; line-height: 1.4; }
  .sw-hint { font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.5; }
  .sw-control { position: relative; display: inline-flex; align-items: center; gap: var(--s-2); flex: none; min-height: var(--tap); }
  .sw-input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .sw-track { position: relative; width: 3rem; height: 1.75rem; border-radius: var(--r-pill); background: var(--grey-2); border: 1px solid var(--line-strong); transition: background 0.15s var(--ease); }
  .sw-thumb { position: absolute; top: 0.1875rem; left: 0.1875rem; width: 1.25rem; height: 1.25rem; border-radius: 50%; background: var(--surface); box-shadow: var(--shadow-1); transition: transform 0.15s var(--ease); }
  .sw-state { min-width: 1.75rem; font-size: var(--fs-sm); font-weight: 500; }
  .sw-on { display: none; }
  .sw-input:checked ~ .sw-track { background: var(--acc); border-color: var(--acc-text); }
  .sw-input:checked ~ .sw-track .sw-thumb { transform: translateX(1.25rem); background: var(--deep); }
  .sw-input:checked ~ .sw-state .sw-on { display: inline; }
  .sw-input:checked ~ .sw-state .sw-off { display: none; }
  .sw-input:focus-visible ~ .sw-track { outline: 3px solid var(--focus); outline-offset: 2px; }
  .sw-input:disabled, .sw-input:disabled ~ * { cursor: not-allowed; opacity: 0.7; }
</style>
