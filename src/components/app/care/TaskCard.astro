---
/**
 * One task from the calls. The card holds the controls for every state and shows the ones that fit its data-status,
 * so a script only has to change data-status and move the card. Without JavaScript the starting state reads correctly.
 * Shape follows state: a task waiting for a yes is a tall card with its buttons, a task someone has is a row with their face,
 * a finished task is a quiet row with a tick.
 */
import type { CareTask } from '@/data/types-care';
import type { Person } from '@/data/types';
import IconBadge from '@/components/ui/IconBadge.astro';
import Chip from '@/components/ui/Chip.astro';
import Button from '@/components/ui/Button.astro';
import Avatar from './Avatar.astro';
import AlsoOn from './AlsoOn.astro';
import { facesOf } from './people';
import './care.css';
interface Props { task: CareTask; people: Person[]; viewerId: string; also?: { label: string; href: string }[] }
const { task, people, viewerId, also = [] } = Astro.props;
const viewer = people.find((p) => p.id === viewerId);
const faces = facesOf(people);
const nameFor = (who?: string) => (who && viewer && who === viewer.short ? 'You' : who);
const doingLine = task.status === 'needs-you' ? '' : task.status === 'done'
  ? (task.doneNote ?? `Done by ${task.assignee ?? 'the family'}.`)
  : task.assignee === 'Ion' ? `Ion will ${task.doing}.` : `${nameFor(task.assignee)} will ${task.doing}.`;
const face = task.assignee ? faces[task.assignee] : undefined;
const sel = `who-${task.id}`;
---
<article class="task" id={`task-${task.id}`} data-task={task.id} data-status={task.status} data-doing={task.doing} data-title={task.title} aria-labelledby={`t-${task.id}`}>
  <div class="task-main">
    <div class="task-head">
      <span class="task-tile"><IconBadge name={task.icon} tone="butter" size="md" /></span>
      <span class="task-tick"><IconBadge name="check" tone="leaf" size="md" round /></span>
      <div class="task-titles">
        <h3 id={`t-${task.id}`}>{task.title}</h3>
        <p class="task-detail">{task.detail}</p>
        <p class="task-who" data-who hidden={!doingLine}>
          <Avatar size="sm" tone={face?.tone ?? 'paper'} initials={face?.initials ?? ''} ion={task.assignee === 'Ion'} data-slot="face" />
          <span data-slot="doing">{doingLine}</span>
        </p>
        <p class="task-from"><span class="sr-only">Where it came from: </span>{task.source ?? task.from}</p>
        <AlsoOn links={also} />
      </div>
    </div>
    {task.due && <p class="task-due"><Chip tone="info">Due {task.due}</Chip></p>}
  </div>

  <div class="task-act when-needs-you">
    <form class="task-form" data-approve>
      <div class="cf-field task-pick">
        <label for={sel}>Who will do it</label>
        <select class="cf-select" id={sel} name="who">
          {people.map((p) => <option value={p.short} selected={p.id === viewerId}>{p.id === viewerId ? `${p.short} (you)` : p.short}</option>)}
        </select>
      </div>
      <div class="task-buttons">
        <Button type="submit" variant="primary" size="sm">{task.approveLabel}</Button>
        <button type="button" class="cf-link" data-done>Already done</button>
      </div>
    </form>
  </div>
  <div class="task-act when-in-progress">
    <Button variant="secondary" size="sm" data-done>Mark as done</Button>
  </div>
  <div class="task-act when-done"><Chip tone="done">Done</Chip></div>
</article>
<style>
  .task { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s-3) var(--s-5); height: 100%; padding: var(--s-4) var(--s-5); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); min-width: 0; scroll-margin-top: var(--s-6); }
  .task:target { box-shadow: 0 0 0 3px var(--acc); }
  .task-main { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: var(--s-3) var(--s-4); min-width: 0; }
  .task-head { display: flex; align-items: flex-start; gap: var(--s-3); min-width: 0; }
  .task-tile, .task-tick { flex: none; display: inline-flex; }
  .task-titles { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  h3 { font-size: 1.125rem; font-weight: 500; line-height: 1.35; letter-spacing: -0.01em; }
  .task-detail { color: var(--ink-2); font-size: 0.9375rem; line-height: 1.5; }
  .task-from { font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.5; }
  .task-who { display: flex; align-items: center; gap: var(--s-2); font-weight: 500; line-height: 1.4; padding-block: 0.125rem; }
  .task-who[hidden] { display: none; }
  .task-act { display: flex; align-items: center; gap: var(--s-3); }
  .task-form { display: flex; flex-direction: column; gap: var(--s-3); width: 100%; }
  .task-buttons { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-2); }

  /* waiting for a yes: a tall card, buttons at the foot, a warm edge */
  .task[data-status='needs-you'] { grid-template-columns: minmax(0, 1fr); align-items: stretch; align-content: space-between; gap: var(--s-4); padding: var(--s-5); border-color: transparent; box-shadow: var(--shadow-1), inset 0 0 0 2px var(--butter); }
  .task[data-status='needs-you']:target { box-shadow: var(--shadow-1), inset 0 0 0 2px var(--butter), 0 0 0 3px var(--acc); }
  .task[data-status='needs-you'] .task-main { grid-template-columns: minmax(0, 1fr); }
  .task[data-status='needs-you'] .task-head { flex-direction: column; }
  .task[data-status='needs-you'] .task-act { padding-top: var(--s-4); border-top: 1px dashed var(--line-strong); }
  /* done: quiet, with a tick */
  .task[data-status='done'] { background: transparent; border-style: dashed; border-color: var(--line-strong); }
  .task:not([data-status='done']) .task-tick, .task[data-status='done'] .task-tile { display: none; }
  .task[data-status='done'] .task-detail, .task[data-status='done'] .task-due { display: none; }
  /* show only what fits the state */
  .task:not([data-status='needs-you']) .when-needs-you,
  .task:not([data-status='in-progress']) .when-in-progress,
  .task:not([data-status='done']) .when-done { display: none; }
  @media (max-width: 48rem) {
    .task, .task-main { grid-template-columns: minmax(0, 1fr); }
  }
</style>
