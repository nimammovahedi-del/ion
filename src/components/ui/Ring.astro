---
/**
 * A progress ring drawn as inline SVG: "6 of 7 nights", "3 of 5 done".
 * Always pass `label`: it is what a screen reader hears. Put the short visible figure in the slot.
 * The ring sweeps in when a parent with data-reveal or data-draw scrolls into view.
 */
interface Props { value: number; max: number; label: string; size?: number; thickness?: number; tone?: 'acc' | 'leaf' | 'butter' | 'sky' | 'deep'; class?: string }
const { value, max, label, size = 96, thickness = 10, tone = 'acc', class: cls = '' } = Astro.props;
const frac = max > 0 ? Math.max(0, Math.min(1, value / max)) : 0;
const r = 50 - thickness / 2;
---
<div class:list={['ring', `ring-${tone}`, cls]} style={`--size:${size / 16}rem`} role="img" aria-label={label}>
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <circle class="ring-track" cx="50" cy="50" r={r} stroke-width={thickness} />
    {frac > 0 && <circle class="ring-arc" cx="50" cy="50" r={r} stroke-width={thickness} pathLength="1" stroke-dasharray={`${frac} 1`} style={`--frac:${frac}`} transform="rotate(-90 50 50)" />}
  </svg>
  <span class="ring-mid num" aria-hidden="true"><slot /></span>
</div>
<style>
  .ring { position: relative; flex: none; width: var(--size); height: var(--size); }
  svg { width: 100%; height: 100%; }
  circle { fill: none; stroke-linecap: round; }
  .ring-track { stroke: var(--grey-1); }
  .ring-acc .ring-arc { stroke: var(--acc); }
  .ring-leaf .ring-arc { stroke: var(--leaf); }
  .ring-butter .ring-arc { stroke: var(--butter); }
  .ring-sky .ring-arc { stroke: var(--sky); }
  .ring-deep .ring-arc { stroke: var(--deep); }
  .ring-mid { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; font-weight: 500; font-size: calc(var(--size) * 0.26); line-height: 1; letter-spacing: -0.02em; }
  /* The shared .draw-line rule animates a full-length stroke. A ring is a partial arc, so it animates the dash instead. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js [data-reveal]) .ring-arc, :global(.js [data-draw]) .ring-arc { stroke-dasharray: 0 1; stroke-dashoffset: 0; transition: stroke-dasharray 1.1s var(--ease) calc(var(--i, 0) * 90ms + 150ms); }
    :global(.js .is-in) .ring-arc { stroke-dasharray: var(--frac) 1; }
  }
</style>
