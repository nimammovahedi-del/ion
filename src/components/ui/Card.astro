---
/** Warm white rounded surface. Tones: "paper" beige, "cream", "soft" peach, "leaf" sage, "butter", "sky", "acc" apricot, "deep" espresso. */
interface Props {
  as?: 'div' | 'article' | 'section' | 'li';
  tone?: 'surface' | 'paper' | 'cream' | 'deep' | 'acc' | 'soft' | 'leaf' | 'butter' | 'sky';
  pad?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}
const { as: Tag = 'div', tone = 'surface', pad = 'md', class: cls = '', ...rest } = Astro.props;
---
<Tag class:list={['card', `card-${tone}`, `pad-${pad}`, cls]} {...rest}><slot /></Tag>
<style>
  .card { border-radius: var(--r-lg); min-width: 0; }
  .card-surface { background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); }
  .card-paper { background: var(--paper); }
  .card-soft { background: var(--acc-soft); }
  .card-cream { background: var(--cream); }
  .card-leaf { background: var(--leaf-soft); }
  .card-butter { background: var(--butter-soft); }
  .card-sky { background: var(--sky-soft); }
  .card-deep { background: var(--deep); color: var(--on-deep); }
  .card-acc { background: var(--acc); color: var(--on-acc); }
  .pad-none { padding: 0; overflow: hidden; }
  .pad-sm { padding: var(--s-4); }
  .pad-md { padding: var(--s-5); }
  .pad-lg { padding: var(--s-8); }
</style>
