---
/** Status and label chips. State is always said in words, never by colour alone. */
interface Props {
  tone?: 'changed' | 'check' | 'usual' | 'done' | 'waiting' | 'working' | 'info' | 'source';
  dot?: boolean;
  class?: string;
}
const { tone = 'info', dot = false, class: cls = '' } = Astro.props;
---
<span class:list={['chip', `chip-${tone}`, cls]}>
  {tone === 'done' && (
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
  )}
  {dot && <span class="chip-dot" aria-hidden="true" />}
  <slot />
</span>
<style>
  .chip { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 1.75rem; padding: 0 0.75rem; border-radius: var(--r-pill); font-size: 0.8125rem; font-weight: 500; line-height: 1; white-space: nowrap; }
  .chip-dot { width: 0.375rem; height: 0.375rem; border-radius: 50%; background: currentColor; }
  .chip-changed { background: var(--acc); color: var(--on-acc); }
  .chip-check { background: var(--deep); color: var(--on-deep); }
  .chip-usual { background: var(--grey-2); color: var(--ink); }
  .chip-done { background: var(--grey-1); color: var(--ink); }
  .chip-waiting { background: var(--acc-soft); color: var(--ink); }
  .chip-waiting .chip-dot { background: var(--acc-text); }
  .chip-working { background: var(--surface); color: var(--ink); border: 1px solid var(--line-strong); }
  .chip-info { background: var(--grey-1); color: var(--ink-2); }
  .chip-source { min-height: 1.375rem; padding: 0 0.375rem; border-radius: 0.375rem; border: 1px solid var(--line-strong); background: transparent; color: var(--ink-2); font-family: var(--mono); font-size: 0.6875rem; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; }
</style>
