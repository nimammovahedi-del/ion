---
/** Small label with the blue dot that opens a section. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<p class:list={['eyebrow', cls]}><span class="eyebrow-dot" aria-hidden="true"></span><slot /></p>
<style>
  .eyebrow { display: inline-flex; align-items: center; gap: var(--s-2); font-size: 0.9375rem; color: var(--ink); }
  .eyebrow-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--acc); box-shadow: 0 0 0 3px var(--acc-soft); }
</style>
