---
/** The one button. Renders <a> when href is given, otherwise <button>. */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'dark' | 'light' | 'ghost';
  size?: 'md' | 'lg' | 'sm';
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', arrow = false, type = 'button', class: cls = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type };
---
<Tag class:list={['btn', `btn-${variant}`, `btn-${size}`, cls]} {...attrs} {...rest}>
  <slot />
  {arrow && (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  )}
</Tag>
<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--s-2); min-height: 3rem; padding: 0 1.375rem; border-radius: var(--r-pill); border: 1px solid transparent; font-size: 0.9375rem; font-weight: 500; line-height: 1; text-decoration: none; white-space: nowrap; transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease), background 0.15s var(--ease); }
  .btn:hover { transform: translateY(-1px); }
  .btn:active { transform: none; }
  .btn-sm { min-height: var(--tap); padding: 0 1rem; font-size: var(--fs-sm); }
  .btn-lg { min-height: 3.25rem; padding: 0 1.625rem; font-size: 1rem; }
  .btn-primary { background: var(--acc); color: var(--on-acc); box-shadow: 0 6px 16px var(--acc-glow); }
  .btn-primary:hover { color: var(--on-acc); background: var(--acc-hover); }
  .btn-secondary { background: var(--surface); color: var(--ink); border-color: var(--line-strong); }
  .btn-secondary:hover { color: var(--ink); border-color: var(--line-strong); box-shadow: var(--shadow-1); }
  .btn-dark { background: var(--deep); color: var(--on-deep); }
  .btn:disabled, .btn[aria-disabled='true'] { opacity: 0.45; cursor: not-allowed; box-shadow: none; transform: none; }
  .btn-dark:hover { color: var(--on-deep); background: var(--deep-hover); }
  .btn-light { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-2); }
  .btn-light:hover { color: var(--ink); }
  .btn-ghost { background: transparent; color: var(--acc-text); padding-inline: var(--s-3); }
  .btn-ghost:hover { background: var(--acc-soft); color: var(--acc-text); transform: none; }
</style>
