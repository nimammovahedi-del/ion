---
/**
 * A tiny trend line for a tile or a table row. values: oldest first, null for a day with no answer.
 * `usual` draws a dashed line at her usual. Always pass `summary` (what a screen reader hears), or decorative when words beside it say the same.
 */
interface Props { values: (number | null)[]; min?: number; max?: number; usual?: number; summary?: string; decorative?: boolean; width?: number; height?: number; tone?: 'acc' | 'leaf' | 'deep'; class?: string }
const { values, usual, summary, decorative = false, width = 160, height = 44, tone = 'acc', class: cls = '' } = Astro.props;
const nums = values.filter((v): v is number => v !== null);
const lo = Astro.props.min ?? Math.min(...nums, usual ?? Infinity);
const hi = Astro.props.max ?? Math.max(...nums, usual ?? -Infinity);
const span = hi - lo || 1;
const P = 5;
const x = (i: number) => P + (values.length < 2 ? (width - 2 * P) / 2 : (i / (values.length - 1)) * (width - 2 * P));
const y = (v: number) => P + (height - 2 * P) * (1 - (v - lo) / span);
let d = '';
let pen = false;
values.forEach((v, i) => { if (v === null) { pen = false; return; } d += `${pen ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)} `; pen = true; });
const lastI = values.reduce<number>((acc, v, i) => (v !== null ? i : acc), -1);
const a11y = decorative || !summary ? ({ 'aria-hidden': 'true' } as const) : ({ role: 'img', 'aria-label': summary } as const);
---
<svg class:list={['spark', `spark-${tone}`, cls]} viewBox={`0 0 ${width} ${height}`} width={width} height={height} {...a11y}>
  {usual !== undefined && <line class="spark-usual" x1={P} x2={width - P} y1={y(usual)} y2={y(usual)} />}
  <path class="spark-line draw-line" d={d.trim()} pathLength="1" />
  {lastI >= 0 && <circle class="spark-last draw-pop" style="--i:8" cx={x(lastI)} cy={y(values[lastI] as number)} r="4" />}
</svg>
<style>
  .spark { display: block; max-width: 100%; height: auto; overflow: visible; }
  .spark-usual { stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 3 4; }
  .spark-line { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .spark-acc .spark-line { stroke: var(--acc-text); }
  .spark-leaf .spark-line { stroke: var(--leaf-text); }
  .spark-deep .spark-line { stroke: var(--deep); }
  .spark-last { fill: var(--deep); stroke: var(--surface); stroke-width: 2; }
</style>
