---
/** Small number tile: grey label, big number, short caption. */
interface Props { label: string; value: string; unit?: string; caption?: string; tone?: 'plain' | 'soft' | 'deep'; flag?: boolean }
const { label, value, unit, caption, tone = 'plain', flag = false } = Astro.props;
---
<div class:list={['tile', `tile-${tone}`]}>
  <span class="tile-label">{label}</span>
  <span class="tile-value num">{value}{unit && <span class="tile-unit">{unit}</span>}</span>
  {caption && <span class:list={['tile-caption', { flag }]}>{caption}</span>}
</div>
<style>
  .tile { display: flex; flex-direction: column; gap: 0.125rem; padding: var(--s-4) var(--s-5); border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .tile-soft { background: var(--acc-soft); border-color: transparent; }
  .tile-deep { background: var(--deep); color: var(--on-deep); border-color: transparent; }
  .tile-label { font-size: var(--fs-sm); color: var(--ink-2); }
  .tile-deep .tile-label, .tile-deep .tile-caption { color: var(--on-deep); }
  .tile-value { font-size: 1.875rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; }
  .tile-unit { margin-left: 0.375rem; font-size: 1rem; font-weight: 400; }
  .tile-caption { font-size: var(--fs-sm); color: var(--ink-2); }
  .tile-caption.flag { color: var(--acc-text); font-weight: 500; }
</style>
