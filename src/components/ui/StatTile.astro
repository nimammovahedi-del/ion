---
/** A small figure beside a chart: quiet label, the number, one short line. A flagged one sits on a soft peach ground and says why in words. */
interface Props { label: string; value: string; unit?: string; caption?: string; tone?: 'plain' | 'soft' | 'deep'; flag?: boolean }
const { label, value, unit, caption, tone = 'plain', flag = false } = Astro.props;
---
<div class:list={['tile', `tile-${tone}`]}>
  <span class="tile-label">{label}</span>
  <span class="tile-value num">{value}{unit && <span class="tile-unit">{unit}</span>}</span>
  {caption && <span class:list={['tile-caption', { flag }]}>{caption}</span>}
</div>
<style>
  .tile { display: flex; flex-direction: column; gap: 0.125rem; padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--paper); min-width: 0; }
  .tile-soft { background: var(--acc-soft); }
  .tile-deep { background: var(--deep); color: var(--on-deep); }
  .tile-label { font-size: var(--fs-sm); color: var(--ink-2); }
  .tile-deep .tile-label, .tile-deep .tile-caption { color: var(--on-deep); }
  .tile-value { font-size: 1.625rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; }
  .tile-unit { margin-left: 0.375rem; font-size: 0.9375rem; font-weight: 400; letter-spacing: 0; }
  .tile-caption { font-size: var(--fs-sm); line-height: 1.4; color: var(--ink-2); }
  .tile-caption.flag { color: var(--ink); font-weight: 500; }
</style>
