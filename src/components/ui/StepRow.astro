---
/** One numbered row of what Ion did. The row that needs the family is opened to show its sub-steps. */
import type { AgentStep } from '@/data/types';
import Chip from './Chip.astro';
interface Props { step: AgentStep; total: number; animate?: boolean }
const { step, total, animate = false } = Astro.props;
const label = { done: 'Done', working: 'Working', waiting: 'Waiting', 'needs-you': 'Waiting for you' }[step.status];
const tone = { done: 'done', working: 'working', waiting: 'info', 'needs-you': 'waiting' }[step.status] as 'done' | 'working' | 'info' | 'waiting';
const n = String(step.n).padStart(2, '0');
const of = String(total).padStart(2, '0');
---
<li class:list={['step', `step-${step.status}`]} data-step={animate ? step.n : undefined}>
  <div class="step-head">
    <div class="step-text">
      <span class="step-n num"><b>{n}</b> / {of}<span class="step-time">{step.time}</span></span>
      <span class="step-title">{step.title}</span>
      <span class="step-result">{step.result}</span>
    </div>
    <Chip tone={tone} dot={step.status === 'needs-you'}>{label}</Chip>
  </div>
  {step.substeps && (
    <div class="step-open">
      <ul role="list" class="step-subs">
        {step.substeps.map((s) => (
          <li class:list={{ done: s.done }}>
            <span class="sub-mark" aria-hidden="true">{s.done ? (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>
            ) : null}</span>
            <span><span class="sr-only">{s.done ? 'Done: ' : 'Not done yet: '}</span>{s.label}{s.code && <code>{s.code}</code>}</span>
          </li>
        ))}
      </ul>
      {step.progress !== undefined && (
        <div class="step-bar" role="img" aria-label={`${step.substeps.filter((s) => s.done).length} of ${step.substeps.length} steps done`}><span style={`width:${step.progress}%`}></span></div>
      )}
      <slot />
    </div>
  )}
</li>
<style>
  .step { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-4) var(--s-5); border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--surface) radial-gradient(var(--line) 1px, transparent 1.5px) 0 0 / 10px 10px; }
  .step-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .step-text { display: flex; flex-direction: column; min-width: 0; flex: 1 1 16rem; }
  .step-n { font-family: var(--mono); font-size: var(--fs-xs); color: var(--ink-2); }
  .step-n b { color: var(--ink); font-weight: 500; }
  .step-time { margin-left: var(--s-3); }
  .step-title { font-size: 1.125rem; font-weight: 500; line-height: 1.4; }
  .step-result { font-size: var(--fs-sm); color: var(--ink-2); }
  .step-open { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-4); border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line); }
  .step-subs { display: flex; flex-direction: column; gap: var(--s-2); }
  .step-subs li { display: flex; gap: var(--s-3); align-items: flex-start; font-size: 0.9375rem; line-height: 1.5; }
  .sub-mark { flex: none; display: grid; place-items: center; width: 1.25rem; height: 1.25rem; margin-top: 0.125rem; border-radius: 50%; border: 1.5px solid var(--line-strong); color: var(--on-acc); }
  .done .sub-mark { background: var(--acc); border-color: var(--acc); }
  code { display: inline-block; margin-left: var(--s-2); font-family: var(--mono); font-size: var(--fs-xs); color: var(--acc-text); background: var(--acc-soft); border-radius: 0.375rem; padding: 0 0.375rem; }
  .step-bar { height: 4px; border-radius: 4px; background: var(--grey-2); overflow: hidden; }
  .step-bar span { display: block; height: 100%; border-radius: 4px; background: var(--acc-text); }
</style>
